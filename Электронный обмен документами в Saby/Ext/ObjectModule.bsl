// Функция - Конструктор
//
// Параметры:
//  ПараметрыПодключения - Структура(ИмяКомпоненты, ИмяОбработки, ИмяМакета) - для подключения ВО с компонентой из справочника 
// 
// Возвращаемое значение:
//   Структура 
//
// v8unpack &НаКлиенте
Функция ВнешняяКомпонента_Новый(ПараметрыПодключения) Экспорт
	
	Компонента = Новый Структура;
	Компонента.Вставить("ОбъектКомпоненты"						, Неопределено);
	Компонента.Вставить("ОбработчикЗавершенияПодключения"		, Неопределено);
	Компонента.Вставить("ИмяКомпоненты"							, Неопределено);
	Компонента.Вставить("ВыполненаУстановка"					, Ложь);
	Компонента.Вставить("АдресХранилища"						, Неопределено);
	Компонента.Вставить("ВерсияВХранилище"						, Неопределено);
	Компонента.Вставить("ПринудительнаяУстановка"				, Ложь);
	
	ЗаполнитьЗначенияСвойств			(Компонента, ПараметрыПодключения);
	ВнешняяКомпонента_ИзвлечьВХранилище	(Компонента, ПараметрыПодключения);
	
	Возврат Компонента;
		
КонецФункции

// Процедура - Извлекает архив с компоненой из макета ВО, и помещает во временное хранилище для дальнейшего использования на клиенте
//
// Параметры:
//  Компонента			 - 	Структура ВнешняяКомпонента_Новый 
//  ПараметрыПодключения - Структура(ИмяКомпоненты, ИмяОбработки, ИмяМакета) - для подключения ВО с компонентой из справочника
//
// v8unpack &НаСервере
Процедура ВнешняяКомпонента_ИзвлечьВХранилище(Компонента, ПараметрыПодключения)
	
	СведенияОбработки			= МодульОбъектаСервер().ВнешняяОбработка_ПолучитьСведенияНаСервере(ПараметрыПодключения);
	МестоположениеКомпоненты	= МодульОбъектаСервер().ВнешняяОбработка_ПолучитьМакетНаСервере(
									Новый Структура("ВнешняяОбработка, ИмяМакета", СведенияОбработки.Ссылка, ПараметрыПодключения.ИмяМакета),
									Новый Структура("ПоместитьВХранилище", Истина));
								 
	Компонента.АдресХранилища	= МестоположениеКомпоненты;
	Компонента.ВерсияВХранилище	= СведенияОбработки.Версия;
	
КонецПроцедуры

// Функция - Точка входа для получения экземпляра компоненты. Выполняет установку, подключение ВК
//
// Параметры:
//  Компонента	 - 	 Структура ВнешняяКомпонента_Новый 
// 
// Возвращаемое значение: Структура  ВнешняяКомпонента_Новый Обогащенная ОбъектКомпоненты  если компонента была установлена
//   -                    Неопределено - будет запущена асинхронная установка с последующим вызовом ОписаниеОповещения
//
// v8unpack &НаКлиенте
Функция ВнешняяКомпонента_Получить(Компонента) Экспорт
	
	Если ВнешняяКомпонента_Подключить(Компонента) Тогда
		
		Попытка	
			ОбъектКомпоненты						= Новый("AddIn.Saby." + Компонента.ИмяКомпоненты);
		Исключение
			ВызватьСбисИсключение("Не удалось создать экземпляр компоненты", "МодульОбъектаКлиент.ВнешняяКомпонента_ПодключитьПослеУстановки"); 
		КонецПопытки;
					
		Компонента.ОбъектКомпоненты	= ОбъектКомпоненты; 
	
		
		Если НЕ Компонента.ОбработчикЗавершенияПодключения = Неопределено И ПолучитьЗначениеПараметраСбис("ОтложенныйЗапуск") Тогда		
			ВыполнитьСбисОписаниеОповещения(Компонента, Компонента.ОбработчикЗавершенияПодключения);						
		Иначе
			Возврат Компонента;
		КонецЕсли;
		
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

// Функция - Обертка над платформенным методом ПодключитьВнешнююКомпоненту. Вызывает установку компоненты при необходимости
//
// Параметры:
//  Компонента	 - Структура ВнешняяКомпонента_Новый
// 
// Возвращаемое значение: Истина - компонента подключена, Ложь обработное
//   - 
//
// v8unpack &НаКлиенте
Функция ВнешняяКомпонента_Подключить(Компонента)
	
	Если Компонента.ПринудительнаяУстановка ИЛИ НЕ ПодключитьВнешнююКомпоненту(Компонента.АдресХранилища, "Saby", ТипВнешнейКомпоненты.Native) Тогда
		
		Если Компонента.ВыполненаУстановка Тогда
			ВызватьСбисИсключение("Не удалось подключить компоненту после установки, попробуйте перезапустить 1С:Предприятие или изменить способ обмена.",
								"МодульОбъектаКлиент.ВнешняяКомпонента_Подключить"); 	
		КонецЕсли;
		
		#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
			ВызватьСбисИсключение("Не удалось подключить компоненту", "МодульОбъектаКлиент.ВнешняяКомпонента_Подключить"); 	
		#Иначе
			ВнешняяКомпонента_Установить(Компонента); 		
		#КонецЕсли
		
		Возврат Ложь;
		
	Иначе
		Возврат Истина;
	КонецЕсли;
		   	
КонецФункции
	
// Процедура - Обертка над методами платформы для установки компоненты. 
//
// Параметры:
//  Компонента	 - Структура ВнешняяКомпонента_Новый 
// 
// Возвращаемое значение:
//   - 
//
// v8unpack &НаКлиенте	
Процедура ВнешняяКомпонента_Установить(Компонента) 
	
	Если ГлавноеОкно.Кэш.СовместимостьМетодов.НативныеКомпоненты.НачатьУстановкуВнешнейКомпоненты Тогда
		
		ОбработчикЗавершения = НовыйСбисОписаниеОповещения("ВнешняяКомпонента_ПослеУстановки", МодульОбъектаКлиент(), Компонента,
															"ВнешняяКомпонента_ОшибкаУстановки", МодульОбъектаКлиент());
		
		Выполнить("НачатьУстановкуВнешнейКомпоненты(ОбработчикЗавершения, Компонента.АдресХранилища)");
		
	Иначе 

		УстановитьВнешнююКомпоненту(Компонента.АдресХранилища);
		ВнешняяКомпонента_ПослеУстановки(Компонента);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - для ОписанияОповещения после успешной установки.  
//
// Параметры:
//  Компонента	 - 	 - 
//
// v8unpack &НаКлиенте
Процедура ВнешняяКомпонента_ПослеУстановки(Компонента) Экспорт
	
	Компонента.ВыполненаУстановка		= Истина;
	Компонента.ПринудительнаяУстановка	= Ложь;
	
	Попытка
		ВнешняяКомпонента_Получить(Компонента);
	Исключение
		МодульОбъектаКлиент().СообщитьСбисИсключение(ИнформацияОбОшибке());
	КонецПопытки;
	
КонецПроцедуры

// Процедура - для ОписанияОповещения при ошибке установки.  
//
// Параметры:
//  Компонента	 - 	 - 
//
// v8unpack &НаКлиенте
Процедура ВнешняяКомпонента_ОшибкаУстановки(Компонента) Экспорт
	ВызватьСбисИсключение("При установке компоненты возникла ошибка", "МодульОбъектаКлиент.ВнешняяКомпонента_ОшибкаУстановки");
КонецПроцедуры

// v8unpack #КонецОбласти 

// v8unpack #Область include_core2_vo2_Модуль_МодульОбъектаКлиент_РаботаСЗаказами

// Функция возвращает результат работы метода ExtSysAction.CheckAnnul
//
// Параметры:
//  ИдентификаторыПакетов  - Массив - обрабатываемые идентификаторы пакетов документов
//  ДопПараметры  - Структура - Набор полей, работа с которыми может расширить результат работы функции.
//
// Возвращаемое значение:
//   Структура   - Результат вызова. Список доступных к аннулированию идентификаторов пакетов.
//
// v8unpack &НаКлиенте
Функция ПроверитьВозможностьАннулирования(ИдентификаторыПакетов, ДопПараметры = Неопределено) 
	
	Кэш = ГлавноеОкно.Кэш;  
	
	ПараметрыВызова = Новый Структура;  
	ПараметрыВызова.Вставить("docflowIds",ИдентификаторыПакетов);
	 
	ФлагОшибки = Ложь;  
	
	РезультатВызова = ГлобальныйКэш.ТекущийСеанс.Модули.Интеграция.ExtSysAction_CheckAnnul(ПараметрыВызова, Новый Структура("Кэш", Кэш), ФлагОшибки); 
	
	Если ФлагОшибки Тогда
		ВызватьСбисИсключение(РезультатВызова, "МодульОбъектаКлиент.ПроверитьВозможностьАннулирования");
	КонецЕсли;   
	
	Возврат РезультатВызова;
	
КонецФункции  

// Функция возвращает результат работы метода ExtSysOrders.List, список заказов для построения реестра документов.
//
// Параметры:
//  ПараметрыФильтра  - Структура - Дополнительные параметры фильтра
//  ДопПараметры  - Структура - Набор полей, работа с которыми может расширить результат работы функции.
//
// Возвращаемое значение:
//   Структура   - Результат вызова.
//
// v8unpack &НаКлиенте
Функция ПолучитьСписокЗаказов(Кэш, ПараметрыФильтра, ДопПараметры = Неопределено, Отказ) Экспорт	    
	
	Кэш = ГлавноеОкно.Кэш;   
	ОбщиеФункцииДокументов = ПолучитьЗначениеПараметраТекущегоСеанса("ФункцииДокументов");    
	МодульИнтеграции = ПолучитьЗначениеПараметраТекущегоСеанса("Интеграция");
		
	ГлавноеОкно.ОтметитьВсе = Ложь;
	 
	ПараметрыФильтрации = СформироватьФильтрДляРеестраОнлайна(Кэш.ГлавноеОкно, Новый Структура("ДопФильтры", ПараметрыФильтра));
	
	РезультатВызова = МодульИнтеграции.ExtSysOrders_List(ПараметрыФильтрации, Новый Структура("Кэш", Кэш), Отказ); 
	
	Если Отказ Тогда         
		
		ГлавноеОкно.сбисСпрятатьСостояние(ГлавноеОкно);	
		ВызватьИсключение СбисИсключение_Представление(РезультатВызова); 
		
	КонецЕсли;   
	
	Возврат РезультатВызова;
			
КонецФункции    

// Функция проверяет допустимые форматы документов отгрузки, в зависимости от этапа документооборота
//
// Параметры: 
//  Идентификатор 	- Строка	- Идентификатор Saby обрабатываемого пакета
//  ДопПараметры	- Структура	- Набор полей, работа с которыми может расширить результат работы функции 
// 
// Возвращаемое значение:
//  Массив - Результат вызова.
//
// v8unpack &НаКлиенте
Функция ПолучитьСписокФорматовДокументовОтгрузки(Идентификатор, ДопПараметры = Неопределено) Экспорт
	
	Кэш = ГлавноеОкно.Кэш;
	МодульИнтеграции = ПолучитьЗначениеПараметраТекущегоСеанса("Интеграция");
	
	ПараметрыВызова = Новый Структура;
	ПараметрыВызова.Вставить("ИдДок", Идентификатор);
	
	ДопПараметрыВызова = Новый Структура("Кэш", Кэш);

	ФлагОшибки = Ложь;
	
	РезультатВызова = МодульИнтеграции.ExtSysDocument_AcceptedFormatsByChain(ПараметрыВызова, ДопПараметрыВызова, ФлагОшибки);
	
	Если ФлагОшибки Тогда   
		
		ВызватьИсключение СбисИсключение_Представление(РезультатВызова); 
		
	КонецЕсли; 
	
	ОтправляетсяУоО = Ложь;
	СовместнаяОтправкаУоО = Ложь;  
	
	Если РезультатВызова.РасширениеВложений.Свойство("DESADV") Тогда  
		
		ОтправляетсяУоО = Истина;
		СовместнаяОтправкаУоО = РезультатВызова.РасширениеВложений.DESADV.Свойство("WITH_UZD")
									И РезультатВызова.РасширениеВложений.DESADV.WITH_UZD = Истина;  
		
	КонецЕсли;
	
	Результат = Новый Массив; 
	
	Если ЗначениеЗаполнено(РезультатВызова.ТипыВложений) Тогда 
		
		Для Каждого ЭлементМассива Из РезультатВызова.ТипыВложений Цикл
			
			Если НРег(ЭлементМассива) = НРег("УведОбОтгр") 
				И ОтправляетсяУоО
				И НЕ СовместнаяОтправкаУоО Тогда
				Результат.Добавить(НРег("УведомлОтгр"));
			ИначеЕсли НРег(ЭлементМассива) = НРег("СЧФДОП") Тогда
				Результат.Добавить(НРег("УпдСчфДоп"));
			ИначеЕсли НРег(ЭлементМассива) = НРег("ДОП") Тогда
				Результат.Добавить(НРег("УпдДоп"));
			ИначеЕсли НРег(ЭлементМассива) = НРег("СЧФ") Тогда
				Результат.Добавить(НРег("СчФктр"));
			ИначеЕсли НРег(ЭлементМассива) = НРег("ТОРГ12") Тогда
				Результат.Добавить(НРег("ЭДОНакл"));
			ИначеЕсли НРег(ЭлементМассива) = НРег("АктВыполнРабот") Тогда
				Результат.Добавить(НРег("АктВР"));
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Результат.Добавить(НРег("УпдСчфДоп"));
		Результат.Добавить(НРег("УпдДоп"));
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции 

// v8unpack &НаКлиенте
Функция ДанныеДокументаОтгрузкиПоПриоритету(ПараметрыПоиска, ДопПараметры = Неопределено) Экспорт
	Перем ДопОтбор;
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	ДопПараметры.Свойство("ДопОтборИни", ДопОтбор);
	
	Документы1С			= ПараметрыПоиска.Документы1С;
	ТипыВложенийСБИС	= ПараметрыПоиска.ТипыВложенийСБИС;
	
	ДокументыПоТипуСБИС = Новый Соответствие;
	
	Для каждого ЭлементСписка Из Документы1С Цикл
		
		ПараметрыИниВходящие = Новый Структура("ОбъектСсылка, ТипИни", ЭлементСписка.Значение, "Выгрузка");
		Ини = ИниПоПараметрам(ПараметрыИниВходящие);
		
		ДополнительноОтобратьИни(Ини, ДопОтбор);
		
		Если Ини = Неопределено Тогда
			Продолжить;
		ИначеЕсли Ини.Свойство("мФайл") Тогда
			// Скорее всего такого не будет
		Иначе
			
			Для каждого ЭлементСтруктуры Из Ини Цикл
				
				ПараметрыРасчета = Новый Структура;
				ПараметрыРасчета.Вставить("ИмяИни",				ЭлементСтруктуры.Ключ);
				ПараметрыРасчета.Вставить("Ини",				ЭлементСтруктуры.Значение);
				ПараметрыРасчета.Вставить("Документ",			ЭлементСписка.Значение);
				ПараметрыРасчета.Вставить("ВозможныеТипыСБИС",	ТипыВложенийСБИС);
				
				ОпределеитьТипДокументаСБИС(ДокументыПоТипуСБИС, ПараметрыРасчета);
			
			КонецЦикла;
			
		КонецЕсли;
	
	КонецЦикла;
		
	УведомлОтгр	= ДокументыПоТипуСБИС.Получить("УведомлОтгр");
	УпдСчфДоп	= ДокументыПоТипуСБИС.Получить("УпдСчфДоп");
	УпдДоп		= ДокументыПоТипуСБИС.Получить("УпдДоп");
	СчфДоп		= ДокументыПоТипуСБИС.Получить("СчфДоп");
	ЭДОНакл		= ДокументыПоТипуСБИС.Получить("ЭДОНакл");
	АктВР		= ДокументыПоТипуСБИС.Получить("АктВР");
	
	Результат = Новый СписокЗначений;
	
	Если ЗначениеЗаполнено(УведомлОтгр) Тогда
		Результат = УведомлОтгр;	
	ИначеЕсли ЗначениеЗаполнено(УпдСчфДоп) Тогда
		Результат = УпдСчфДоп;
	ИначеЕсли ЗначениеЗаполнено(СчфДоп) Тогда
		
		Результат = СчфДоп;
		
		Если ЗначениеЗаполнено(ЭДОНакл) Тогда
		
			Для каждого Документ Из ЭДОНакл Цикл
				Результат.Добавить(Документ.Значение, Документ.Представление);
			КонецЦикла;
		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АктВР) Тогда
		
			Для каждого Документ Из АктВР Цикл
				Результат.Добавить(Документ.Значение, Документ.Представление);
			КонецЦикла;
		
		КонецЕсли;
		
	ИначеЕсли ЗначениеЗаполнено(УпдДоп) Тогда
		Результат = УпдДоп;
	Иначе
		
		Если ЗначениеЗаполнено(ЭДОНакл) Тогда
		
			Для каждого Документ Из ЭДОНакл Цикл
				Результат.Добавить(Документ.Значение, Документ.Представление);
			КонецЦикла;
		
		КонецЕсли;
		
		Если ЗначениеЗаполнено(АктВР) Тогда
		
			Для каждого Документ Из АктВР Цикл
				Результат.Добавить(Документ.Значение, Документ.Представление);
			КонецЦикла;
		
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// v8unpack &НаКлиенте
Процедура ОпределеитьТипДокументаСБИС(ДокументыПоТипуСБИС, ПараметрыРасчета)
	
	ИмяИни				= ПараметрыРасчета.ИмяИни;
	Ини					= ПараметрыРасчета.Ини;
	Документ			= ПараметрыРасчета.Документ;
	ВозможныеТипыСБИС	= ПараметрыРасчета.ВозможныеТипыСБИС;
	
	МодульДокументов = ПолучитьЗначениеПараметраТекущегоСеанса("ФункцииДокументов");
	
	Для каждого Файл Из Ини.мФайл Цикл
		
		// Проверка на тип формируемого и доступного вложения
		Вложение_Тип = МодульДокументов.РассчитатьЗначение("Вложение_Тип", Файл.Значение);
		
		// Проверка на соответствие типу документа 1с, из которого формируется документ СБИС
		Документ1С = МодульДокументов.РассчитатьЗначение("Документ", Файл.Значение);
		ОписаниеТипа = Новый ОписаниеТипов(СтрЗаменить(Документ1С, "Документ.", "ДокументСсылка."));
		РезультатПроверкиТипа = ОписаниеТипа.ПривестиЗначение(Документ);
		
		Если ВозможныеТипыСБИС.Найти(НРег(Вложение_Тип)) = Неопределено
			ИЛИ НЕ ЗначениеЗаполнено(РезультатПроверкиТипа) Тогда
			Продолжить;
		ИначеЕсли ДокументыПоТипуСБИС.Получить(Вложение_Тип) = Неопределено Тогда
			ДокументыПоТипуСБИС.Вставить(Вложение_Тип, Новый СписокЗначений);
		КонецЕсли;
		
		ДокументыПоТипуСБИС[Вложение_Тип].Добавить(Документ, ИмяИни);  
		
		Прервать;
	
	КонецЦикла;
	
КонецПроцедуры

