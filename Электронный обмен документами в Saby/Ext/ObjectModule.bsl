// Установить значение переменной
//
// Параметры:
//  context - Структура - Общий контекст алгоритма
//  name - Строка - Название переменной
//  value - Произвольный - Значение переменной
//
// Возвращаемое значение:
//  - Неопределено - Блок ничего не возвращает
//
//DynamicDirective
Функция block_set_variable(context, name, value)
	Результат = Неопределено;
	Если get_prop(context, "multithread_mode", Ложь) = Истина Тогда
		Если context.block_context.__thread_vars.Количество() = 1 Тогда
			variables = context_variables_get(context);
		Иначе
			variables = Новый Соответствие;
		КонецЕсли;
		Если Не ЕстьСвойствоВСоответствии(name, variables) Тогда
			variable_current_scopes_thread = context.current_variable_scope - context.variable_scopes.Количество() + 1;
			context.block_context.__thread_vars[variable_current_scopes_thread].Вставить(name, value);
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;	
	context_variables_get(context).Вставить(name, value);
	context.data.Вставить("variable_scopes", context.variable_scopes); 
		
	Возврат Результат;

КонецФункции
// BSLLS:FunctionReturnsSamePrimitive-on

//DynamicDirective

Функция ЕстьСвойствоВСоответствии(Свойство, Знач Соотв)
	Если Соотв.Получить(Свойство) <> Неопределено Тогда
		Возврат Истина;
	Иначе
		КоличествоПеременныхДо = Соотв.Количество();
		Соотв.Вставить(Свойство, Неопределено);
		КоличествоПеременныхПосле = Соотв.Количество();
		Если КоличествоПеременныхДо = КоличествоПеременныхПосле Тогда
			Возврат	Истина;	
		КонецЕсли;
		Соотв.Удалить(Свойство);
		Возврат Ложь;
	КонецЕсли;
КонецФункции

// Получить значение переменной
//
// Параметры:
//  context - Структура - Общий контекст алгоритма
//  name - Строка - Название переменной     
//
// Возвращаемое значение:
//  - Произвольный - Переменная
//
//DynamicDirective
Функция block_get_variable(context, name)
	// BSLLS:MissingCodeTryCatchEx-off
	Попытка
		variable_current_scopes_thread = context.current_variable_scope - context.variable_scopes.Количество() + 1;
		thread_vars = block_obj_get_path_value(context, "block_context.__thread_vars", Неопределено);
		variable_thread = thread_vars.Получить(variable_current_scopes_thread); 
		var_value = get_prop(variable_thread, name, Неопределено);
		Если var_value <> Неопределено Тогда
			Возврат	var_value;
		Иначе 
			// Для проверки наличия свойства в соответствии со значением Неопределено
			КоличествоПеременныхДо = variable_thread.Количество();
			variable_thread.Вставить(name, Неопределено);
			КоличествоПеременныхПосле = variable_thread.Количество();
			Если КоличествоПеременныхДо = КоличествоПеременныхПосле Тогда
				Возврат	var_value;	
			КонецЕсли;
			variable_thread.Удалить(name);	
		КонецЕсли;	
	Исключение		
	КонецПопытки;
	// BSLLS:MissingCodeTryCatchEx-on	
	Возврат context_variables_get(context).Получить(name);

КонецФункции
	
//DynamicDirective

Процедура ОбработатьОшибкуЦиклическогоБлока(block_type, block_context, ИнфОбОшибке, ПрерватьЦикл)
	ОшибкаСтруктура = NewExtExceptionСтруктура(ИнфОбОшибке);
	Если ЭтоСлужебнаяОшибкаБлока(ОшибкаСтруктура.type) Тогда
		Если ОшибкаСтруктура.type = "DeferredOperation" Тогда
			context_add_deferred(ОшибкаСтруктура);
			block_context.Удалить("child");
		ИначеЕсли ОшибкаСтруктура.type = "LoopBreak" Тогда
			block_multithreadloop_clear_child_context(block_context); 
			ПрерватьЦикл = Истина;
			Возврат;
		ИначеЕсли ОшибкаСтруктура.type = "LoopContinue" Тогда
			block_multithreadloop_clear_child_context(block_context); 
			Возврат;
		Иначе
			ВызватьИсключение ИнфОбОшибке.Описание;  			
		КонецЕсли
	Иначе	
		ВызватьИсключение NewExtExceptionСтрока(ИнфОбОшибке,,,"Ошибка в блоке (" + block_type + ")", add_block_to_dump(block_context));	
	КонецЕсли;		
КонецПроцедуры	
	
