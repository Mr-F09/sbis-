Функция ПолучитьТипФайла(ИмяФайла) Экспорт
	ТипФайла = ИмяФайла;
	ЭлементыСтроки = СтрРазделить82(ИмяФайла, ".");
	Если ЭлементыСтроки.Количество() > 1 Тогда
		ТипФайла = ЭлементыСтроки[ЭлементыСтроки.Количество() - 1];
