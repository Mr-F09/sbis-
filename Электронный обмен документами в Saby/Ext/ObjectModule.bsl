//
//DynamicDirective
Функция ПослеАутентификации(context_params, НоваяИнтеграция = Ложь) Экспорт
	connection_info = ПолучитьПодключение(context_params, НоваяИнтеграция);
	ЗаполнитьИнформациюОПользователе(context_params);
    ПослеПолученияПодключения(context_params, connection_info);
	ТранспортИнтеграции.ОбновитьВстраиваемыеОбъекты(context_params);
