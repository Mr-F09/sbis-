// v8unpack #Область include_core2_vo2_МодульОбъекта_Клиент_Классы_МассоваяОперация_private_ЦепочкаКомандОбработки

// Процедура - обработка ошибки, установленной на цепочке
//
// Параметры:
//  РезультатОтправки		 - РезультатОтправки		 - структура отправки
//  ЦепочкаКомандОбработки	 - ЦепочкаКомандОбработки	 - по которой возникла ошибка
//  ПараметрыОшибки			 - Структура				 - описание возникшей ошибки - фатальная/поготовка/авторизация
//
// v8unpack &НаКлиенте
Процедура МассоваяОперация_ЦепочкаКомандОбработки_Ошибка(РезультатОтправки, ЦепочкаКомандОбработки, ПараметрыОшибки) Экспорт
	Перем лОшибкаФатальная;

	ИдОтправки		= ЦепочкаКомандОбработки_Получить(ЦепочкаКомандОбработки, "Идентификатор");
	СоставПакета	= ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "СоставПакета");
	ДокументСбис	= ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "ДокументСБИС");
	СбисИсключение	= ПараметрыОшибки.Исключение;
	
	Если СбисИсключение = Неопределено Тогда
		
		СбисИсключение	= НовыйСбисИсключение("Неизвестная ошибка при обработке ответов.", "МодульОбъектаКлиент.МассоваяОперация_ОбработатьОшибку");
		
	КонецЕсли;
	
	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Ошибка", СбисИсключение);
	РезультатОтправки.НаЗаписьСтатусов.Ошибки.Вставить(ИдОтправки, СбисИсключение);

	ТекстОшибки				= СбисИсключение.message;
	ОписаниеРасширенное		= СбисИсключение.details;	
	ЭлементСписка			= РезультатОтправки.ТипыОшибок.НайтиПоЗначению(ТекстОшибки);

	РезультатОтправки.Ошибок = РезультатОтправки.Ошибок + 1;
	
	Если ЭлементСписка = Неопределено Тогда
		РезультатОтправки.ТипыОшибок.Добавить(ТекстОшибки, 1);
	Иначе
		ЭлементСписка.Представление = Число(ЭлементСписка.Представление) + 1;
	КонецЕсли;
	
	Если	ПараметрыОшибки.Свойство("Подготовка")
		И	ПараметрыОшибки.Подготовка Тогда
		//Ошибка из пакета документов, до отправкиподготовки
		РезультатОтправки.Счетчики.ОшибокПодготовки	= РезультатОтправки.Счетчики.ОшибокПодготовки + 1;
	Иначе
		РезультатОтправки.Счетчики.ОшибокОтправки	= РезультатОтправки.Счетчики.ОшибокОтправки + 1;		
	КонецЕсли;
	
	ЭлементСоответствия = РезультатОтправки.ДетализацияОшибок.Получить(ТекстОшибки);
	Если ЭлементСоответствия = Неопределено Тогда
		ЭлементСоответствия = Новый Массив;
		РезультатОтправки.ДетализацияОшибок.Вставить(ТекстОшибки, ЭлементСоответствия);
	КонецЕсли;
	
	//Дополнить детализацию по документам 1С
	Если Не СоставПакета = Неопределено Тогда
		
		Для Каждого Вложение Из СоставПакета.Вложение Цикл
			
			ВложениеОбработано = Ложь;
			Если Вложение.Свойство("Документы1С") Тогда
				
				Для Каждого Документ1С Из Вложение.Документы1С Цикл
					
					СтрокаВСоответствие = Новый Структура("ОбработанДокумент1С, Сообщение, СтруктураОшибки", Документ1С.Значение, ОписаниеРасширенное, СбисИсключение); 
					СтрокаВСоответствие.Вставить("ИдВложения",			ВложениеСБИС_Получить(Вложение, "Идентификатор")); 
					СтрокаВСоответствие.Вставить("НазваниеВложения",	ВложениеСБИС_Получить(Вложение, "Название")); 

					СтрокаВСоответствие.Вставить("ДокументСБИС",	СоставПакета_Получить(СоставПакета, "Название"));
					СтрокаВСоответствие.Вставить("ИДПакета",		СоставПакета_Получить(СоставПакета, "ИдентификаторСБИС"));
					СтрокаВСоответствие.Вставить("Регламент",		СоставПакета_Получить(СоставПакета, "РегламентНазвание"));
					ЭлементСоответствия.Добавить(СтрокаВСоответствие);
					
					ВложениеОбработано = Истина;
					
				КонецЦикла;
					
			КонецЕсли;
			
			Если Не ВложениеОбработано Тогда
				
				СтрокаВСоответствие = Новый Структура("Сообщение, СтруктураОшибки", ОписаниеРасширенное, СбисИсключение); 
				СтрокаВСоответствие.Вставить("ИдВложения",			ВложениеСБИС_Получить(Вложение, "Идентификатор")); 
				СтрокаВСоответствие.Вставить("НазваниеВложения",	ВложениеСБИС_Получить(Вложение, "Название")); 

				СтрокаВСоответствие.Вставить("ДокументСБИС",	СоставПакета_Получить(СоставПакета, "Название"));
				СтрокаВСоответствие.Вставить("ИДПакета",		СоставПакета_Получить(СоставПакета, "ИдентификаторСБИС"));
				СтрокаВСоответствие.Вставить("Регламент",		СоставПакета_Получить(СоставПакета, "РегламентНазвание"));
				ЭлементСоответствия.Добавить(СтрокаВСоответствие);
						
			КонецЕсли;
			
		КонецЦикла;
		
	ИначеЕсли Не ДокументСбис = Неопределено Тогда
			
		СтрокаВСоответствие = Новый Структура("Сообщение, СтруктураОшибки", ОписаниеРасширенное, СбисИсключение); 
		СтрокаВСоответствие.Вставить("ИдВложения",		СоставПакета_Получить(ДокументСбис, "ИдентификаторСБИС")); 
		СтрокаВСоответствие.Вставить("НазваниеВложения",СоставПакета_Получить(ДокументСбис, "Название")); 
		СтрокаВСоответствие.Вставить("ДокументСБИС",	СоставПакета_Получить(ДокументСбис, "Название"));

		СтрокаВСоответствие.Вставить("ИДПакета",		СоставПакета_Получить(ДокументСбис, "ИдентификаторСБИС"));
		СтрокаВСоответствие.Вставить("Регламент",		ДокументСбис.Регламент.Название);
		ЭлементСоответствия.Добавить(СтрокаВСоответствие);
		
	ИначеЕсли	СбисИсключение.extCode = 102 
			Или	СбисИсключение.extCode = 101 Тогда
		
		// Отправка черновика, но не удалось прочитать документ.
		СоставПакетаГенерируемый	= ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "ОснованиеГенерацииСоставПакета");
		ОснованиеДляДетализации		= СоставПакетаГенерируемый[0].Значение;
		СтрокаВСоответствие			= Новый Структура("ОбработанДокумент1С, Сообщение, СтруктураОшибки", ОснованиеДляДетализации, ОписаниеРасширенное, СбисИсключение); 
		СтрокаВСоответствие.Вставить("ИдВложения",			""); 
		СтрокаВСоответствие.Вставить("НазваниеВложения",	""); 
		СтрокаВСоответствие.Вставить("ДокументСБИС",		"");
		ЭлементСоответствия.Добавить(СтрокаВСоответствие);
		
	Иначе
		
		ДетализацияДляВывода	= ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "Детализация");
		СтрокаВСоответствие		= Новый Структура(	"Объект1С,				Сообщение,				СтруктураОшибки",
													ДетализацияДляВывода,	ОписаниеРасширенное,	СбисИсключение);
		
		ЭлементСоответствия.Добавить(СтрокаВСоответствие);
		
	КонецЕсли;
	
	Если	Не	ПараметрыОшибки.Свойство("Фатальная", лОшибкаФатальная)
		Или	Не	лОшибкаФатальная	Тогда
		
		//Считаем нефатальные ошибки по коду и детализации. Если накопится ряд однотипных, без ответов то прерываем отправку.
		СоответствиеНФО = Неопределено;
		Если Не РезультатОтправки.ПараметрыОтправки.Свойство("НефатальныеОшибки", СоответствиеНФО) Тогда
			СоответствиеНФО = Новый Соответствие;
			РезультатОтправки.ПараметрыОтправки.Вставить("НефатальныеОшибки", СоответствиеНФО);
		КонецЕсли;
		СоответствиеПоКоду			= СоответствиеНФО.Получить(СбисИсключение.code);
		СоответствиеПоДетализации	= СоответствиеНФО.Получить(СбисИсключение.details);
		Если СоответствиеПоКоду = Неопределено Тогда
			СоответствиеПоКоду = 0;
		КонецЕсли;
		Если СоответствиеПоДетализации = Неопределено Тогда
			СоответствиеПоДетализации = 0;
		КонецЕсли;
		СоответствиеПоКоду			= СоответствиеПоКоду + 1;
		СоответствиеПоДетализации	= СоответствиеПоДетализации + 1;
		ИсключениеПрерывания		= Неопределено;
		Если		СоответствиеПоКоду >= 10 Тогда
			
			ИсключениеПрерывания = НовыйСбисИсключение(,"МодульОбъектаКлиент.МассоваяОперация_ОбработатьОшибку",
														700, 
														"Повторите попытку позже.", 
														"Получен ряд однотипных ошибок: " + СбисИсключение.message, 
														Новый Структура("Ошибка", СбисИсключение));
		ИначеЕсли	СоответствиеПоДетализации >= 5 Тогда
			ИсключениеПрерывания = НовыйСбисИсключение(,"МодульОбъектаКлиент.МассоваяОперация_ОбработатьОшибку",
														700, 
														"Повторите попытку позже.", 
														"Получен ряд одинаковых ошибок: " + СбисИсключение.details, 
														Новый Структура("Ошибка", СбисИсключение));
		КонецЕсли;
		Если Не ИсключениеПрерывания = Неопределено Тогда
			
			//Если накоплено n нефатальных ошибок (не получиили ниодного успешного ответа, то прерываем отправку)
			МассоваяОперация_ОбработатьФатальнуюОшибка(РезультатОтправки, ИсключениеПрерывания);
			
		КонецЕсли;
		
		СоответствиеНФО.Вставить(СбисИсключение.code,		СоответствиеПоКоду);
		СоответствиеНФО.Вставить(СбисИсключение.details,	СоответствиеПоДетализации);
		
	ИначеЕсли лОшибкаФатальная Тогда
		
		МассоваяОперация_ОбработатьФатальнуюОшибка(РезультатОтправки, СбисИсключение);
		
	КонецЕсли;

	//Надо прописать на запись статусы по пакету. Сам статус появится в момент записи МассоваяОперация_ЗаписатьНакопленныеСтатусы
	МассоваяОперация_ПодготовитьСтатусыПоИтогуОтправки(РезультатОтправки, ЦепочкаКомандОбработки);
		
КонецПроцедуры

// v8unpack #КонецОбласти

// v8unpack #Область include_core2_vo2_Модуль_МодульОбъектаКлиент_Документы_МассоваяОперация_ОбработкаОтветов

// Процедура - готовит структуру статусов на запись. Сама запись статусов проходит в промежутках ожидания ответов
//
// Параметры:
//  РезультатОтправки		 - Струкутра, РезультатОтправки	 - СоставПакета		 - Структура, СоставПакета	 -
//  	ДопПараметры		 - 	 -
//  ЦепочкаКомандОбработки	 - 								 - 
//
// v8unpack &НаКлиенте
Процедура МассоваяОперация_ПодготовитьСтатусыПоИтогуОтправки(РезультатОтправки, ЦепочкаКомандОбработки) Экспорт
	Перем СтатусРегламент, ОсновнойДокумент1С, ИдентификаторВызова, СтатусУстановить;
	
	МассивСтатусРегламент	= ПолучитьЗначениеПараметраСбис("МассивСтатусРегламент");
	ИдОтправки				= ЦепочкаКомандОбработки_Получить(ЦепочкаКомандОбработки, "Идентификатор");
	ДокументСБИС			= ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "ДокументСБИС");
 	СоставПакета			= ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "СоставПакета");

	Если	ДокументСБИС = Неопределено
		Или	СоставПакета = Неопределено Тогда
		//Отправки не было, статуса тоже нет.
		Возврат;
	КонецЕсли;

	//СоставПакета			= ЦепочкаКомандОбработки_Получить(ЦепочкаКомандОбработки, "СоставПакета");
	РегламентПакета			= СоставПакета_Получить(ДокументСБИС, "РегламентНазвание");
	
	Статусы			= Новый Массив;
	СтатусРегламент	= "";
	Если Не МассивСтатусРегламент = Неопределено Тогда
		Если Не МассивСтатусРегламент.Найти(РегламентПакета) = Неопределено Тогда
			СтатусРегламент = РегламентПакета; 
		КонецЕсли;
	КонецЕсли;
	
	Для Каждого Вложение Из СоставПакета.Вложение Цикл
		Если Не Вложение.Свойство("Документы1С") Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого Документ1С Из Вложение.Документы1С Цикл
			
			СтруктураСвойств = Новый Структура("ДокументСБИС_Ид, ДокументСБИС_ИдВложения, ДокументСБИС_Статус", ДокументСБИС.Идентификатор, Вложение.Идентификатор, СтатусУстановить);
			Статусы.Добавить(Новый Структура("СтруктураСвойств, Документ1С, Регламент", СтруктураСвойств, Документ1С.Значение, СтатусРегламент));
			
		КонецЦикла;
	КонецЦикла;
	
	Если	СоставПакета.Вложение.Количество()
		И	СоставПакета.Вложение[0].Свойство("Документы1С")
		И 	ЗначениеЗаполнено(СоставПакета.Вложение[0].Документы1С) Тогда
		ОсновнойДокумент1С = СоставПакета.Вложение[0].Документы1С[0].Значение;
	КонецЕсли;
	
	РезультатОтправки.ДанныеПоСтатусам.Добавить(Новый Структура("Идентификатор, ОсновнойДокумент1С, Статусы", ИдОтправки, ОсновнойДокумент1С, Статусы));
	
КонецПроцедуры

// Процедура - общий обработчик ошибки для действий, связанных с документов СБИС - прочитать документ, подготовить/выполнить действие
//
// Параметры:
//  РезультатОтправки	 - РезультатОтправки	 - текущая массовая операция
//  ОтветИсключение		 - СбисИсключение		 - готовое исключение для обработки
//  ПараметрыВызова		 - Структура			 - входящие параметры для обработчика асинхронных событий
//
// v8unpack &НаКлиенте
Процедура МассоваяОперация_ОбработатьОшибку_ДокументСБИС(РезультатОтправки, ОтветИсключение, ПараметрыВызова)

	РезультатОтправки			= ПараметрыВызова.РезультатОтправки;
	АсинхроннаяСБИСКоманда		= ПараметрыВызова.Команда;
	ЦепочкаКомандОбработки		= ЦепочкаКомандОбработки_ПолучитьДанные(АсинхроннаяСБИСКоманда, "ЦепочкаКомандОбработки");

	СоставПакета = ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "СоставПакета");
	
	ПараметрыОбработатьОшибку		= Новый Структура("Исключение", ОтветИсключение);
	ВозможнаПереотправка			= Ложь;
	ЭтоФатальнаяОшибка				= Ложь;
	НужноПользовательскоеДействие	= Ложь;
	ОграничениеПоЛицензии			= Ложь;
	
	Если ПараметрыВызова.Свойство("Фатальная") Тогда
		
		ПараметрыОбработатьОшибку.Вставить("Фатальная", ПараметрыВызова.Фатальная);
		ЭтоФатальнаяОшибка = ПараметрыВызова.Фатальная;
		
	КонецЕсли;
	
	Если	Не	ЭтоФатальнаяОшибка
		И		ПараметрыВызова.Свойство("ПотеряАвторизации")
		И		ПараметрыВызова.ПотеряАвторизации Тогда
		
		УспешнаяАвторизация		= Ложь;
		Если	РезультатОтправки.Свойство("ВремяПоследнейАвторизации")
			И	АсинхроннаяСбисКоманда.ВремяВызова <= РезультатОтправки.ВремяПоследнейАвторизации Тогда
			
			// если уже переавторизовались, но получаем более ранние ответы с ошибкой авторизации
			УспешнаяАвторизация = Истина;
			
		Иначе
			
			Если	(	ПолучитьЗначениеПараметраСбис("ВходПоСертификату")
					И	ПолучитьЗначениеПараметраСбис("ЗапомнитьСертификат"))
				Или (Не	ПолучитьЗначениеПараметраСбис("ВходПоСертификату")
					И	ПолучитьЗначениеПараметраСбис("ЗапомнитьПароль")) Тогда
					
				// переавторизуемся
				формаАвторизации	= ПолучитьФормуОбработки("ФормаАвторизация");
				УспешнаяАвторизация	= формаАвторизации.Авторизоваться(ГлавноеОкно.Кэш) = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если УспешнаяАвторизация Тогда
			
			РезультатОтправки.Вставить("ВремяПоследнейАвторизации", ТекущаяДата());
			ВозможнаПереотправка = Истина;
			
		Иначе
			
			// Фатальная ошибка авторизации, прерываем отправку, ибо без авторизации ничего и не уйдет.
			ЭтоФатальнаяОшибка = Истина;
			ПараметрыОбработатьОшибку.Вставить("Фатальная", Истина);
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	Если 	ОтветИсключение.code = 710 // Ошибка блокировки данных 
			ИЛИ (ОтветИсключение.code = 779 И ОтветИсключение.extCode = "002") Тогда // Не найден объект, как при отправке черновика с чужого аккаунта
		
		ВозможнаПереотправка = Истина;
		
	// Ошибка отправки первиного документа до УоО
	ИначеЕсли Найти(ОтветИсключение.message, "Нет уведомления об отгрузке необходимого для отправки")
		ИЛИ Найти(ОтветИсключение.details, "Отправлять ""Уведомление об отгрузке товаров"" совместно с юридически значимыми документами") Тогда
		
		УпдДоп = НайтиВМассивеСтруктурПоКлючу(СоставПакета.Вложение, "УпдДоп", "Тип");
	
		Если УпдДоп <> Неопределено Тогда
			
			ОтветИсключение = НовыйСбисИсключение(ОтветИсключение,, 773, ОтветИсключение.message, ОтветИсключение.details);
			ОтветИсключение.extCode = "001";
			НужноПользовательскоеДействие = Истина;
			
		КонецЕсли;
		
	// Ошибка на запрет редакции
	ИначеЕсли Найти(ОтветИсключение.message, "Контрагент не принимает новые редакции") Тогда
		
		Сообщение = "Отправка редакции документа контрагенту запрещена, необходимо отправить новым документом";
		ОтветИсключение = НовыйСбисИсключение(ОтветИсключение,, 773, Сообщение, Сообщение);
		ОтветИсключение.extCode = "002";
		НужноПользовательскоеДействие = Истина;
		
	ИначеЕсли ОтветИсключение.code = 335 Тогда
		
		ЭтоФатальнаяОшибка = Истина;
		
	КонецЕсли;
	
	РезультатОтправки.ПолученоОтветов = РезультатОтправки.ПолученоОтветов + 1;

	Если ВозможнаПереотправка Тогда
		
		ПараметрыПереотправки = ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "Переотправка");
		Если ПараметрыПереотправки = Неопределено Тогда
			
			ПараметрыПереотправки = Новый Структура("СчетчикПопыток", 0);
			ЦепочкаКомандОбработки_УстановитьДанные(ЦепочкаКомандОбработки, "Переотправка", ПараметрыПереотправки);
			
		КонецЕсли;
		ПараметрыПереотправки.СчетчикПопыток = ПараметрыПереотправки.СчетчикПопыток + 1;
		
		Если ПараметрыПереотправки.СчетчикПопыток > 3 Тогда
			
			ВозможнаПереотправка = Ложь;
			
		КонецЕсли;
			
	КонецЕсли;
	
	Если ВозможнаПереотправка Тогда
		
		ЦепочкаКомандОбработки_УстановитьКоманду(ЦепочкаКомандОбработки, "МассоваяОперация_Асинх_Переотправка");
		МассоваяОперация_УстановитьОбъект(РезультатОтправки, ЦепочкаКомандОбработки);
		
	ИначеЕсли НужноПользовательскоеДействие Тогда
		
		МассоваяОперация_Асинх_УстановитьВыборПользовательскогоДействия(РезультатОтправки, АсинхроннаяСБИСКоманда, ОтветИсключение);
		
	Иначе
		
		РезультатОтправки.НеОтправлено = РезультатОтправки.НеОтправлено + 1;
		ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Ошибка", ПараметрыОбработатьОшибку);
			
	КонецЕсли;
	
	МассоваяОперация_ВремяОтправки(РезультатОтправки, АсинхроннаяСБИСКоманда.Идентификатор);
	
КонецПроцедуры

// v8unpack &НаКлиенте
Процедура МассоваяОперация_ОбработатьФатальнуюОшибка(РезультатОтправки, СбисИсключение) Экспорт

	Если Не РезультатОтправки.Свойство("ПрерватьОтправку") Тогда
		РезультатОтправки.Вставить("ПрерватьОтправку", НовыйСбисИсключение(СбисИсключение, "МодульОбъектаКлиент.МассоваяОперация_ОбработатьФатальнуюОшибка",,"Получена фатальная ошибка. Отправка прервана."));
	КонецЕсли;
	
КонецПроцедуры

// Процедура - Результат отправки асинх перед отправкой
//
// Параметры:
//  АсинхронноеСбисСобытие	 - АсинхронноеСбисСобытие	 - событие перед отправкой
//  ПараметрыВызова			 - Структура	 - 
//
// v8unpack &НаКлиенте
Процедура МассоваяОперация_Асинх_ПередОтправкой(АсинхронноеСбисСобытие, ПараметрыВызова) Экспорт

	РезультатОтправки = ПараметрыВызова.РезультатОтправки;
    ПараметрыНачалаОтправки = Новый Структура("ДатНач, ВремяНачала, ВремяВыполнения", ПолучитьДатуВМиллисекундах(), АсинхронноеСбисСобытие.Получено);
	РезультатОтправки.ДетализацияОтправки.Вставить(ПараметрыВызова.Команда.Идентификатор, ПараметрыНачалаОтправки);
	
КонецПроцедуры

// Процедура - событие после отправки
//
// Параметры:
//  АсинхронноеСбисСобытие	 - АсинхронноеСбисСобытие	 - событие перед отправкой
//  ПараметрыВызова			 - Структура	 - 
//
// v8unpack &НаКлиенте
Процедура МассоваяОперация_Асинх_ПослеОтправки(АсинхронноеСбисСобытие, ПараметрыВызова) Экспорт

	РезультатОтправки			= ПараметрыВызова.РезультатОтправки;
	АсинхроннаяСБИСКоманда		= ПараметрыВызова.Команда;
	
	ЦепочкаКомандОбработки		= ЦепочкаКомандОбработки_ПолучитьДанные(АсинхроннаяСБИСКоманда, "ЦепочкаКомандОбработки");
	СтатусОтправленногоПакета	= ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "СтатусДокумента");
	
	Если 	СтатусОтправленногоПакета = "ПервичнаяОтправка" Тогда
		
		РезультатОтправки.Счетчики.ПервичныхОтправок = РезультатОтправки.Счетчики.ПервичныхОтправок + 1; 
		
	ИначеЕсли		СтатусОтправленногоПакета = "Переотправка" Тогда
			
		РезультатОтправки.Счетчики.ПовторныхОтправок = РезультатОтправки.Счетчики.ПовторныхОтправок + 1;

	ИначеЕсли 	СтатусОтправленногоПакета = "Черновик" Тогда
		
		РезультатОтправки.Счетчики.ПервичныхОтправок = РезультатОтправки.Счетчики.ПервичныхОтправок + 1;
		
	Иначе
		
		//Вероятно, ошибка отправки или произошло что-то неожидаемое. Поток не занимать.
		Возврат;
		
	КонецЕсли;
	
	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Статус", "ОжидаетОтвета");
	ЦепочкаКомандОбработки_УстановитьДанные(ЦепочкаКомандОбработки, "СтатусДокумента", "Отправлен");
		
	РезультатОтправки.ПараметрыОтправки.Потоки.Вставить(ПараметрыВызова.Команда.Идентификатор, ПараметрыВызова.Команда);
	
КонецПроцедуры

// Процедура - Обработка события успешной отправки пакета
//
// Параметры:
//  АсинхронноеСбисСобытие	 - 	 - 
//  ПараметрыВызова			 - 	 - 
//
// v8unpack &НаКлиенте
Процедура МассоваяОперация_Асинх_Ответ(АсинхронноеСбисСобытие, ПараметрыВызова) Экспорт
	
	Перем СостояниеДокументаОтправки;
	
	РезультатОтправки		= ПараметрыВызова.РезультатОтправки;
	АсинхроннаяСБИСКоманда	= ПараметрыВызова.Команда;
	
	Если РезультатОтправки.ПараметрыОтправки.Свойство("НефатальныеОшибки") Тогда
		//Получен ответ, все накопленные НФО удаляем
		РезультатОтправки.ПараметрыОтправки.Удалить("НефатальныеОшибки");
	КонецЕсли;
	
	ДанныеОтвета = АсинхронноеСбисСобытие.Данные;
	
	Если	Не	ДанныеОтвета.Свойство("Состояние", СостояниеДокументаОтправки)
		Или	Не	СостояниеДокументаОтправки.Свойство("Название", СостояниеДокументаОтправки)
		Или	Не	ЗначениеЗаполнено(СостояниеДокументаОтправки) Тогда
		
		ИсключениеОтвета = НовыйСбисИсключение(, "МодульОбъектаКлиент.МассоваяОперация_Асинх_Ответ", 700,, "В ответе отсутствует состояние документа.", Новый Структура("Ответ", ДанныеОтвета));
		НовоеАсинхронноеСбисСобытие = НовыйАсинхронноеСбисСобытие(АсинхронноеСбисСобытие.Идентификатор, ИсключениеОтвета, "Error");
		МассоваяОперация_Асинх_Ошибка(НовоеАсинхронноеСбисСобытие, ПараметрыВызова);
		
		//Отправка неуспешна, т.к. нет состояния документа
		Возврат;
		
	КонецЕсли;
		
	ИдентификаторОтправки		= ПараметрыВызова.Команда.Идентификатор;
	ЦепочкаКомандОбработки		= ЦепочкаКомандОбработки_ПолучитьДанные(АсинхроннаяСБИСКоманда, "ЦепочкаКомандОбработки");
	ИдентификаторДляОтвета		= ЦепочкаКомандОбработки_Получить(ЦепочкаКомандОбработки, "Идентификатор");
	СоставПакетаБыло			= ЦепочкаКомандОбработки_ПолучитьДанные(ЦепочкаКомандОбработки, "СоставПакета");
	
	// Собрать прикладную статистику для ответа и вывода на итог отправки
	МассоваяОперация_ПодготовитьСтатусыПоИтогуОтправки(РезультатОтправки, ЦепочкаКомандОбработки);
	МассоваяОперация_ПодготовитьЗаписиПрикладнойСтатистики(РезультатОтправки, СоставПакетаБыло);
	МассоваяОперация_ВремяОтправки(РезультатОтправки, ИдентификаторОтправки);

	РезультатОтправки.Отправлено		= РезультатОтправки.Отправлено + 1;
	РезультатОтправки.ПолученоОтветов	= РезультатОтправки.ПолученоОтветов + 1;
	РезультатОтправки.НаЗаписьСтатусов.Ответы.Вставить(ИдентификаторДляОтвета, АсинхронноеСбисСобытие.Данные);
	
	//Очистить отслеживаемый поток.
	РезультатОтправки.ПараметрыОтправки.Потоки.Удалить(АсинхронноеСбисСобытие.Идентификатор);
	
	ЦепочкаКомандОбработки_Установить(ЦепочкаКомандОбработки, "Статус", "Завершено");
	
КонецПроцедуры

// Процедура - штатный обработчик событий ошибок. Формирует исключение для обработки.
//
// Параметры:
//  АсинхронноеСбисСобытие	 - АсинхронноеСбисСобытие	 - сформированное событие, с данными ошибки
//  ПараметрыВызова			 - Структура				 - расширение
//		Команда				 - АсинхроннаяСБИСКоманда	 - выполняемая команда, на которую была получена ошибка
//		РезультатОтправки	 - РезультатОтправки		 - текущее массовое дейтсвие
//		Фатальная			 - Булево (Ложь)			 - является ли полученная ошибка фатальной, или можно продолжить
//
// v8unpack &НаКлиенте
Процедура МассоваяОперация_Асинх_Ошибка(АсинхронноеСбисСобытие, ПараметрыВызова) Экспорт

    РезультатОтправки	= ПараметрыВызова.РезультатОтправки;
	ОтветИсключение		= НовыйСбисИсключение(	АсинхронноеСбисСобытие.Данные,
												"МодульОбъектаКлиент.МассоваяОперация_Асинх_Ошибка");
														
	МассоваяОперация_ОбработатьОшибку_ДокументСБИС(РезультатОтправки, ОтветИсключение, ПараметрыВызова);
	
	МассоваяОперация_УдалитьПоток(РезультатОтправки, АсинхронноеСбисСобытие)
	
КонецПроцедуры

// v8unpack &НаКлиенте
Процедура МассоваяОперация_Асинх_ФатальнаяОшибка(АсинхронноеСбисСобытие, ПараметрыВызова) Экспорт

	МассоваяОперация_ОбработатьФатальнуюОшибка(ПараметрыВызова.РезультатОтправки, АсинхронноеСбисСобытие.Данные);
	
КонецПроцедуры

//Проверяет наличие ответа от плагина и вызывает событие обработки полученного ответа.
//Имеет смысл сделать обработчиком ожидания, но тогда придется кардинально переделывать отправку на других формах
