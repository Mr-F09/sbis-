		Возврат НовыйКэшСбис;
		
	КонецЕсли;
	
	КэшСБИС_Вставить(НовыйКэшСбис, "МодульОбъектаКлиент", МодульОбъектаКлиент());
	
	Возврат	НовыйКэшСбис;
	
