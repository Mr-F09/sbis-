// v8unpack &НаКлиенте
Функция НовыйТекущийСеанс_Пустой()
	
	ПутьКРеквизитуКолонки	= "{%ТЧ%}.";
    ИмяКолонкиШаблон		= "{ИмяКолонки}";
	#Если Не ТолстыйКлиентОбычноеПриложение Тогда
		ПутьКРеквизитуКолонки	= ПутьКРеквизитуКолонки + "{%ТЧ%}";
        ИмяКолонкиШаблон		= "{ТЧ}" + ИмяКолонкиШаблон;
	#КонецЕсли

	СбисОтложенныеОперации	= Новый Структура("ПоследнийВызовМС, СообщатьОбОшибках, Процедуры", Ложь, 600, Истина);
	СбисОтложенныеОперации.Вставить("Запущено",				Ложь);
	СбисОтложенныеОперации.Вставить("МаксимальныйПериод",	600);
	СбисОтложенныеОперации.Вставить("СообщатьПриОшибке",	Истина);

	СеансИнтерфейс			= Новый Структура("Блокировки, ШаблонРеквизитаКолонок, ИмяРеквизитаКолонок, СтруктураРазделов", Новый Соответствие);
	КэшФорм					= Новый Структура("Получены, Клиентские, Стандартные, Интерфейсные", Новый Соответствие, Новый СписокЗначений);
	НаборМодулейСеанса		= Новый Структура("Интеграция, ФункцииДокументов, Настройки, НастройкиСБИС, МодульСопоставлениеНоменклатуры, МодульХраненияСтатусов, МодульУправленияНастройками");
	ОписаниеКонфигурации	= Новый Структура("ТипыПолей1С, ТипыПолейФильтра, ИмяРегистраДополнительныхСведений, ИмяРеквизитаЕдиницыИзмерения, ПредставленияТипов", Новый Структура, Новый Структура, "", "");
	ОписаниеКонфигурации.Вставить("ОписаниеМетаданныхШтрихкодов", Новый Структура);
	ОписаниеКонфигурации.Вставить("ИмяМодуляСопоставленияНоменклатуры", "");
	
	НаборПараметровСеанса	= Новый Структура("Идентификатор, РежимОтладки, ТихийРежим", Строка(Новый УникальныйИдентификатор), Ложь, Ложь);
	НаборПараметровСеанса.Вставить("ПервыйЗапуск",							Ложь);
	НаборПараметровСеанса.Вставить("НоваяВерсия",							Ложь);
	НаборПараметровСеанса.Вставить("АвтоматическоеСозданиеНоменклатуры",	Ложь);
	
	СбисОтложенныеОперации.Процедуры		= Новый Соответствие;
	СеансИнтерфейс.ШаблонРеквизитаКолонок	= ПутьКРеквизитуКолонки;
	СеансИнтерфейс.ИмяРеквизитаКолонок		= ИмяКолонкиШаблон;
	СеансИнтерфейс.СтруктураРазделов		= НовыйСтруктураРазделов();
	СеансИнтерфейс.Вставить("КэшироватьИнтерфейсныеФормы", Истина);
	
	КэшТекущегоСеанса = Новый Структура("Интерфейс, СбисОтложенныеОперации, Параметры, СведенияОбИнтеграции, РеквизитыСторонДляПоиска");
	КэшТекущегоСеанса.Вставить("Формы",						КэшФорм);
	КэшТекущегоСеанса.Вставить("Модули",					НаборМодулейСеанса);
	КэшТекущегоСеанса.Вставить("Функции",					Новый Структура);
	КэшТекущегоСеанса.Вставить("РасчитанныеЗначения",		Новый Структура);
	КэшТекущегоСеанса.Вставить("ОписаниеКонфигурации",		ОписаниеКонфигурации);
	КэшТекущегоСеанса.СбисОтложенныеОперации	= СбисОтложенныеОперации;
	КэшТекущегоСеанса.Параметры					= НаборПараметровСеанса;
	КэшТекущегоСеанса.Интерфейс					= СеансИнтерфейс;
	
	Возврат КэшТекущегоСеанса;
	
КонецФункции
	
// v8unpack &НаКлиенте
Процедура ТекущийСеанс_Вставить(ТекущийСеанс, КлючВставить, ЗначениеВставить)
	
	Если КлючВставить = "СтандартныеФормы" Тогда
		
		ТекущийСеанс.Формы.Стандартные	= ЗначениеВставить;
		
	ИначеЕсли КлючВставить = "ИнтерфейсныеФормы" Тогда

		ТекущийСеанс.Формы.Интерфейсные	= ЗначениеВставить;
		
	КонецЕсли;
	
КонецПроцедуры

// v8unpack &НаКлиенте
Процедура ТекущийСеанс_ОчиститьОбъект(ТекущийСеанс, ЗавершениеРаботы = Истина)
		
	Если ЗавершениеРаботы Тогда
		
		Для Каждого КлючИЗначениеМодуль Из ТекущийСеанс.Формы.Получены Цикл
		
			Если КлючИЗначениеМодуль.Значение = Ложь Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			// Очистить связи полученных форм
			Попытка
				
				КлючИЗначениеМодуль.Значение.Кэш = Неопределено;
				
			Исключение
			КонецПопытки;
			Попытка
				
				КлючИЗначениеМодуль.Значение.ЛокальныйКэш = Неопределено;
				
			Исключение
			КонецПопытки;
			
			Попытка
				
				КлючИЗначениеМодуль.Значение.МестныйКэш = Неопределено;
				
			Исключение
			КонецПопытки;
			
			КлючИЗначениеМодуль.Значение.ВладелецФормы = Неопределено;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ТекущийСеанс.Формы.Получены.Очистить();
	ТекущийСеанс.Модули.Очистить();
	ТекущийСеанс.Функции.Очистить();
	
КонецПроцедуры

// v8unpack &НаКлиенте
Функция НовыйТекущийСеанс(ПараметрыКонструктора = Неопределено)
	Перем ЗначениеСеансУстановить, ПараметрыСистемыТекущие;
	
	ТекущийСеансПустой = НовыйТекущийСеанс_Пустой();
	ТекущийСеанс_Вставить(ТекущийСеансПустой, "СтандартныеФормы",	ТекущийСеанс_СтандартныеФормы());
	ТекущийСеанс_Вставить(ТекущийСеансПустой, "ИнтерфейсныеФормы",	ТекущийСеанс_ИнтерфейсныйФормы());
	
	Если ПараметрыКонструктора.Свойство("ПараметрыСистемы", ПараметрыСистемыТекущие) Тогда
		
		ОпцияПоСовестимости =	ПараметрыСистемыТекущие.Клиент.УправляемоеПриложение
							И	ЗначениеЗаполнено(ПараметрыСистемыТекущие.Конфигурация.РежимСовместимости)
							И	СравнитьВерсииБольшеМеньше(ПараметрыСистемыТекущие.Конфигурация.РежимСовместимости, "8.3.6.1");				
							
		ТекущийСеансПустой.Интерфейс.КэшироватьИнтерфейсныеФормы = НЕ (ПараметрыСистемыТекущие.Клиент.ЭтоLinux ИЛИ ОпцияПоСовестимости);
		
	КонецЕсли;
	
	Возврат ТекущийСеансПустой;
	
КонецФункции

// Функция - Содержит список доступных способов обработки номенклатуры для диалогов
// 
// Возвращаемое значение:
//  СписокЗначений - где значение число код обработки номенклатуры, представление - имя модуля
//
// v8unpack &НаКлиенте
Функция СписокДоступныхСпособовСопоставленияНоменклатуры(Режим = "Интерфейс", ДопПараметры = Неопределено) Экспорт
	
	РасширенныйФункционалСопоставленияНоменклатуры	=	 (ПолучитьЗначениеФичи("РасширенныйФункционалСопоставленияНоменклатуры") 
															ИЛИ ПолучитьЗначениеФичи("РасширенныйФункционалСопоставленияНоменклатуры4100"))
														И МодульОбъектаКлиент().ПолучитьЗначениеПараметраСБИС("ИспользоватьНовоеСопоставлениеНоменклатуры");
	ВариантыСопоставления = Новый СписокЗначений();
	
	Если РасширенныйФункционалСопоставленияНоменклатуры Тогда 
		ВариантыСопоставления.Добавить(0, "СопоставлениеНоменклатуры_СБИС");
	КонецЕсли;
	ВариантыСопоставления.Добавить(1, "СопоставлениеНоменклатуры_ДБФ");
	ВариантыСопоставления.Добавить(2, "СопоставлениеНоменклатуры_Справочники");
	ВариантыСопоставления.Добавить(3, "СопоставлениеНоменклатуры_Регистры");
	ВариантыСопоставления.Добавить(4, "СопоставлениеНоменклатуры_СуммовойУчет");
	
	Возврат ВариантыСопоставления;
	
КонецФункции

// Функция - Содержит список доступных способов обработки документов для диалогов
// 
// Возвращаемое значение:
//  СписокЗначений - где значение число код обработки документов, представление - имя модуля
//
// v8unpack &НаКлиенте
Функция СписокДоступныхСпособовХраненияСтатусов(Режим = "Интерфейс", ДопПараметры = Неопределено) Экспорт
	
	ВариантыСопоставления = Новый СписокЗначений();
