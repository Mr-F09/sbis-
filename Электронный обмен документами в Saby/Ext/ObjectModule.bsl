Функция сбисПересчитатьСуммовыеПоля(Строка, Документ) Экспорт
	СуммаВключаетНДС = Документ.СуммаВключаетНДС;
	Если Строка.СтавкаНДС = Перечисления.СтавкиНДС.НДС22 Тогда 
		Если СуммаВключаетНДС Тогда 
			СтавкаНДС = 22/122;	
		Иначе
			СтавкаНДС = 0.22;
		КонецЕсли;
	ИначеЕсли Строка.СтавкаНДС = Перечисления.СтавкиНДС.НДС20 Тогда 
		Если СуммаВключаетНДС Тогда 
			СтавкаНДС = 20/120;	
		Иначе
			СтавкаНДС = 0.2;
		КонецЕсли;
	ИначеЕсли Строка.СтавкаНДС = Перечисления.СтавкиНДС.НДС18 Тогда 
		Если СуммаВключаетНДС Тогда 
			СтавкаНДС = 18/118;	
		Иначе
			СтавкаНДС = 0.18;
		КонецЕсли;
	ИначеЕсли Строка.СтавкаНДС = Перечисления.СтавкиНДС.НДС10 Тогда 
		Если СуммаВключаетНДС Тогда 
			СтавкаНДС = 10/110;	
		Иначе
			СтавкаНДС = 0.1;
		КонецЕсли;
	ИначеЕсли Строка.СтавкаНДС = Перечисления.СтавкиНДС.НДС5 Тогда 
		Если СуммаВключаетНДС Тогда 
			СтавкаНДС = 5/105;	
		Иначе
			СтавкаНДС = 0.05;
		КонецЕсли;
	ИначеЕсли Строка.СтавкаНДС = Перечисления.СтавкиНДС.НДС7 Тогда 
		Если СуммаВключаетНДС Тогда 
			СтавкаНДС = 7/107;	
		Иначе
			СтавкаНДС = 0.07;
		КонецЕсли;
	Иначе 
		СтавкаНДС = 0;
	КонецЕсли; 
	Если ЗначениеЗаполнено(Строка.Количество) И ЗначениеЗаполнено(Строка.Цена) Тогда
		Строка.Сумма = Строка.Количество*Строка.Цена;
		Строка.СуммаНДС = Строка.Сумма*СтавкаНДС;
	КонецЕсли;
	Возврат Строка;
	
КонецФункции  

Функция сбисРассчитатьСтавкуИСуммуНДСДляСтрокДокумента_УНФ(Документ, ПересчитыватьНДСПоДанным1С) Экспорт
	СтавкаНДСПоУмолчанию = Вычислить("Справочники.СтавкиНДС.СтавкаНДС(Документ.Организация.ВидСтавкиНДСПоУмолчанию,?(ЗначениеЗаполнено(Документ.Дата), Документ.Дата, ТекущаяДатаСеанса()))");
	
	ТабличныеЧастиДокумента = Документ.Метаданные().ТабличныеЧасти;
	
	Если ТабличныеЧастиДокумента.Найти("Запасы") <> Неопределено Тогда
		Для каждого СтрокаТабличнойЧасти Из Документ.Запасы Цикл
			Если НЕ (ПересчитыватьНДСПоДанным1С = 1
						ИЛИ (ПересчитыватьНДСПоДанным1С = 0 
								И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.СуммаНДС)
								И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.СтавкаНДС))) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТабличныеЧастиДокумента.Запасы.Реквизиты.Найти("ЭтоРазделитель") <>  Неопределено И СтрокаТабличнойЧасти.ЭтоРазделитель Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.Номенклатура.ВидСтавкиНДС) Тогда
				СтрокаТабличнойЧасти.СтавкаНДС = Вычислить("Справочники.СтавкиНДС.СтавкаНДС(СтрокаТабличнойЧасти.Номенклатура.ВидСтавкиНДС, ?(ЗначениеЗаполнено(Документ.Дата), Документ.Дата, ТекущаяДатаСеанса()))");
			Иначе
				СтрокаТабличнойЧасти.СтавкаНДС = СтавкаНДСПоУмолчанию;
			КонецЕсли;
			
			СтавкаНДС = Вычислить("УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(СтрокаТабличнойЧасти.СтавкаНДС)");
			СтрокаТабличнойЧасти.СуммаНДС = ?(Документ.СуммаВключаетНДС, 
			СтрокаТабличнойЧасти.Сумма - (СтрокаТабличнойЧасти.Сумма) / ((СтавкаНДС + 100) / 100),
			СтрокаТабличнойЧасти.Сумма * СтавкаНДС / 100);
			СтрокаТабличнойЧасти.Всего = СтрокаТабличнойЧасти.Сумма + ?(Документ.СуммаВключаетНДС, 0, СтрокаТабличнойЧасти.СуммаНДС);
		КонецЦикла;
	КонецЕсли;
	
	Если ТабличныеЧастиДокумента.Найти("Расходы") <> Неопределено Тогда
		Для каждого СтрокаТабличнойЧасти Из Документ.Расходы Цикл
			Если НЕ (ПересчитыватьНДСПоДанным1С = 1
						ИЛИ (ПересчитыватьНДСПоДанным1С = 0 
								И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.СуммаНДС)
								И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.СтавкаНДС))) Тогда
				Продолжить;
			КонецЕсли;
			
			Если ТабличныеЧастиДокумента.Расходы.Реквизиты.Найти("ЭтоРазделитель") <>  Неопределено И СтрокаТабличнойЧасти.ЭтоРазделитель Тогда
				Продолжить;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(СтрокаТабличнойЧасти.Номенклатура.ВидСтавкиНДС) Тогда
				СтрокаТабличнойЧасти.СтавкаНДС = Вычислить("Справочники.СтавкиНДС.СтавкаНДС(СтрокаТабличнойЧасти.Номенклатура.ВидСтавкиНДС, ?(ЗначениеЗаполнено(Документ.Дата), Документ.Дата, ТекущаяДатаСеанса()))");
			Иначе
				СтрокаТабличнойЧасти.СтавкаНДС = СтавкаНДСПоУмолчанию;
			КонецЕсли;
			
			СтавкаНДС = Вычислить("УправлениеНебольшойФирмойПовтИсп.ПолучитьЗначениеСтавкиНДС(СтрокаТабличнойЧасти.СтавкаНДС)");
			СтрокаТабличнойЧасти.СуммаНДС = ?(Документ.СуммаВключаетНДС, 
			СтрокаТабличнойЧасти.Сумма - (СтрокаТабличнойЧасти.Сумма) / ((СтавкаНДС + 100) / 100),
			СтрокаТабличнойЧасти.Сумма * СтавкаНДС / 100);
			СтрокаТабличнойЧасти.Всего = СтрокаТабличнойЧасти.Сумма + ?(Документ.СуммаВключаетНДС, 0, СтрокаТабличнойЧасти.СуммаНДС);
		КонецЦикла;
	КонецЕсли;
КонецФункции

Функция сбисРассчитатьЦеныСтавкиИСуммыНДСДляСтрокТЧТоварыДокумента_УТ11(Документ, ПересчитыватьНДСПоДанным1С, ПересчитыватьЦеныПоДанным1С) Экспорт
	Если ПересчитыватьНДСПоДанным1С = 2 И ПересчитыватьЦеныПоДанным1С = 2 Тогда
		// Ничего не пересчитываем по данным 1С
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Метаданные.ОбщиеМодули.Найти("ОбработкаТабличнойЧастиКлиентСервер") <> Неопределено Тогда
		МодульОбработкиТЧ = "ОбработкаТабличнойЧасти";
	ИначеЕсли Метаданные.ОбщиеМодули.Найти("ПакетнаяОбработкаТабличнойЧастиКлиентСервер") <> Неопределено Тогда
		МодульОбработкиТЧ = "ПакетнаяОбработкаТабличнойЧасти";
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Документ.Дата) Тогда
		Документ.Дата = ТекущаяДата();
	КонецЕсли;
	
	СтруктураПересчетаСуммы = Вычислить(МодульОбработкиТЧ + "КлиентСервер.ПараметрыПересчетаСуммыНДСВСтрокеТЧ(Документ)");
	КэшированныеЗначения = Вычислить(МодульОбработкиТЧ + "КлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения()");
	
	ТЧТоварыРеквизитыМетаданные = Документ.Метаданные().ТабличныеЧасти.Товары.Реквизиты;
	ЕстьРучнаяСкидка		 = НЕ ТЧТоварыРеквизитыМетаданные.Найти("СуммаРучнойСкидки") = Неопределено;
	ЕстьАвтоматическаяСкидка = НЕ ТЧТоварыРеквизитыМетаданные.Найти("СуммаАвтоматическойСкидки") = Неопределено;
	
	ДопПараметрыПроверки = Новый Структура("НаборОбъектов, Объект", "Реквизиты", Документ.Соглашение);
	
	ИменаВидаЦена = "ВидЦеныПоставщика
					|ВидЦеныКлиента
					|ВидЦены
					|ВидЦен";
	
	ВозможныеИменаРеквизитаЦен = Новый Структура;
	Для НомерИмени = 1 По СтрЧислоСтрок(ИменаВидаЦена) Цикл
		ИмяРеквизита = СтрПолучитьСтроку(ИменаВидаЦена, НомерИмени);
		ВозможныеИменаРеквизитаЦен.Вставить(ИмяРеквизита,
											СбисСуществуетОбъектКонфигурацииСервер(ИмяРеквизита, ДопПараметрыПроверки));
		Если ВозможныеИменаРеквизитаЦен[ИмяРеквизита] Тогда
			Прервать;
		КонецЕсли
	КонецЦикла;
	
	ИмяВидаЦеныТЧ = "";
	Для НомерИмени = 1 По СтрЧислоСтрок(ИменаВидаЦена) Цикл
		ИмяРеквизита = СтрПолучитьСтроку(ИменаВидаЦена, НомерИмени);
		Если ТЧТоварыРеквизитыМетаданные.Найти(ИмяРеквизита) <> Неопределено Тогда
			ИмяВидаЦеныТЧ = ИмяРеквизита;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	ЭтоПокупка = ТипЗнч(Документ.Соглашение) = Тип("СправочникСсылка.СоглашенияСПоставщиками");

	Для каждого СтрокаТабличнойЧасти Из Документ.Товары Цикл
		ПересчитатьНДСПоДанным1С = Ложь;
		ПересчитатьЦеныПоДанным1С = Ложь;
		
		СтруктураДействий = Новый Структура;
		
		Если ПересчитыватьНДСПоДанным1С = 1
					ИЛИ (ПересчитыватьНДСПоДанным1С = 0 
							И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.СуммаНДС)
							И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.СтавкаНДС)) Тогда
							
			СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", Новый Структура("НалогообложениеНДС, Дата, Организация", Документ.НалогообложениеНДС, Документ.Дата, Документ.Организация));
			СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
			ПересчитатьНДСПоДанным1С = Истина;
		КонецЕсли;
		
		Если (ПересчитыватьЦеныПоДанным1С = 1
					ИЛИ (ПересчитыватьЦеныПоДанным1С = 0 
							И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.Сумма)
							И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.Цена)))
			 И ЗначениеЗаполнено(Документ.Соглашение) Тогда
							
			 Для каждого ИмяРеквизита Из ВозможныеИменаРеквизитаЦен Цикл
				Если ИмяРеквизита.Значение Тогда
					СтрокаТабличнойЧасти[ИмяВидаЦеныТЧ] = Документ.Соглашение[ИмяРеквизита.Ключ];
					Прервать;
				КонецЕсли;
			КонецЦикла;

			ЗаполнитьЦену = Новый Структура("Дата, Валюта", Документ.Дата, Документ.Валюта);
			Если ЭтоПокупка Тогда
			
				ЗаполнитьЦену.Вставить("ВернутьМногооборотнуюТару", Ложь);
				ЗаполнитьЦену.Вставить("НалогообложениеНДС", Документ.НалогообложениеНДС);
				ЗаполнитьЦену.Вставить("Организация", Документ.Организация);
				ЗаполнитьЦену.Вставить("Партнер", Документ.Партнер);
				ЗаполнитьЦену.Вставить("Соглашение", Документ.Соглашение);
			
			КонецЕсли;
			СтруктураДействий.Вставить("ЗаполнитьЦену" + ?(ЭтоПокупка, "Закупки", "Продажи"), ЗаполнитьЦену);
			ПересчитатьЦеныПоДанным1С = Истина;
		КонецЕсли;
		
		Если ПересчитатьНДСПоДанным1С ИЛИ ПересчитатьЦеныПоДанным1С Тогда
			СтрокаСтруктура = Новый Структура;
			
			СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
			СтруктураДействий.Вставить("ПересчитатьСумму");
			Если ЕстьРучнаяСкидка Тогда
				СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
			КонецЕсли;
			Если ЕстьАвтоматическаяСкидка Тогда
				СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
			КонецЕсли; 
			Выполнить(МодульОбработкиТЧ + "Сервер.ОбработатьСтрокуТЧ(СтрокаТабличнойЧасти, СтруктураДействий, КэшированныеЗначения)");
		КонецЕсли;
	КонецЦикла;
КонецФункции

Функция сбисРассчитатьЦеныСтавкиИСуммыНДСДляСтрокТЧТоварыИУслугиДокумента_УТ10БП2КА1УПП(Документ, ПересчитыватьНДСПоДанным1С, ПересчитыватьЦеныПоДанным1С) Экспорт
	Если ПересчитыватьНДСПоДанным1С = 2 И ПересчитыватьЦеныПоДанным1С = 2 Тогда
		// Ничего не пересчитываем по данным 1С
		Возврат Неопределено;	
	КонецЕсли;
	
	ВалютаРеглУч = Вычислить("Константы.ВалютаРегламентированногоУчета.Получить()");
	ТабличныеЧастиДокумента = Документ.Метаданные().ТабличныеЧасти;
	
	СтруктураШапкиДокумента = Новый Структура("Контрагент,ТипЦен,ДоговорКонтрагента,ДатаДокумента,ВалютаДокумента,УчитыватьНДС,СуммаВключаетНДС");
	ЗаполнитьЗначенияСвойств(СтруктураШапкиДокумента, Документ);
	
	// Выбор метода для получения цен позиций
	Попытка
		
		Если ТипЗнч(Документ.ТипЦен) = Тип("СправочникСсылка.ТипыЦенНоменклатуры") Тогда
		
			ТипДокумента = "Продажи";
			ПараметрыВызова = "(СтрокаТабличнойЧасти, Документ, ВалютаРеглУч)";
			
		Иначе
			
			ТипДокумента = "Покупки";
			ПараметрыВызова = "(СтрокаТабличнойЧасти, Документ, СтруктураШапкиДокумента, ВалютаРеглУч)";
			
		КонецЕсли; 
	
	Исключение
		
		ТипДокумента = "Покупки";
		ПараметрыВызова = "(СтрокаТабличнойЧасти, Документ, СтруктураШапкиДокумента, ВалютаРеглУч)";
	
	КонецПопытки;
	
	Если ТабличныеЧастиДокумента.Найти("Товары") <> Неопределено Тогда
		Для каждого СтрокаТабличнойЧасти Из Документ.Товары Цикл
			ПересчитатьНДСПоДанным1С = Ложь;
			ПересчитатьЦеныПоДанным1С = Ложь;
			
			Если ПересчитыватьНДСПоДанным1С = 1
						ИЛИ (ПересчитыватьНДСПоДанным1С = 0 
								И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.СуммаНДС)
								И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.СтавкаНДС)) Тогда
				Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТабличнойЧасти, Документ)");;
				ПересчитатьНДСПоДанным1С = Истина;
			КонецЕсли;
			
			Если ПересчитыватьЦеныПоДанным1С = 1
						ИЛИ (ПересчитыватьЦеныПоДанным1С = 0 
								И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.Сумма)
								И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.Цена)) Тогда
				Попытка
					Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьЦену" + ТипДокумента + "ТабЧасти" + ПараметрыВызова);
				Исключение
				    Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуЦену" + ТипДокумента + "ТабЧасти" + ПараметрыВызова);
				КонецПопытки;				
				ПересчитатьЦеныПоДанным1С = Истина;
			КонецЕсли;
			
			Если ПересчитатьНДСПоДанным1С ИЛИ ПересчитатьЦеныПоДанным1С Тогда
				Выполнить("ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти, Документ)");
				Выполнить("ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТабличнойЧасти, Документ)");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Если ТабличныеЧастиДокумента.Найти("Услуги") <> Неопределено Тогда
		Для каждого СтрокаТабличнойЧасти Из Документ.Услуги Цикл
			ПересчитатьНДСПоДанным1С = Ложь;
			ПересчитатьЦеныПоДанным1С = Ложь;
			
			Если ПересчитыватьНДСПоДанным1С = 1
						ИЛИ (ПересчитыватьНДСПоДанным1С = 0 
								И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.СуммаНДС)
								И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.СтавкаНДС)) Тогда
				Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьСтавкуНДСТабЧасти(СтрокаТабличнойЧасти, Документ)");;
				ПересчитатьНДСПоДанным1С = Истина;
			КонецЕсли;
			
			Если ПересчитыватьЦеныПоДанным1С = 1
						ИЛИ (ПересчитыватьЦеныПоДанным1С = 0 
								И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.Сумма)
								И НЕ ЗначениеЗаполнено(СтрокаТабличнойЧасти.Цена)) Тогда
				Попытка
					Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьЕдиницуЦену" + ТипДокумента + "ТабЧасти" + ПараметрыВызова);	
				Исключение
					Выполнить("ОбработкаТабличныхЧастей.ЗаполнитьЦену" + ТипДокумента + "ТабЧасти" + ПараметрыВызова);
				КонецПопытки;				
				ПересчитатьЦеныПоДанным1С = Истина;
			КонецЕсли;
			
			Если ПересчитатьНДСПоДанным1С ИЛИ ПересчитатьЦеныПоДанным1С Тогда
				Выполнить("ОбработкаТабличныхЧастей.РассчитатьСуммуТабЧасти(СтрокаТабличнойЧасти, Документ)");
				Выполнить("ОбработкаТабличныхЧастей.РассчитатьСуммуНДСТабЧасти(СтрокаТабличнойЧасти, Документ)");
			КонецЕсли;
		КонецЦикла;		
	КонецЕсли;
КонецФункции

// Функция вызывает обработчик строки табличной части для конфигурации Управление торговлей для Казахстана, редакция 3
//
// Параметры:
//  Документ					 - 	 ДокументОбъект - Заполняемый документ. 
//  ПересчитыватьНДСПоДанным1С	 - 	 Число	- Значение реквизита ПересчитыватьНДСПоДанным1С с формы настроек.
//		Содержит следующие значения:
//			0	-	При незаполненной ставке и сумме НДС
//			1	-	Пересчитывать всегда
//			2	-	Не пересчитывать
//  ПересчитыватьЦеныПоДанным1С	 - 	 Число	- Значение реквизита ПересчитыватьЦеныПоДанным1С с формы настроек.
//		Содержит следующие значения:
//			0	-	При незаполненных цене и сумме
//			1	-	Пересчитывать всегда
//			2	-	Не пересчитывать
//
// Возвращаемое значение:
//	Неопределено
//
Функция СбисРассчитатьЦеныСтавкиИСуммыНДСДляСтрокТЧТоварыДокумента_УТК3(Документ, ПересчитыватьНДСПоДанным1С, ПересчитыватьЦеныПоДанным1С) Экспорт
	
	Если ПересчитыватьНДСПоДанным1С = 2 И ПересчитыватьЦеныПоДанным1С = 2 Тогда
		// Ничего не пересчитываем по данным 1С
		Возврат Неопределено;	
	КонецЕсли;
	
	СтруктураПересчетаСуммы = Вычислить("ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруПересчетаСуммыНДСВТЧ(Документ)");
	КэшированныеЗначения = Вычислить("ОбработкаТабличнойЧастиКлиентСервер.ПолучитьСтруктуруКэшируемыеЗначения()");  
	
	ПараметрыЗаполненияСтавкиНДС = Новый Структура; 
	ПараметрыЗаполненияСтавкиНДС.Вставить("НалогообложениеНДС", Документ.НалогообложениеНДС);
	ПараметрыЗаполненияСтавкиНДС.Вставить("Дата", Документ.Дата);
    ПараметрыЗаполненияСтавкиНДС.Вставить("Организация", Документ.Организация);
	
	ТЧТоварыРеквизитыМетаданные = Документ.Метаданные().ТабличныеЧасти.Товары.Реквизиты;
	ЕстьРучнаяСкидка		 = Не ТЧТоварыРеквизитыМетаданные.Найти("СуммаРучнойСкидки") = Неопределено;
	ЕстьАвтоматическаяСкидка = Не ТЧТоварыРеквизитыМетаданные.Найти("СуммаАвтоматическойСкидки") = Неопределено;
	
	Для каждого СтрокаТабличнойЧасти Из Документ.Товары Цикл 
		
		ПересчитатьНДСПоДанным1С = ПересчитыватьНДСПоДанным1С = 1
			Или (ПересчитыватьНДСПоДанным1С = 0 
			И Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.СуммаНДС)
			И Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.СтавкаНДС));  
			
		ПересчитатьЦеныПоДанным1С = (ПересчитыватьЦеныПоДанным1С = 1
			Или (ПересчитыватьЦеныПоДанным1С = 0 
			И Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.Сумма)
			И Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.Цена)))
			И ЗначениеЗаполнено(Документ.Соглашение);
		
		СтруктураДействий = Новый Структура;
		
		Если ПересчитатьНДСПоДанным1С Тогда 
			
			СтруктураДействий.Вставить("ЗаполнитьСтавкуНДС", ПараметрыЗаполненияСтавкиНДС);
			СтруктураДействий.Вставить("ПересчитатьСуммуНДС", СтруктураПересчетаСуммы);
			
		КонецЕсли;
		
		Если ПересчитатьЦеныПоДанным1С Тогда
							
			Если Документ.Соглашение.Метаданные().Реквизиты.Найти("ВидЦен") = Неопределено Тогда 
				СтруктураДействий.Вставить("ЗаполнитьВидЦены", Новый Структура("ВидЦены", Документ.Соглашение.ВидЦеныПоставщика));
			Иначе
				СтруктураДействий.Вставить("ЗаполнитьВидЦены", Новый Структура("ВидЦены", Документ.Соглашение.ВидЦен));
			КонецЕсли;
			СтруктураДействий.Вставить("ЗаполнитьЦенуПродажи", Новый Структура("Дата, Валюта", Документ.Дата, Документ.Валюта));
			
		КонецЕсли;
		
		Если ПересчитатьНДСПоДанным1С Или ПересчитатьЦеныПоДанным1С Тогда
			
			СтруктураДействий.Вставить("ПересчитатьСуммуСНДС", СтруктураПересчетаСуммы);
			СтруктураДействий.Вставить("ПересчитатьСумму");
			Если ЕстьРучнаяСкидка Тогда
				СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомРучнойСкидки", Новый Структура("Очищать", Ложь));
			КонецЕсли;
			Если ЕстьАвтоматическаяСкидка Тогда
				СтруктураДействий.Вставить("ПересчитатьСуммуСУчетомАвтоматическойСкидки", Новый Структура("Очищать", Истина));
			КонецЕсли; 
			Выполнить("ОбработкаТабличнойЧастиСервер.ОбработатьСтрокуТЧ(СтрокаТабличнойЧасти, СтруктураДействий, КэшированныеЗначения)"); 
			
		КонецЕсли;  
		
	КонецЦикла;
	
КонецФункции

Функция сбисРассчитатьСкидкиНаценки_УТ11(Документ, АвтоматическиеСкидки, МодульРасчетаСкидок) Экспорт
	
	Если АвтоматическиеСкидки И ЗначениеЗаполнено(МодульРасчетаСкидок) Тогда
		СтруктураПараметры = Новый Структура;
		СтруктураПараметры.Вставить("ПрименятьКОбъекту",                Истина);
		СтруктураПараметры.Вставить("ТолькоПредварительныйРасчет",      Ложь);
		СтруктураПараметры.Вставить("ВосстанавливатьУправляемыеСкидки", Истина);
		СтруктураПараметры.Вставить("УправляемыеСкидки", Новый СписокЗначений);
		
		ПримененныеСкидки = Вычислить(МодульРасчетаСкидок + ".Рассчитать(Документ, СтруктураПараметры)");

		Документ.СкидкиРассчитаны = Истина;
	Иначе
		// Ничего не пересчитываем
		Возврат Неопределено;
		
	КонецЕсли;
	
КонецФункции

