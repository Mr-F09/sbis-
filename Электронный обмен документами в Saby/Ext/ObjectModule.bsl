Функция ВложениеСБИС_Получить_ВизуализацияДокумента(ВложениеСбис, ДопПараметры)
	Перем Результат;
	
	Если	ВложениеСбис.Свойство("ТекстHTML", Результат) Тогда
		
		Возврат Результат;
		
	КонецЕсли;
	
	МодульИнтеграции = ПолучитьЗначениеПараметраТекущегоСеанса("Интеграция");
	Если	ВложениеСбис.Свойство("Идентификатор")
		И	ЗначениеЗаполнено(ВложениеСбис.Идентификатор) 
		И	ВложениеСБИС.Свойство("СсылкаНаHTML") Тогда
		
		Результат = МодульИнтеграции.ПолучитьHTMLВложения(ПолучитьТекущийЛокальныйКэш(),
											ДопПараметры.СоставПакета.Идентификатор,
											ВложениеСбис);
		
	ИначеЕсли ЗначениеЗаполнено(ВложениеСБИС_Получить(ВложениеСбис, "XMLДокумента")) Тогда
		
		Результат = МодульИнтеграции.ПолучитьHTMLПоXML(ПолучитьТекущийЛокальныйКэш(), ВложениеСбис)	;
		
	Иначе
		
		Результат = "";
	
	КонецЕсли;
	
	ВложениеСбис.Вставить("ТекстHTML", Результат);	
	
	Возврат Результат;

