		ИЛИ	ИсточникПроверкиПараметра.Модули.Свойство							(ИмяПараметраПоиск, ЗначениеПараметраСбис)
		ИЛИ	ИсточникПроверкиПараметра.Параметры.Свойство						(ИмяПараметраПоиск, ЗначениеПараметраСбис)
		ИЛИ	ИсточникПроверкиПараметра.ОписаниеКонфигурации.Свойство				(ИмяПараметраПоиск, ЗначениеПараметраСбис)
		ИЛИ	ИсточникПроверкиПараметра.ОписаниеКонфигурации.ТипыПолей1С.Свойство	(ИмяПараметраПоиск, ЗначениеПараметраСбис);
		
	Возврат ЗначениеПараметраСбис;
	
