//  - Произвольный - Результат обсчета алгоритма
//
//DynamicDirective
Функция context_add_request(request_exception, block_context)
	QueryId = request_exception.dump.QueryId;
	deadline = request_exception.dump.deadline;
	block_context_request = Новый Структура;
	Для Каждого Элемент Из block_context Цикл
		block_context_request.Вставить(Элемент.Ключ, Элемент.Значение);	
	КонецЦикла; 
	сз = Новый СписокЗначений;
	сз.ЗагрузитьЗначения(context.block_context.__thread_vars);
	block_context_request.Вставить("__thread_vars", сз.ВыгрузитьЗначения()); 
	Запись_QueryId = request_exception.dump; 
	Запись_QueryId.Вставить("block_context", block_context_request);
	ТранспортИнтеграции.async_requests.Вставить(QueryId, Запись_QueryId);
	context.block_context.Вставить("__thread_vars", Новый Массив);
	context.block_context.__thread_vars.Добавить(Новый Соответствие);
	Возврат Неопределено;
