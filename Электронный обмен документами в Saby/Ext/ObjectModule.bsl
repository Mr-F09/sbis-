//DynamicDirective

// Разбивает строку на несколько строк по указанному разделителю. Разделитель может иметь любую длину.
// В случаях, когда разделителем является строка из одного символа, и не используется параметр СокращатьНепечатаемыеСимволы,
// рекомендуется использовать функцию платформы СтрРазделить.
//
// Параметры:
//  Значение               - Строка - текст с разделителями.
//  Разделитель            - Строка - разделитель строк текста, минимум 1 символ.
//  ПропускатьПустыеСтроки - Булево - признак необходимости включения в результат пустых строк.
//    Если параметр не задан, то функция работает в режиме совместимости со своей предыдущей версией:
//     > для разделителя-пробела пустые строки не включаются в результат, для остальных разделителей пустые строки
//       включаются в результат;
//     > если параметр Строка не содержит значащих символов или не содержит ни одного символа (пустая строка), то в
//       случае разделителя-пробела результатом функции будет массив, содержащий одно значение "" (пустая строка), а
//       при других разделителях результатом функции будет пустой массив.
//  СокращатьНепечатаемыеСимволы - Булево - сокращать непечатаемые символы по краям каждой из найденных подстрок.
//
// Возвращаемое значение:
//  Массив из Строка
//
// Пример:
//  СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(",один,,два,", ",")
//  - возвратит массив из 5 элементов, три из которых  - пустые: "", "один", "", "два", "";
//  СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(",один,,два,", ",", Истина)
//  - возвратит массив из двух элементов: "один", "два";
//  СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(" один   два  ", " ")
//  - возвратит массив из двух элементов: "один", "два";
//  СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок("")
//  - возвратит пустой массив;
//  СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок("",,Ложь)
//  - возвратит массив с одним элементом: ""(пустая строка);
//  СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок("", " ")
//  - возвратит массив с одним элементом: "" (пустая строка).
//
Функция СбисРазложитьСтрокуВМассивПодстрок(Знач Значение, Знач Разделитель = ",", Знач ПропускатьПустыеСтроки = Неопределено, 
	СокращатьНепечатаемыеСимволы = Ложь) Экспорт
	
	Если СтрДлина(Разделитель) = 1 
		И ПропускатьПустыеСтроки = Неопределено 
		И СокращатьНепечатаемыеСимволы Тогда 
		
		Результат = СбисРазложитьСтрокуВМассивРежимСовместимости(Значение, Разделитель);
		Для Индекс = 0 По Результат.ВГраница() Цикл
			Результат[Индекс] = СокрЛП(Результат[Индекс])
		КонецЦикла;
		Возврат Результат;
		
	КонецЕсли;
	
	Результат = Новый Массив;
	
	// Для обеспечения обратной совместимости.
	Если ПропускатьПустыеСтроки = Неопределено Тогда
		ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
		Если ПустаяСтрока(Значение) Тогда 
			Если Разделитель = " " Тогда
				Результат.Добавить("");
			КонецЕсли;
			Возврат Результат;
		КонецЕсли;
	КонецЕсли;
	//
	
	Позиция = Найти(Значение, Разделитель);
	Пока Позиция > 0 Цикл
		Подстрока = Лев(Значение, Позиция - 1);
		Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
			Если СокращатьНепечатаемыеСимволы Тогда
				Результат.Добавить(СокрЛП(Подстрока));
			Иначе
				Результат.Добавить(Подстрока);
			КонецЕсли;
		КонецЕсли;
		Значение = Сред(Значение, Позиция + СтрДлина(Разделитель));
		Позиция = Найти(Значение, Разделитель);
	КонецЦикла;
	
	Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Значение) Тогда
		Если СокращатьНепечатаемыеСимволы Тогда
			Результат.Добавить(СокрЛП(Значение));
		Иначе
			Результат.Добавить(Значение);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

//DynamicDirective
Функция СбисРазложитьСтрокуВМассивРежимСовместимости(Знач ИсходнаяСтрока, Разделитель = ",")
	
	Подстроки = Новый Массив;
	МногострочнаяСтрока = СтрЗаменить(ИсходнаяСтрока, Разделитель, Символы.ПС);
	
	Для Индекс = 1 По СтрЧислоСтрок(МногострочнаяСтрока) Цикл
		Подстроки.Добавить(СтрПолучитьСтроку(МногострочнаяСтрока, Индекс));
	КонецЦикла; 
	
	Возврат Подстроки;
	
КонецФункции

//DynamicDirective

// Функция - Это ссылка на справочник номенклатуры
//
// Параметры:
//  Ссылка						 - Предполагаемая ссылка на справочник номенклатуры
//  ВидыСправочниковНоменклатуры - Строка / Неопределено  - перечислены через запятую виды справочников
// 
// Возвращаемое значение:
//  - Булево
//
Функция ЭтоСсылкаНаСправочникНоменклатуры(Ссылка, ВидыСправочниковНоменклатуры = Неопределено) Экспорт
	
	Результат = Ложь;
	
	Если ВидыСправочниковНоменклатуры = Неопределено Тогда
		Результат = Истина; // Заглушка, если нет узла в ини Конфигурация
	Иначе
		ВидыСправочниковНоменклатуры = СбисРазложитьСтрокуВМассивПодстрок(ВидыСправочниковНоменклатуры, ",");
	
		Для Каждого ВидСправочника Из ВидыСправочниковНоменклатуры Цикл
			Если ТипЗнч(Ссылка) = Тип(ВидСправочника) Тогда
				Результат = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция - Сбис идентификатор документа 1С
//
// Параметры:
//  Документ1С - ДокументСсылка, Структура - Документ 1С, который нужно идентифицировать
// 
// Возвращаемое значение:
//  ДокуентСсылка, Строка, УникальныйИдентификатор - Идентификатор документа 1С
//
//DynamicDirective
Функция СбисИдентификаторДокумента1С(Документ1С, ИмяИни = "") Экспорт
	Перем Результат;
	
	Если ТипЗнч(Документ1С) = Тип("Структура") Тогда
		
		Если Документ1С.Свойство("Идентификатор") Тогда
			
			Результат = Документ1С.Идентификатор;	
			
		КонецЕсли;
		
	Иначе
		
		Если ПустаяСтрока(ИмяИни) Тогда
			
			Результат = Документ1С;
			
		Иначе
			
			Результат = Документ1С.УникальныйИдентификатор();
			Результат = ИмяИни + "#" + Результат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция - Тип сбис в тип 1С
//
// Параметры:
//  ТипСбис	 - Строка - Имя типа из значения параметра СБИС
// 
// Возвращаемое значение:
//  ОписаниеТипа - Аналог типа в 1С
//
//DynamicDirective
Функция ТипСбисВТип1С(ТипСбис) Экспорт 

	ТипСбис = НРег(ТипСбис);
	
	Если	ТипСбис = "string"
		ИЛИ	ТипСбис = "str"
		ИЛИ	ТипСбис = "text" Тогда
	
		Результат = Новый ОписаниеТипов("Строка");
		
	ИначеЕсли ТипСбис = "int"
		ИЛИ ТипСбис = "number" Тогда 
		
		ПараметрыЧисла = Новый КвалификаторыЧисла(15, ?(ТипСбис = "number", 2, 0));
		Результат = Новый ОписаниеТипов("Число", ПараметрыЧисла);
		
	ИначеЕсли ТипСбис = "bool"
		ИЛИ ТипСбис = "logic" Тогда 

		Результат = Новый ОписаниеТипов("Булево");

	ИначеЕсли ТипСбис = "list"
		ИЛИ ТипСбис = "booleangroup" Тогда 
		
		Результат = Новый ОписаниеТипов("СписокЗначений");
		
	ИначеЕсли ТипСбис = "date" Тогда

		ПараметрыДаты = Новый КвалификаторыДаты(ЧастиДаты.Дата);
		Результат = Новый ОписаниеТипов("Дата", , , ПараметрыДаты);

	ИначеЕсли ТипСбис = "daterange" Тогда
		
		Результат = Новый ОписаниеТипов("СтандартныйПериод");
		
	Иначе
		
		Результат = Новый ОписаниеТипов("Неопределено");
	
	КонецЕсли;
	
	Возврат Результат;

КонецФункции // ТипСбисВТип1С()

// v8unpack #Область include_core2_vo2_Модуль_МодульОбъектаКлиентСервер_ОбщегоНазначения_РаботаСоСтроками

//DynamicDirective

// Функция - Применить формат к строке
//
// Параметры:
//  ФорматнаяСтрока			 - Строка	 - к которой применяется формат
//  ПараметрыФорматнойСтроки - Структура/Соответствие/Массив	 - в зависимости от формата
//  КлючФормата				 - Строка	 - как отформатировать строку. Подробнее - смотреть по ключу в коде
// 
// Возвращаемое значение:
//  Строка - отформатированный результат
//
Функция ПрименитьФорматКСтроке(ФорматнаяСтрока, ПараметрыФорматнойСтроки = Неопределено, КлючФормата = "СтрШаблон") Экспорт
	
	КлючПроверка = НРег(КлючФормата);
	
	Если КлючПроверка = "стршаблон" Тогда
		
		// Применяет шаблон, в зависимости от типа ПараметрыФорматнойСтроки строки
		
		// ПараметрыФорматнойСтроки - Структура/Фиксированная структура/Соответствие - {"МойКлюч1": "Hello", "МойКлюч2": "world"}
		// Пример: "{МойКлюч1} {МойКлюч2}" - > "Hello world", 
		
		// ПараметрыФорматнойСтроки - Массив/Фиксированный Массив - ["Hello", "world"]
		// Пример "{0} {1}" - > "Hello world"
		
		// ПараметрыФорматнойСтроки - Строка - "sad" удалит из шаблона
		// Пример "Hello sad world" - > "Hello world"
		
		// Возможно, надо добавить выпиливание параметров, к которым не приминился шаблон
		НоваяФорматнаяСтрока = ФорматнаяСтрока;
		Если	ТипЗнч(ПараметрыФорматнойСтроки) = Тип("Структура")
			Или	ТипЗнч(ПараметрыФорматнойСтроки) = Тип("ФиксированнаяСтруктура")
			Или	ТипЗнч(ПараметрыФорматнойСтроки) = Тип("Соответствие") Тогда
			
			Для Каждого КлючИЗначение Из ПараметрыФорматнойСтроки Цикл
				
				НоваяФорматнаяСтрока = СтрЗаменить(НоваяФорматнаяСтрока, "{" + КлючИЗначение.Ключ + "}", КлючИЗначение.Значение);
				
			КонецЦикла;
			
		ИначеЕсли	ТипЗнч(ПараметрыФорматнойСтроки) = Тип("Массив")
			Или		ТипЗнч(ПараметрыФорматнойСтроки) = Тип("ФиксированныйМассив") Тогда
			
			Для ИндексСтрок = 0 По ПараметрыФорматнойСтроки.Количество() - 1 Цикл
				
				НоваяФорматнаяСтрока = СтрЗаменить(НоваяФорматнаяСтрока, "{" + ИндексСтрок + "}", ПараметрыФорматнойСтроки[ИндексСтрок]);
				
			КонецЦикла;
			
		Иначе
			
			НоваяФорматнаяСтрока = СтрЗаменить(НоваяФорматнаяСтрока, "{СтрШаблон}", ПараметрыФорматнойСтроки);
			
		КонецЕсли;
	
	ИначеЕсли	КлючПроверка = "стрзаменить" Тогда
		
		// Делает последовательно замены по ключу
		// Пример: "МойКлюч1 МойКлюч2" - "Hello world", 
		// ПараметрыФорматнойСтроки - Структура, Фиксированная структура, либо Соответствие - {"МойКлюч1": "Hello", "МойКлюч2": "world"}

		НоваяФорматнаяСтрока = ФорматнаяСтрока;
		
		Для Каждого КлючИЗначение Из ПараметрыФорматнойСтроки Цикл
			
			НоваяФорматнаяСтрока = СтрЗаменить(НоваяФорматнаяСтрока, КлючИЗначение.Ключ, КлючИЗначение.Значение);
			
		КонецЦикла;
		
	ИначеЕсли	КлючПроверка = "убрать" Тогда
		
		НоваяФорматнаяСтрока = ПрименитьФорматКСтроке_Убрать(ФорматнаяСтрока, ПараметрыФорматнойСтроки);
		
	ИначеЕсли	КлючПроверка = "оставить" Тогда
		
		// Оставляет строку только с описанными символами
		// Пример "1H2e@3l4$5l6o w7o8r9l0d?" -> "Hello world"
		// ПараметрыФорматнойСтроки - Строка - "HhelloWworld "

		Если ПараметрыФорматнойСтроки = Неопределено Тогда
			
			Возврат ФорматнаяСтрока;
			
		КонецЕсли;
		
		НоваяФорматнаяСтрока = "";
		Для	Шаг	= 1	По СтрДлина(ФорматнаяСтрока) Цикл
			
			СимволПроверка = Сред(ФорматнаяСтрока, Шаг, 1);
			Если Не Найти(ПараметрыФорматнойСтроки, СимволПроверка) Тогда
				
				Продолжить;
				
			КонецЕсли;
			НоваяФорматнаяСтрока = НоваяФорматнаяСтрока + СимволПроверка;
			
		КонецЦикла;
		
	ИначеЕсли	КлючПроверка = "ключструктуры" Тогда
		
		НоваяФорматнаяСтрока = ПрименитьФорматКСтроке_Ключ(ФорматнаяСтрока);
		
	ИначеЕсли	КлючПроверка = "формат" Тогда
		
		// Обетка над формат
		НоваяФорматнаяСтрока = Формат(ФорматнаяСтрока, ПараметрыФорматнойСтроки);
		
	ИначеЕсли	КлючПроверка = "каталог" Тогда
		
		// Собрать путь к каталогу с разделителем
		ТипОС = СведенияОСКонтекста().Тип;
		
		сРазделитель = "\";
		Если ТипОС = "linux" Тогда
			
			сРазделитель = "/";
			
		КонецЕсли;
		
		НоваяФорматнаяСтрока = ФорматнаяСтрока + ?(Прав(ФорматнаяСтрока, 1) = сРазделитель, "", сРазделитель);
		Если Не ПараметрыФорматнойСтроки = Неопределено Тогда
			
			ФорматЗаменить = Новый Соответствие;
			ФорматЗаменить.Вставить("/", " ");
			ФорматЗаменить.Вставить("\", " ");
			
			Если ТипЗнч(ПараметрыФорматнойСтроки) = Тип("Массив") Тогда
			
				// Добавить путь к основному 
				Для Каждого ЭлементПути Из ПараметрыФорматнойСтроки Цикл
					
					НоваяФорматнаяСтрока = НоваяФорматнаяСтрока + ПрименитьФорматКСтроке(ЭлементПути, ФорматЗаменить, "СтрЗаменить") + сРазделитель;
					
				КонецЦикла;
				
			Иначе
				
				// Добавить путь к основному 
				НоваяФорматнаяСтрока = НоваяФорматнаяСтрока + ПрименитьФорматКСтроке(ПараметрыФорматнойСтроки, ФорматЗаменить, "СтрЗаменить") + сРазделитель;
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли	КлючПроверка = "файл" Тогда
		
		НоваяФорматнаяСтрока = ПрименитьФорматКСтроке(ФорматнаяСтрока, ПараметрыФорматнойСтроки, "Каталог");
		НоваяФорматнаяСтрока = Сред(НоваяФорматнаяСтрока, 1, СтрДлина(НоваяФорматнаяСтрока) - 1);

	Иначе
		
		НоваяФорматнаяСтрока = ФорматнаяСтрока;
		
	КонецЕсли;
	
	Возврат НоваяФорматнаяСтрока;	

КонецФункции

//DynamicDirective

// Функция - Применить формат к строке - сделать ключ структуры
//
// Параметры:
//  ФорматнаяСтрока			 - Строка	 - к которой применяется формат
// 
// Возвращаемое значение:
//  Строка - отформатированный результат
//
Функция ПрименитьФорматКСтроке_Ключ(ФорматнаяСтрока) Экспорт
	
	// Приводит входящую строку так, чтобы ее можно использовать как ключ структуры
	// Пример "1H2e@3l4$5l6o w7o8r9l0d?" -> "Helloworld"

	НоваяФорматнаяСтрока = ПрименитьФорматКСтроке_Убрать(ФорматнаяСтрока);
	Если Найти("0123456789", Лев(НоваяФорматнаяСтрока, 1)) Тогда
		
		//Первый символ - число. Добавить префикс(в структуре ключ не может начинаться с числа)
		НоваяФорматнаяСтрока = "_" + НоваяФорматнаяСтрока;
		
	КонецЕсли;
	
	Возврат НоваяФорматнаяСтрока;	

КонецФункции

//DynamicDirective

// Функция - Применить формат к строке - удалить символы
//
// Параметры:
//  ФорматнаяСтрока			 - Строка	 - к которой применяется формат
//  ПараметрыФорматнойСтроки - Строка	 - набор удаляемых символов
// 
// Возвращаемое значение:
//  Строка - отформатированный результат
//
Функция ПрименитьФорматКСтроке_Убрать(ФорматнаяСтрока, ПараметрыФорматнойСтроки = Неопределено) Экспорт
	
	// Делает последовательно удаления символов из строки
	// Пример "He@l$lo world?" -> "Hello world"
	// ПараметрыФорматнойСтроки - Строка - "@$?"
	
	НоваяФорматнаяСтрока = ФорматнаяСтрока;
	Если ПараметрыФорматнойСтроки = Неопределено Тогда
		
		ПараметрыФорматнойСтроки =  "@/-?=\& ""'#№*(:|;).";
		
	КонецЕсли;
	
	Для	Шаг	= 1	По СтрДлина(ПараметрыФорматнойСтроки) Цикл
		
		НоваяФорматнаяСтрока = СтрЗаменить(НоваяФорматнаяСтрока, Сред(ПараметрыФорматнойСтроки, Шаг, 1), "");
		
	КонецЦикла;
	
	Возврат НоваяФорматнаяСтрока;

КонецФункции

//DynamicDirective

//Функция преобразует строку формата "25.10.2023 21.20.54" или "25.10.2023" в дату 
//для способа обмена SabyHttpsClient, где дата в ответах приходит строкой
Функция ДатаИзСтроки(str) Экспорт
	
	Если ТипЗнч(str) = Тип("Дата") Тогда
		Возврат str;
	КонецЕсли;
	
	Результат = str;
	
	Если	Сред(str,3,1) = "."
		И	Сред(str,6,1) = "." Тогда
		//Переопределим значение как дату, если это действительно она
		Если		СтрДлина(str) = 10 Тогда
			Попытка
				Результат = Дата(Сред(str,7,4), Сред(str,4,2), Лев(str, 2));
			Исключение
				//В случае исключения, ничего не делаем. Это не дата, значение не меняется
			КонецПопытки;
		ИначеЕсли	СтрДлина(str) = 19 Тогда 
			Попытка
				Результат = Дата(Сред(str,7,4), Сред(str,4,2), Лев(str, 2), Сред(str,12, 2), Сред(str,15, 2), Сред(str,18, 2))
			Исключение
				//В случае исключения, ничего не делаем. Это не дата, значение не меняется
			КонецПопытки;
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
КонецФункции

