КонецФункции

// block_obj_get_path_value
//
// Параметры:
//  obj - Структура - обрабатываемый объект
//  obj_path - Строка - Путь внутри объекта
//  obj_name - Строка - Имя объекта
//
// Возвращаемое значение:
//  - Структура - Результат обсчета алгоритма
//
//DynamicDirective
Функция block_obj_get_path_value(Знач obj, obj_path, obj_name)  Экспорт
	delimiter = ".";
	_path = СтрРазделить82(obj_path, delimiter, Ложь);
	_obj = obj;
	
	i = 0;
	size = _path.Количество();
	Пока i < size Цикл
		РезультатЗначения = ПроверкаЗначения(_obj, size, i, _path, obj_path, obj_name, obj);
		Если РезультатЗначения = -1 Тогда 
			Возврат Неопределено;
		КонецЕсли;	
		Если _obj = Неопределено Тогда
			Прервать;
		КонецЕсли;	
		i = i + 1;
	КонецЦикла;	
	Возврат _obj;
КонецФункции

//DynamicDirective

Функция ПроверкаЗначения(_obj, size, i, _path, obj_path, obj_name, obj) 
	ЭтоМассив = ПроверитьНаТипМассив(_obj);
	elem = _path[i];
		
	Если ЭтоМассив = Истина Тогда
		Попытка  // это число
			// BSLLS:TryNumber-off
			// Отказаться нельзя т.к. при приведении к числу мы получим знч по умолчанию типа число, и проверка не получится
			_obj = _obj[Число(elem)];
			// BSLLS:TryNumber-on
		Исключение
			Если (i < size - 1) Тогда
				index = ArrayHelper_find(_obj, _path[i + 1], elem);
			Иначе
				index = -1;
			КонецЕсли;
			Если index >= 0 Тогда
				_obj = _obj[index];
				i = i + 1;
			Иначе
				Возврат -1;
			КонецЕсли;
		КонецПопытки;
		Возврат Неопределено;	
	КонецЕсли;
	Попытка
		#Если Клиент Тогда
			Если ЭтоОбъектМетаданных(_obj) Тогда
				_obj = get_prop_onserver(_obj, elem);
			Иначе
				_obj = get_prop(_obj, elem);	
			КонецЕсли
		#Иначе
			_obj = get_prop(_obj, elem);
		#КонецЕсли	
	Исключение	
		ВызватьИсключение NewExtExceptionСтрока(, "Не удалось получить свойство объекта", "path " + obj_path + " not supported (" + obj_name + ")", "block_obj_get_path_value", obj);
	КонецПопытки;	
	Возврат Неопределено;
КонецФункции

//DynamicDirective

Функция ПроверитьНаТипМассив(_obj)
	
	Если ТипЗнч(_obj) =  Тип("Массив") Тогда
		Возврат Истина;	
	КонецЕсли;
	#Если Сервер Тогда
		Если ТипЗнч(_obj) =  Тип("ТаблицаЗначений") Тогда
			Возврат Истина;	
		КонецЕсли;
	#КонецЕсли
	Возврат Ложь;
КонецФункции

//DynamicDirective

Процедура block_obj_set_path_value(obj, obj_path, value)  Экспорт
	delimiter = ".";
	_path = СтрРазделить82(obj_path, delimiter, Ложь);
	_obj = obj;
	
	i = 0;
	size = _path.Количество() - 1;
	Пока i < size Цикл
		elem = _path[i];
		sub_obj = get_prop(_obj, elem);
		Если sub_obj = Неопределено Тогда
			_obj.Вставить(elem, Новый Соответствие); 	
		КонецЕсли;
        _obj = get_prop(_obj, elem);
		i = i + 1;
	КонецЦикла;
	_obj.Вставить(_path[size], value);
КонецПроцедуры

Процедура block_obj_append_path_value(obj, obj_path, value)  Экспорт
	delimiter = ".";
	_path = СтрРазделить82(obj_path, delimiter, Ложь);
	_obj = obj;
	
	i = 0;
	size = _path.Количество() - 1;
	Пока i <= size Цикл
		elem = _path[i];
		sub_obj = get_prop(_obj, elem); 
		НовыйЭлемент = Новый Соответствие;
		Если i = size Тогда 
			НовыйЭлемент = Новый Массив;
		КонецЕсли;	
		Если sub_obj = Неопределено Тогда 
			_obj.Вставить(elem, НовыйЭлемент); 	
		КонецЕсли;
        _obj = get_prop(_obj, elem);
		i = i + 1;
	КонецЦикла;
		
	Если Найти(Строка(_obj), "ТабличнаяЧасть") = 0 И Найти(Строка(_obj), "ТаблицаЗначений") = 0 Тогда  
		Попытка
			_obj.Добавить(value);
		Исключение   
			Текст = "Объект не является списочным типом. Текущий тип объекта: " + ТипЗнч(_obj);
			ВызватьИсключение Текст; 
		КонецПопытки;
		Возврат;
	КонецЕсли;
	_variable = _obj.Добавить();
	Если ТипЗнч(value) <> Тип("Структура") И ТипЗнч(value) <> Тип("Соответствие") Тогда 
		Возврат;
	КонецЕсли;	
	
	Для Каждого field Из value Цикл
		Попытка
			_variable[field.Ключ] = field.Значение;
		Исключение  
			Продолжить;
		КонецПопытки;
	КонецЦикла;
КонецПроцедуры

Процедура ПреобразоватьСтруктутуКДопустимымXDTOТипам(Переменные)
		
	Для Каждого Стр Из Переменные Цикл
		
		Если Найти(Строка(Стр.Значение),"ТабличнаяЧастьСтрока") Тогда //И СтрДлина(ТипЗнч(Стр.Значение)) > 6 Тогда
			Переменные[Стр.Ключ] = ПолучитьСтруктуруИзСтрокиТабличнойЧасти(Стр.Значение);					
		КонецЕсли;
		
		Если Найти(НРег(ТипЗнч(Стр.Значение)),"объект") Тогда
			Переменные[Стр.Ключ] = ПолучитьСтруктуруИзОбъекта(Стр.Значение);
		КонецЕсли; 
		
		Если Найти(НРег(get_prop(XMLТипЗнч(Стр.Значение),"ИмяТипа","")),"ref") > 0  Тогда
			Переменные[Стр.Ключ] = ПолучитьСтруктуруИзОбъекта(Стр.Значение);
		КонецЕсли;
		
		Если Строка(Стр.Значение) = "СтрокаТаблицыЗначений" Тогда
			Переменные[Стр.Ключ] = ПолучитьСтруктуруИзСтрокиТаблицыЗначений(Стр.Значение);
		КонецЕсли;	
		
		Если ЭтоТипТабличнаяЧасть(Стр.Значение) Тогда
			Табл = Стр.Значение.Выгрузить();
			Переменные[Стр.Ключ] = ПреобразоватьТаблицуЗначенийВМассивСтруктур(Табл);
		КонецЕсли;	
		
	КонецЦикла;
	
КонецПроцедуры	

Функция ПолучитьСтруктуруИзОбъекта(знач Объект)
	Структура = Новый Структура();     
	Если Найти(НРег(get_prop(XMLТипЗнч(Объект),"ИмяТипа","")),"enumref") > 0 Тогда 
		Структура.Вставить("Ссылка", Объект);	
		Возврат Структура;
	КонецЕсли;
	СсылкаНаОбъект = get_prop(Объект, "Ссылка", Неопределено);
	Если СсылкаНаОбъект <> Неопределено Тогда 
		API3 = Api3Object(СсылкаНаОбъект, "");
		Структура.Вставить("ИдИС", get_prop(API3, "ИдИС"));
		Структура.Вставить("ИмяИС", get_prop(API3, "ИмяИС"));
	КонецЕсли;
	Для каждого Реквизит из Объект.Метаданные().СтандартныеРеквизиты Цикл
		Структура.Вставить(Реквизит.Имя, Объект[Реквизит.Имя]);
	КонецЦикла;    
	Для каждого Реквизит из Объект.Метаданные().Реквизиты Цикл
		Структура.Вставить(Реквизит.Имя, Объект[Реквизит.Имя]);
	КонецЦикла;
	Для каждого ТабличнаяЧасть из Объект.Метаданные().ТабличныеЧасти Цикл
		МассивЭлементов = Новый Массив;
		Для Каждого Стр ИЗ Объект[ТабличнаяЧасть.Имя].Выгрузить() Цикл
			МассивЭлементов.Добавить(ПолучитьСтруктуруИзСтрокиТаблицыЗначений(Стр));
		КонецЦикла;	
		Структура.Вставить(ТабличнаяЧасть.Имя, МассивЭлементов);
	КонецЦикла;    
	Возврат Структура;
КонецФункции

Функция ПолучитьСтруктуруИзСтрокиТабличнойЧасти(знач Объект)
	Структура = Новый Структура();
	ПозицияТЧ = Найти(Строка(Объект), "ТабличнаяЧастьСтрока");
	СтрокаОбъект= СтрЗаменить(Строка(Объект), "ТабличнаяЧастьСтрока", "");
	ПутьТЧ		= СтрРазделить82(СтрокаОбъект, ".", Ложь);
	Если ПозицияТЧ > 0 Тогда
		ПутьТЧ.Вставить(2, "ТабличныеЧасти");
	КонецЕсли;
	ТЧ = Метаданные;
	НомЭлем = 0;
	Для каждого Элем из ПутьТЧ Цикл
		Элем = ?(Элем = "Документ", "Документы", Элем);
		ТЧ = ТЧ[Элем];
		НомЭлем = НомЭлем + 1;
	КонецЦикла;
	Для каждого Реквизит из ТЧ.Реквизиты Цикл
		Структура.Вставить(Реквизит.Имя, Объект[Реквизит.Имя]);	
	КонецЦикла;
	Для каждого Реквизит из ТЧ.СтандартныеРеквизиты Цикл
		Структура.Вставить(Реквизит.Имя, Объект[Реквизит.Имя]);	
	КонецЦикла;	
	Возврат Структура;
КонецФункции	

Функция ПолучитьСтруктуруИзСтрокиТаблицыЗначений(знач Объект)
	Структура = Новый Структура;
	Колонки = Объект.Владелец().Колонки;
	Для каждого Колонка Из Колонки Цикл
		Структура.Вставить(Колонка.Имя, Объект[Колонка.Имя]);
	КонецЦикла;	
	Возврат Структура;
КонецФункции	

Функция ПоискОшибокСериализации( Знч, Реквищзит, п3, Отмена ) Экспорт 
	//todoo выпилить функию после реальзации праильного кода. 
