//Функция заполняет структуру с данными о текущем разделе
// v8unpack &НаКлиенте
Функция НовыйРазделГО(ИмяКнопкиРаздела = Неопределено, ДопПараметры = Неопределено) Экспорт
	Перем ИмяРеестра, СтруктураГО, ДопПараметрыРаздела, ПредыдущийРаздел, ТипАккордеона, РодительскийРаздел;
	
	СтруктураРазделов = ПолучитьЗначениеПараметраТекущегоСеанса("СтруктураРазделов");
	Если Не ДопПараметры = Неопределено Тогда
		
		ДопПараметры.Свойство("ПараметрыРаздела",	ДопПараметрыРаздела);
		ДопПараметры.Свойство("ТекущийРаздел",		ПредыдущийРаздел);
		ДопПараметры.Свойство("ТипАккордеона",		ТипАккордеона);
		ДопПараметры.Свойство("РодительскийРаздел",	РодительскийРаздел);
		
		Если ДопПараметры.Свойство("ИмяИни") Тогда
			
			СтруктураГО = НовыйРазделГО_ПоИмениИни(ИмяКнопкиРаздела, ДопПараметры.ИмяИни);
			
		КонецЕсли;	
			
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТипАккордеона) Тогда
		
		ТипАккордеона = "Основной";
		
	КонецЕсли;
		
	Если СтруктураГО = Неопределено Тогда;
		
		СтруктураГО = НовыйРазделГО_ПоДанным(ИмяКнопкиРаздела);
		
	КонецЕсли;
	ИмяИниРеестра = РазделГО_Получить(СтруктураГО, "ИмяИни");		
	
	Если ЗначениеЗаполнено(ИмяИниРеестра) Тогда
		
		// Заполнить параметры реестра по ини, если ини есть
		ЗначениеИниТекущегоРеестра	= ИниПоПараметрам(ИмяИниРеестра);
		МодульФункций				= ПолучитьЗначениеПараметраТекущегоСеанса("ФункцииДокументов");
		НеЗапускатьВДокументооборот	= МодульФункций.РассчитатьЗначение("НеЗапускатьВДокументооборот",	ЗначениеИниТекущегоРеестра);
		КаталогОбмена				= МодульФункций.РассчитатьЗначение("КаталогОбмена",					ЗначениеИниТекущегоРеестра);
		НазваниеРаздела				= МодульФункций.РассчитатьЗначение("Реестр1С_Название",				ЗначениеИниТекущегоРеестра);
		
		Если Не КаталогОбмена = Неопределено Тогда
			
			// Если указан каталог обмена, то в отправке для поиска операций выставляем его
			КаталогОбмена = МодульФункций.СбисФорматКаталога(КаталогОбмена, ГлобальныйКэш.ПараметрыСистемы.Клиент);
			СтруктураГО.ОписаниеРаздела.Параметры.Вставить("ИмяМодуляИнтеграции",	"ИнтеграцияКаталог");
			СтруктураГО.ОписаниеРаздела.Параметры.Вставить("КаталогОбмена",			КаталогОбмена);
			
		КонецЕсли;
		
		Если Не НеЗапускатьВДокументооборот = Неопределено Тогда
			
			СтруктураГО.ОписаниеРаздела.Параметры.Вставить("НеЗапускатьВДокументооборот", НеЗапускатьВДокументооборот);
		
		КонецЕсли;
		
	Иначе
		
		НазваниеРаздела = СтруктураГО.ОписаниеРаздела.Имя;
		
	КонецЕсли;
		
	Если Не ДопПараметрыРаздела = Неопределено Тогда
		
		Для Каждого  ПараметрРаздела Из ДопПараметрыРаздела Цикл
			
			СтруктураГО.ПараметрыРаздела.Вставить(ПараметрРаздела.Ключ, ПараметрРаздела.Значение);
			
		КонецЦикла;
		
	КонецЕсли;
	
	РазделГО_Вставить(СтруктураГО, "ПредыдущийРаздел",		ПредыдущийРаздел);
	РазделГО_Вставить(СтруктураГО, "РодительскийРаздел",	РодительскийРаздел);
	
	ОписаниеРаздела = РазделГО_Получить(СтруктураГО, "ОписаниеРаздела");
	
	ОписаниеРаздела.ТипАккордеона	= ТипАккордеона;
	ОписаниеРаздела.Название		= НазваниеРаздела;
	
	РазделГО_УстановитьМодули(СтруктураГО);

	// Совместимость для ВФК. НЕ УДАЛЯТЬ!
	СтруктураГО.Раздел = СтруктураГО.ОписаниеРаздела.Номер;
	
	СтруктураГО.Фильтр = РазделГО_Получить(СтруктураГО, "ТекущийФильтр");
	РазделГО_ПроверитьФильтр(СтруктураГО);
		
	Возврат СтруктураГО;
	
КонецФункции

// v8unpack &НаКлиенте
Функция НовыйРазделГО_ПоИмениИни(ИмяКнопкиРаздела, ИмяРеестра)
	Перем Раздел, ТекущийРаздел;
	
	//Если кнопка не передана, то может быть передана имя ини файла раздела. Попробуем найти по реестрам.
	Для Каждого КлючИЗначение Из ГлавноеОкно.Кэш.Разделы Цикл
		
		Если	Не	(	КлючИЗначение.Ключ = "Покупка"
					Или	КлючИЗначение.Ключ = "Продажа"
					Или	КлючИЗначение.Ключ = "Справочники") Тогда
					
			Продолжить;
			
		КонецЕсли;
		
		Для Каждого КлючИЗначениеПодРаздел Из КлючИЗначение.Значение Цикл
			
			Если ИмяРеестра = КлючИЗначениеПодРаздел.Значение Тогда
				
				ИмяКнопкиРаздела = КлючИЗначениеПодРаздел.Ключ;
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не ИмяКнопкиРаздела = Неопределено Тогда
			
			Прервать;
			
		КонецЕсли;
	КонецЦикла;
	
	Если ИмяКнопкиРаздела = Неопределено Тогда
		
		Если ИмяРеестра = "" Тогда
			
			// Для автоопределения создадим вирутальный раздел, без указания ини
			ИмяНадРаздела = "Продажа";
			Раздел				= _РазделГО_НазваниеНомерРазделаПоСоответствию(ИмяНадРаздела);
			ТекущийРаздел		= Раздел;
			
		Иначе
			
			// Имя кнопки не найдено, это может быть ини без реестра.
			ОбщиеФункции		= ПолучитьЗначениеПараметраТекущегоСеанса("ОбщиеФункции");
			ЗначениеИни			= ИниПоПараметрам(ИмяРеестра);
			ИмяНадРаздела		= ОбщиеФункции.РассчитатьЗначение("ДокументРаздел", ЗначениеИни);
			Раздел				= _РазделГО_НазваниеНомерРазделаПоСоответствию(ИмяНадРаздела);
			ТекущийРаздел		= Раздел;
			
		КонецЕсли;
		
		// Виртуальный, 99 раздел. Надеюсь, столько кнопок в аккордеоне никогда не будет
		ИмяКнопкиРаздела	= "Аккордеон" + ИмяНадРаздела + "Док99" + Раздел + ТекущийРаздел;
		
	КонецЕсли;
	
	Возврат НовыйРазделГО_ПоДанным(ИмяКнопкиРаздела, Раздел, ТекущийРаздел, ИмяРеестра);

КонецФункции

// v8unpack &НаКлиенте
Функция НовыйРазделГО_ПоДанным(КнопкаРаздела = Неопределено, ДанныеРаздел = Неопределено, НомерТекущегоРаздела = Неопределено, ИниРаздела = Неопределено)
	
	Если ЭтоТипСбис(КнопкаРаздела, "РазделГО") Тогда
		
		РазделГО = НовыйРазделГО_ПоДанным(КнопкаРаздела.Имя, КнопкаРаздела.Раздел, КнопкаРаздела.ТекущийРаздел, КнопкаРаздела.ТипДок);
		РазделГО.ОписаниеРаздела.Название	= КнопкаРаздела.ОписаниеРаздела.Название;
		РазделГО.Фильтр						= КнопкаРаздела.Фильтр;
		Возврат РазделГО;
		
	Иначе
		
		ИмяКнопкиРаздела = КнопкаРаздела;
		
	КонецЕсли;
	
	РазделГО = _РазделГО_Пустой();
	
	// ПредыдущийРаздел - РазделГО - для отслеживания вложенности разделов. При не удачном переходе, возвращаемся по пути обратно
	// Имя				- Имя кнопки, по которой попали сюда
	// Раздел			- номер раздела из структуры разделов
	// ТипДок			- Тип для реестров СБИС
	// ИниРаздела		- Имя ини для реестра, если есть
	
	РазделГО.Вставить("ОписаниеРаздела", Новый Структура("Параметры, Номер, Имя, Ини, Название, ТипАккордеона", Новый Структура)); 
	
	РазделГО.ПараметрыРаздела	= Новый Структура;
	РазделГО.ПараметрыФильтра	= Новый Структура;
	
	идРаздел = Прав(ИмяКнопкиРаздела, 2);

	// Имя кнопки
	Если ИмяКнопкиРаздела = Неопределено Тогда
	
		РазделГО.Имя = "";
		
	Иначе
		
		РазделГО.Имя = ИмяКнопкиРаздела;
		
	КонецЕсли;
	
	// Номер раздела из РазделГО
	Если ДанныеРаздел = Неопределено Тогда
	
		РазделГО.ОписаниеРаздела.Номер = Прав(идРаздел, 1);
		
	ИначеЕсли ТипЗнч(ДанныеРаздел) = Тип("Структура") Тогда
		
		РазделГО.ОписаниеРаздела = ДанныеРаздел;
		
	Иначе
		
		РазделГО.ОписаниеРаздела.Номер = ДанныеРаздел;
		
	КонецЕсли;
	
	// Номер текущего раздела
	Если НомерТекущегоРаздела = Неопределено Тогда
	
		РазделГО.ТекущийРаздел = Лев(идРаздел, 1);
		
	Иначе
		
		РазделГО.ТекущийРаздел = НомерТекущегоРаздела;
		
	КонецЕсли;
	
	// Имя ини
	Если ИниРаздела = Неопределено Тогда
	
		РазделГО.ОписаниеРаздела.Ини = "";
		
	Иначе
		
		РазделГО.ОписаниеРаздела.Ини = ИниРаздела;
		
	КонецЕсли;

	РазделГО.ОписаниеРаздела.Имя	= _РазделГО_НазваниеНомерРазделаПоСоответствию(РазделГО.ОписаниеРаздела.Номер);
	РазделГО.ТипДок					= Сред(ИмяКнопкиРаздела, 10, СтрДлина(ИмяКнопкиРаздела) - 11);

	Возврат РазделГО;
	
КонецФункции

// v8unpack #КонецОбласти

// v8unpack #Область include_core2_vo2_Модуль_МодульОбъектаКлиент_Классы_СтруктураРаздела_public

// v8unpack &НаКлиенте
Процедура РазделГО_Вставить(РазделГО, КлючЗначенияВставить, ЗначениеВставить) Экспорт 

	Если КлючЗначенияВставить = "ПредыдущийРаздел" Тогда
		
		Если Не ЭтоТипСбис(ЗначениеВставить, "РазделГО") Тогда
			
			Возврат;
			
		КонецЕсли;
		
		ЗначениеВставить.ПредыдущийРаздел	= Неопределено;
		РазделГО.ПредыдущийРаздел = НовыйРазделГО_ПоДанным(ЗначениеВставить);
		// Сохранить некоторые параметры
		РазделГО.ПредыдущийРаздел.ПараметрыФильтра = ЗначениеВставить.ПараметрыФильтра;
		РазделГО_УстановитьМодули(РазделГО.ПредыдущийРаздел);
		
	Иначе
		
		РазделГО[КлючЗначенияВставить] = ЗначениеВставить;
		
	КонецЕсли;
	
КонецПроцедуры

// v8unpack &НаКлиенте
Функция РазделГО_Получить(РазделГО, КлючЗначенияПолучить, ДопПараметры = Неопределено) Экспорт 
	Перем ПараметрПоиск;
	
	Если КлючЗначенияПолучить = "Название" Тогда
		
		Возврат РазделГО.ОписаниеРаздела.Имя;
		
	ИначеЕсли КлючЗначенияПолучить = "Тип" Тогда
		
		Возврат РазделГО.ТипДок;
		
	ИначеЕсли КлючЗначенияПолучить = "ИмяИни" Тогда
		
		Если		ЗначениеЗаполнено(РазделГО.ОписаниеРаздела.Ини)
			Или	Не	ЗначениеЗаполнено(РазделГО.Имя) Тогда
			
			Возврат РазделГО.ОписаниеРаздела.Ини;
			
		КонецЕсли;
		
		Для Каждого КлючИЗначение Из ПолучитьЗначениеПараметраТекущегоСеанса("СтруктураРазделов") Цикл
			
			Если	Не	(	КлючИЗначение.Ключ = "Покупка"
						Или	КлючИЗначение.Ключ = "Продажа"
						Или	КлючИЗначение.Ключ = "Справочники") Тогда
						
				Продолжить;
				
			КонецЕсли;
			
			Если КлючИЗначение.Значение.Свойство(РазделГО.Имя, ПараметрПоиск) Тогда
				
				Прервать;
				
			КонецЕсли;

		КонецЦикла;
		
		РазделГО.ОписаниеРаздела.Ини = ПараметрПоиск;

		Возврат РазделГО.ОписаниеРаздела.Ини;
		
	ИначеЕсли КлючЗначенияПолучить = "ТекущийФильтр" Тогда
		
		Возврат РазделГО_ТекущийФильтр(РазделГО, ДопПараметры);

	ИначеЕсли КлючЗначенияПолучить = "ПустойФильтр" Тогда
	
		// Сделать фильтр по-умолчанию.
		ФрмФильтр = НайтиФункциюСеансаОбработки("ЗначенияДляФильтрПоУмолчанию", РазделГО.ОписаниеРаздела.ФормыРаздела);
		
		Если ФрмФильтр = Ложь Тогда
			
			ФрмФильтр = ПолучитьФормуОбработки("ФормаУстановкиФильтра");
			
		КонецЕсли;
		
		ПустойФильтр = ФрмФильтр.ЗначенияДляФильтрПоУмолчанию(РазделГО, ДопПараметры);
		Возврат ПустойФильтр;

	ИначеЕсли КлючЗначенияПолучить = "ПредставлениеФильтра" Тогда
		
		Попытка
			
			Возврат РазделГО_СтруктураФильтра_Представление(РазделГО, ДопПараметры);
			
		Исключение
			
			Возврат ""
			
		КонецПопытки;
		
	ИначеЕсли КлючЗначенияПолучить = "ПользовательскиеЗначенияФильтра" Тогда
		
		Возврат РазделГО_СтруктураФильтра_ПользовательскиеФильтры(РазделГО);

	Иначе	
		
		Возврат РазделГО[КлючЗначенияПолучить];
		
	КонецЕсли;
	
КонецФункции

// v8unpack &НаКлиенте
Процедура РазделГО_Подготовить(РазделГО) Экспорт 

	Кэш = ПолучитьТекущийЛокальныйКэш();
	РазделГО.Форма.НаСменуРаздела(Кэш);
	РазделГО.Форма.НастроитьКолонки(Кэш);
	РазделГО.Форма.НавигацияУстановитьПанель(Кэш);

КонецПроцедуры

// Функция - проверка заполненности класса
//
// Параметры:
//  РазделГО	 - РазделГО	 - 
// 
// Возвращаемое значение:
//  Булево - пустой (есть возможность перехода) ли раздел, или нет
//
// v8unpack &НаКлиенте
Функция РазделГО_Пустой(РазделГО) Экспорт 
	
	Возврат Не	ЗначениеЗаполнено(РазделГО)
		Или	Не	ЗначениеЗаполнено(РазделГО.Имя)
		Или		РазделГО.Форма = Ложь;
	
КонецФункции

// Процедура - сохраняет установленный на разделе фильтр
//
// Параметры:
//  РазделГО	 - РазделГО	 - Структура раздела главного окна
//  ДопПараметры		 - 	 - 
// 
// Возвращаемое значение:
//   - 
//
// v8unpack &НаКлиенте
Процедура РазделГО_СохранитьФильтр(РазделГО, ДопПараметры = Неопределено) Экспорт 
	Перем ЗначениеДляФильтрОбновить;
	
	Если РазделГО_Пустой(РазделГО) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	СохраненныеФильтры	= ПолучитьЗначениеПараметраСбис("ФильтрыПоРазделам");
	КлючФильтраРаздел	= РазделГО.ОписаниеРаздела.Имя;
	Если РазделГО.ОписаниеРаздела.Ини = Неопределено Тогда
		
		КлючФильтраПодраздел	= КлючФильтраРаздел + "_" + РазделГО.ТипДок;
		
	Иначе
		
		КлючФильтраПодраздел	= КлючФильтраРаздел + "_" + РазделГО.ОписаниеРаздела.Ини;
		
	КонецЕсли;
	
	Если	Не СохраненныеФильтры.Свойство(КлючФильтраПодраздел,	ЗначениеДляФильтрОбновить)
		И	Не СохраненныеФильтры.Свойство(КлючФильтраРаздел,		ЗначениеДляФильтрОбновить) Тогда
		
		ЗначениеДляФильтрОбновить = Новый Структура;
		СохраненныеФильтры.Вставить(КлючФильтраРаздел, ЗначениеДляФильтрОбновить);
		
	КонецЕсли;
	
	// Объединить фильтры. Переделать на ОбъединитьОбъектыУниверсальныхКоллекций
	Для Каждого КлючИЗначениеФильтра Из РазделГО.Фильтр Цикл
		
		Если КлючИЗначениеФильтра.Ключ = "ПараметрыФильтра" Тогда
			
			Если Не ЗначениеДляФильтрОбновить.Свойство("ПараметрыФильтра") Тогда
				
				ЗначениеДляФильтрОбновить.Вставить("ПараметрыФильтра", Новый Структура);
				
			КонецЕсли;
			
			Для Каждого КлючИЗначениеФильтраДоп Из КлючИЗначениеФильтра.Значение Цикл
				
				ЗначениеДляФильтрОбновить.ПараметрыФильтра.Вставить(КлючИЗначениеФильтраДоп.Ключ, КлючИЗначениеФильтраДоп.Значение);
				
			КонецЦикла;	
			
		Иначе
			
			ЗначениеДляФильтрОбновить.Вставить(КлючИЗначениеФильтра.Ключ, КлючИЗначениеФильтра.Значение);
			
		КонецЕсли;
		
	КонецЦикла;
	
	РазделГО_ПроверитьФильтр(РазделГО);
	
	ИзменитьПараметрСбис("ФильтрыПоРазделам", СохраненныеФильтры);
	
КонецПроцедуры

// Процедура - применяет установленный на разделе фильтр
//
// Параметры:
//  РазделГО	 - РазделГО	 - Структура раздела главного окна
//  ДопПараметры - Структура/Неопределено	 - расширение
// 
// v8unpack &НаКлиенте
Процедура РазделГО_ПрименитьФильтр(РазделГО, ДопПараметры = Неопределено) Экспорт 
	Перем ОбластьПрименения;
	
	СтруктураФильтра = РазделГО.Фильтр;
	Если СтруктураФильтра = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если		ДопПараметры = Неопределено
		Или	Не	ДопПараметры.Свойство("ОбъектПрименения", ОбластьПрименения) Тогда
		
		ОбластьПрименения = ГлавноеОкно;
		
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(ОбластьПрименения, СтруктураФильтра);
	
	//Заполним дополнительные параметры фильтра
	Если СтруктураФильтра.Свойство("ПараметрыФильтра") Тогда
		
		Кэш = ПолучитьТекущийЛокальныйКэш();
		Для Каждого Элемент Из СтруктураФильтра.ПараметрыФильтра Цикл
			
			Кэш.ПараметрыФильтра.Вставить(Элемент.Ключ, Элемент.Значение);
			
			#Если ТолстыйКлиентОбычноеПриложение Тогда
				
				// Для ОФ заполнить добавленные элементы формы
				ЭлементПриемникаФильтра = ПолучитьЭлементФормыОбработки(ОбластьПрименения, Элемент.Ключ);
				Если		ЭлементПриемникаФильтра = Неопределено
					Или	Не	МодульОбъектаКлиент().ЭлементМеняетДанные(ЭлементПриемникаФильтра) Тогда
					
					Продолжить;
					
				КонецЕсли;
				
				ЭлементПриемникаФильтра.Значение = Элемент.Значение; 
				
			#КонецЕсли
			
		КонецЦикла;
		
		
	КонецЕсли;
	
	ИзменитьПараметрСбис("ПараметрыФильтра", СтруктураФильтра);
	
КонецПроцедуры

// Процедура - вызывает обработчики для фильтра
//
// Параметры:
//  РазделГО	 - СтрукутраРазделаГО	 - структура с описанием раздела
//  СтруктураФильтра	 - Структура			 - обрабатываемый фильтр. Не берётся от класса для возможности обработки и заполнения нового фильтра
//
// v8unpack &НаКлиенте
Процедура РазделГО_ОбработчикиФильтра(РазделГО, СтруктураФильтра) Экспорт

	Кэш				= ПолучитьТекущийЛокальныйКэш(); 
	МодульТекущий	= МодульОбъектаКлиент();
	ИниКонфигурация	= МодульТекущий.ИниПоПараметрам("Конфигурация");// Пока прямое обращение к ини конфигурации.
	
	ПользовательскиеФильтры = РазделГО_Получить(РазделГО, "ПользовательскиеЗначенияФильтра");
	Если Не ПользовательскиеФильтры = Неопределено Тогда
		
		СтруктураФильтра.Вставить("ПараметрыФильтра", ПользовательскиеФильтры);
		
	КонецЕсли;
	
	// Поддержка костылей с фильтрами по-умолчанию
	Если	ИниКонфигурация.Свойство("ФильтрПоУмолчанию")
		И	ИниКонфигурация.ФильтрПоУмолчанию.Свойство(РазделГО.ТипДок) Тогда 
				
		Попытка
			
			Ини = Кэш.ОбщиеФункции.ПолучитьДанныеДокумента1С(ИниКонфигурация[РазделГО.ТипДок], Неопределено, Кэш.КэшЗначенийИни, Кэш.Парам);
			Для Каждого Элем Из Ини Цикл 
				
				Если НРег(Лев(Элем.Ключ, 6)) = "фильтр" Тогда
					
					СтруктураФильтра.Вставить(Элем.Ключ, Элем.Значение);
					
				КонецЕсли;
				
			КонецЦикла;
			
		Исключение
			
			ОшибкаОбработкиФильтра = НовыйСбисИсключение(ИнформацияОбОшибке(), "ОбщиеФункции.ПолучитьДанныеДокумента1С");
			СбисСообщить(ОшибкаОбработкиФильтра);
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

// Функция - обновляет установленный на разделе фильтр по переданным данным
//
// Параметры:
//  РазделГО		 - РазделГО	 - Структура раздела главного окна
//	ЗначениеФильтраОбновить	 - Произвольный			 - Источник дял обновления фильтра
//  ДопПараметры			 - Неопределено			 - расширение
// 
// Возвращаемое значение:
//   - 
//
// v8unpack &НаКлиенте
Процедура РазделГО_ОбновитьФильтр(РазделГО, ЗначениеФильтраОбновить, ДопПараметры = Неопределено) Экспорт 
 	Перем ДопПараметрыФильтра;

	Если ЗначениеФильтраОбновить = Неопределено Тогда
		
		Возврат;
		
	#Если ТолстыйКлиентОбычноеПриложение Тогда
	
	ИначеЕсли ТипЗнч(ЗначениеФильтраОбновить) = Тип("Форма") Тогда
		
		ДопПараметрыФильтра = РазделГО_ДополнительныеПоляФильтра(РазделГО, ЗначениеФильтраОбновить);
		
	#Иначе
		
	ИначеЕсли ТипЗнч(ЗначениеФильтраОбновить) = Тип("УправляемаяФорма") Тогда
		
		ДопПараметрыФильтра = РазделГО_ДополнительныеПоляФильтра(РазделГО, ЗначениеФильтраОбновить);
		
	#КонецЕсли

	КонецЕсли;

	Если ДопПараметрыФильтра = Неопределено Тогда
		
		РазделГО.Фильтр.Удалить("ПараметрыФильтра");
		
	Иначе
		
		РазделГО.Фильтр.Вставить("ПараметрыФильтра", ДопПараметрыФильтра); 
	
	КонецЕсли;

	// Заполнить поля фильтра по входящим данным
	ЗаполнитьЗначенияСвойств(РазделГО.Фильтр, ЗначениеФильтраОбновить);	
	
КонецПроцедуры

// Функция - Возвращает набор команд текущего раздела
//
// Параметры:
//  РазделГО	 - Структура	 - Объект класса РазделГО
//  ДопПараметры - Структура, Неопределено	 - На всякий случай
// 
// Возвращаемое значение:
//  Массив - Массив с Пользовательскими действиями
//
// v8unpack &НаКлиенте
Функция РазделГО_НаборКоманд(РазделГО, ДопПараметры = Неопределено) Экспорт

	ОписаниеРаздела = РазделГО_Получить(РазделГО, "ОписаниеРаздела");
	
	МодульСпискаДействий = НайтиФункциюСеансаОбработки("СписокПользовательскихДействийРаздела", ОписаниеРаздела.ФормыРаздела);
	СписокПользовательскихДействий = МодульСпискаДействий.СписокПользовательскихДействийРаздела(РазделГО);
	
	МассивПользовательскихДействий = Новый Массив;
	
	Для каждого ОписаниеДействия Из СписокПользовательскихДействий Цикл
	
		Действие = НовыйПользовательскоеДействие(РазделГО);
		Действие.Идентификатор = ОписаниеДействия.Значение;
		Действие.Представление = ОписаниеДействия.Представление;
		МассивПользовательскихДействий.Добавить(Действие);
	
	КонецЦикла;
	
	Возврат МассивПользовательскихДействий;

КонецФункции

// v8unpack #КонецОбласти
	
// v8unpack #Область include_core2_vo2_Модуль_МодульОбъектаКлиент_Классы_СтруктураРаздела_private

// v8unpack &НаКлиенте
Функция РазделГО_ДополнительныеПоляФильтра(РазделГО, ИсточникДанных)
	
	Если РазделГО.ФормаПользовательскогоФильтра = Ложь Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
		
	Попытка
		
		// Есть ли пользовательские параметры фильтра, которые так же надо обновить
		// Берется от раздела, а переданная форма выступает исключительно как источик данных
		СписокДопПараметрыФильтра = РазделГО.ФормаПользовательскогоФильтра.сбисСписокДопПараметровФильтра();
		
	Исключение
		
		СписокДопПараметрыФильтра = Неопределено; 
		
		Возврат Неопределено;
		
	КонецПопытки;
	
	ДопПараметрыФильтра = Новый Структура;
	Для Каждого ДопПараметрФильтра Из СписокДопПараметрыФильтра Цикл 
		
		ЗначениеФильтра = "";
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			
			ЭлементФильтра = ПолучитьЭлементФормыОбработки(ИсточникДанных, ДопПараметрФильтра.Значение);
			Если ЭлементФильтра = Неопределено Тогда
				
				// Элемент не преносился и форма фильтра открывается как сама по себе, а не панель
				ЭлементФильтра = ПолучитьЭлементФормыОбработки(РазделГО.ФормаПользовательскогоФильтра, ДопПараметрФильтра.Значение);
				
			КонецЕсли;
			
			ЗначениеФильтра = ЭлементФильтра.Значение;
			
		#Иначе
			
			ЗначениеФильтра = ИсточникДанных[ДопПараметрФильтра.Значение];
			
		#КонецЕсли
		
		ДопПараметрыФильтра.Вставить(ДопПараметрФильтра.Значение, ЗначениеФильтра);
		
	КонецЦикла;
	
	Возврат ДопПараметрыФильтра;
	
КонецФункции
	
// Функция - восстанавливает текущий фильтр раздела, с учетом сохраненных параметров
//
// Параметры:
//  РазделГО	 - РазделГО	 - 
// 
// Возвращаемое значение:
//   - 
//
// v8unpack &НаКлиенте
Функция РазделГО_ТекущийФильтр(РазделГО, ДополнительныйФильтр = Неопределено)
	Перем ФильтрРезультат;
	
	Если Не ЗначениеЗаполнено(РазделГО.ОписаниеРаздела.Имя) Тогда 
		
		Возврат ФильтрРезультат;
		
	КонецЕсли;
	
	СохраненныеФильтры	= ПолучитьЗначениеПараметраСбис("ФильтрыПоРазделам");
	КлючФильтраРаздел	= РазделГО.ОписаниеРаздела.Имя;
	Если РазделГО.ОписаниеРаздела.Ини = Неопределено Тогда
		
		КлючФильтраПодраздел	= КлючФильтраРаздел + "_" + РазделГО.ТипДок;
		
	Иначе
		
		КлючФильтраПодраздел	= КлючФильтраРаздел + "_" + РазделГО.ОписаниеРаздела.Ини;
		
	КонецЕсли;	
	
	Если	Не	СохраненныеФильтры.Свойство(КлючФильтраПодраздел,	ФильтрРезультат)
		И	Не	СохраненныеФильтры.Свойство(КлючФильтраРаздел,		ФильтрРезультат)
		Или	Не	ЗначениеЗаполнено(ФильтрРезультат) Тогда
		
		ФильтрРезультат = РазделГО_Получить(РазделГО, "ПустойФильтр");
		
	Иначе
		
		ФильтрРезультат			= СоздатьКопиюОбъекта(ФильтрРезультат);
		ПользовательскиеФильтры	= РазделГО_Получить(РазделГО, "ПользовательскиеЗначенияФильтра"); 
		Если Не ПользовательскиеФильтры = Неопределено Тогда
			
			Если	ФильтрРезультат.Свойство("ПараметрыФильтра")
				И	ЗначениеЗаполнено(ФильтрРезультат.ПараметрыФильтра) Тогда
				
				ЗаполнитьЗначенияСвойств(ПользовательскиеФильтры, ФильтрРезультат.ПараметрыФильтра);
				ФильтрРезультат.ПараметрыФильтра = ПользовательскиеФильтры;
				
			Иначе
				
				ФильтрРезультат.Вставить("ПараметрыФильтра", ПользовательскиеФильтры);
				
			КонецЕсли;
			
		КонецЕсли;

		// Обновить даты для фильтров за периоды.
		ФрмФильтр			= ПолучитьФормуОбработки("ФормаУстановкиФильтра");
		ПараметрыДляФильтра	= ФрмФильтр.ЗначенияДляФильтрПериод(ФильтрРезультат);
		ЗаполнитьЗначенияСвойств(ФильтрРезультат, ПараметрыДляФильтра);
			
	КонецЕсли;
	
	Возврат ФильтрРезультат;
	
КонецФункции

// Функция - формирует представление фильтра для панели
//
// Параметры:
//  РазделГО	 - РазделГО	 - Структура
//  ДополнительныйФильтр - 	 - 
// 
// Возвращаемое значение:
//   - 
//
// v8unpack &НаКлиенте
Функция РазделГО_СтруктураФильтра_Представление(РазделГО, ДопПараметры = Неопределено)
	Перем ФильтрРезультат, ЗначениеПроверка, ФильтрДанные;

	Если Не ДопПараметры = Неопределено Тогда
		
		ДопПараметры.Свойство("Фильтр", ФильтрДанные);
		
	КонецЕсли;
	
	Если ФильтрДанные = Неопределено Тогда
		
		Если РазделГО.Фильтр = Неопределено Тогда

			Возврат "";
			
		КонецЕсли;
		ФильтрДанные = РазделГО.Фильтр;
		
	КонецЕсли;
	
	Если Не ФильтрДанные.Свойство("ФильтрПериод", ЗначениеПроверка)
		Или	ЗначениеПроверка = Неопределено
		Или	ЗначениеПроверка = "За весь период" Тогда
		
		// Нет периода, или не указываем
		ФильтрРезультат	= "";
		
	ИначеЕсли ЗначениеПроверка = "За период" Тогда
		
		// Сюда код который делает строку как онлайне
		ФильтрРезультат = _РазделГО_ФильтрПериодПрописью(ФильтрДанные.ФильтрДатаНач, ФильтрДанные.ФильтрДатаКнц);
		
	Иначе
		
		ФильтрРезультат = ЗначениеПроверка;
		
	КонецЕсли;
	
	Если	ФильтрДанные.Свойство("ФильтрТипыДокументов", ЗначениеПроверка)
		И	ЗначениеЗаполнено(ЗначениеПроверка)
		И 	(	РазделГО.ТипДок = "Отправленные"
			Или РазделГО.ТипДок = "Полученные") тогда 
			
		// Фильтр заполнен и в этом разделе будет действовать
		СписокТипДок = "";
		Для Каждого ТипДок Из ЗначениеПроверка Цикл
			
			СписокТипДок = СписокТипДок + ТипДок.Представление + ",";
			
		КонецЦикла;
		ФильтрРезультат = ФильтрРезультат + ", " + Лев(СписокТипДок,СтрДлина(СписокТипДок) - 1);
		
	КонецЕсли; 
	
	НаборПроверки = 
	"ФильтрКонтрагент
	|ФильтрОрганизация
	|ФильтрОтветственный
	|ФильтрКонтрагентПодключен
	|ФильтрМаска";
	
	Для НомерСтроки = 1 По СтрЧислоСтрок(НаборПроверки) Цикл
		
		Если	ФильтрДанные.Свойство(СтрПолучитьСтроку(НаборПроверки, НомерСтроки), ЗначениеПроверка)
			И	ЗначениеЗаполнено(ЗначениеПроверка) Тогда
			
			ФильтрРезультат = ФильтрРезультат + ", " + ЗначениеПроверка;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если	ФильтрДанные.Свойство("ФильтрСостояние", ЗначениеПроверка)
		И	Не ЗначениеПроверка = "Все документы" Тогда
		
		ФильтрРезультат = ФильтрРезультат + ", " + ЗначениеПроверка;
		
	КонецЕсли;
	
	//Добавим дополнительные параметры фильтра для текущего раздела
	Если Не ЗначениеЗаполнено(РазделГО.ОписаниеРаздела.Номер) Тогда
		
		Возврат ФильтрРезультат;
		
	КонецЕсли;
	
	ФормаДопФильтра	= РазделГО.ФормаПользовательскогоФильтра;
    Кэш				= ПолучитьТекущийЛокальныйКэш();
	
	Если Не ФормаДопФильтра = Ложь
		И	ФильтрДанные.Свойство("ПараметрыФильтра", ЗначениеПроверка) Тогда
		
		СписокДопЭлементов = ФормаДопФильтра.сбисСписокДопПараметровФильтра();
		Для Каждого Элемент Из СписокДопЭлементов Цикл
			
			Если	ЗначениеПроверка.Свойство(Элемент.Значение)
				И	ЗначениеЗаполнено(ЗначениеПроверка[Элемент.Значение]) Тогда
				
				ФильтрРезультат = ФильтрРезультат + ", " + Строка(ЗначениеПроверка[Элемент.Значение]);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Лев(ФильтрРезультат, 2) = ", " Тогда
		
		ФильтрРезультат = Сред(ФильтрРезультат, 3);
		
	КонецЕсли;
	
	// Отборов нет вообще, значит представление - Все документы
	Если ФильтрРезультат = "" Тогда
		
		ФильтрРезультат = "Все";
		
	КонецЕсли;
	
	Возврат ФильтрРезультат;

КонецФункции

// v8unpack &НаКлиенте
Функция РазделГО_СтруктураФильтра_ПользовательскиеФильтры(РазделГО, ДопПараметры = Неопределено)
	Перем СписокДопФильтров;
	
	Если Не РазделГО.ОписаниеРаздела.Свойство("ПользовательскиеПоляФильтра", СписокДопФильтров) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли;
	
	ФормаДопФильтра		= РазделГО.ФормаПользовательскогоФильтра;
	ДопПоляФильтра		= Новый Структура;
	Для Каждого ДопПоле Из СписокДопФильтров Цикл
		
		Попытка
			
			ДопПоле_Значение = _РазделГО_ЗначениеПользовательскогоФильтраПоУмолчанию(ФормаДопФильтра, ДопПоле);
			ДопПоляФильтра.Вставить(ДопПоле, ДопПоле_Значение);
			
		Исключение
				
			ОшибкаОбработкиФильтра = НовыйСбисИсключение(ИнформацияОбОшибке(), "ОбщиеФункции.РазделГО_СтруктураФильтра_ПользовательскиеФильтры");
			СбисСообщить(ОшибкаОбработкиФильтра);
				
		КонецПопытки;
 		
	КонецЦикла;
	
	Возврат ДопПоляФильтра;
		
КонецФункции

// v8unpack &НаКлиенте
Процедура РазделГО_УстановитьМодули(РазделГО) 

	Если НЕ ЗначениеЗаполнено(РазделГО.ОписаниеРаздела.Имя) Тогда
		
		РазделГО.Вставить("Форма", Ложь);
		Возврат;
		
	КонецЕсли;
		
	РодительскийГО = РазделГО_Получить(РазделГО, "РодительскийРаздел");
	
	РазделГО.ОписаниеРаздела.Вставить("ФормыРаздела", Новый Массив);
	РазделГО.ОписаниеРаздела.Вставить("ФормыФильтра", Новый Массив);
	
	Если ЗначениеЗаполнено(РодительскийГО) Тогда
		
		Для каждого ФормаРаздела Из РодительскийГО.ОписаниеРаздела.ФормыРаздела Цикл
		
			РазделГО.ОписаниеРаздела.ФормыРаздела.Добавить(ФормаРаздела);
		
		КонецЦикла;
		
		Для каждого ФормаФильтра Из РодительскийГО.ОписаниеРаздела.ФормыФильтра Цикл
		
			РазделГО.ОписаниеРаздела.ФормыФильтра.Добавить(ФормаФильтра);
		
		КонецЦикла;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(РазделГО.ОписаниеРаздела.Ини) Тогда
		
		ШаблонФормы	= РазделГО.ОписаниеРаздела.Имя + "_" + РазделГО.ОписаниеРаздела.Ини;
		
	Иначе
		
		ШаблонФормы	= РазделГО.ОписаниеРаздела.Имя + "_" + РазделГО.ТипДок;
		
	КонецЕсли;
	
	РазделГО_УстановитьМодуль(РазделГО, ШаблонФормы, 0);
		
	ШаблонФормы	= РазделГО.ОписаниеРаздела.Имя + "_Шаблон";
	
	РазделГО_УстановитьМодуль(РазделГО, ШаблонФормы);
	
	// Костыль для совместимости на всякий случай. Спилить 25.2100
	РазделГО.Вставить("ФормыРаздела", РазделГО.ОписаниеРаздела.ФормыРаздела);
	
	Попытка
		
		фрм = НайтиФункциюСеансаОбработки("ОбновитьКонтент", РазделГО.ОписаниеРаздела.ФормыРаздела);
		
	Исключение
		
		СообщитьСбисИсключение(ИнформацияОбОшибке(), Новый Структура("ИмяКоманды", "МодульОбъектаКлиент.НовыйРазделГО_ПоДанным"));	
		
	КонецПопытки;
	
	Попытка
		
		ФормаДопФильтра	= НайтиФункциюСеансаОбработки("сбисСписокДопПараметровФильтра", РазделГО.ОписаниеРаздела.ФормыФильтра);
		Если Не ФормаДопФильтра = Ложь Тогда 
			
			РазделГО.ОписаниеРаздела.Вставить("ПользовательскиеПоляФильтра", ФормаДопФильтра.сбисСписокДопПараметровФильтра().ВыгрузитьЗначения());
			
		КонецЕсли;
		
	Исключение
		
		СообщитьСбисИсключение(ИнформацияОбОшибке(), Новый Структура("ИмяКоманды", "МодульОбъектаКлиент.НовыйРазделГО_ПоДанным"));	
		
	КонецПопытки;

	РазделГО.Вставить("ФормаПользовательскогоФильтра",	ФормаДопФильтра);
	РазделГО.Вставить("Форма",							фрм);

КонецПроцедуры

// v8unpack &НаКлиенте
Процедура РазделГО_УстановитьМодуль(РазделГО, ШаблонФормы, Позиция = Неопределено)
	
	ШаблонФормыРаздела = "Раздел_"			+ ШаблонФормы;
	ШаблонФормыФильтра = "Фильтр_Раздел_"	+ ШаблонФормы;
	
	Если РазделГО.ОписаниеРаздела.ФормыРаздела.Найти(ШаблонФормыРаздела) = Неопределено
		И Позиция = Неопределено Тогда
		РазделГО.ОписаниеРаздела.ФормыРаздела.Добавить(ШаблонФормыРаздела);
	ИначеЕсли РазделГО.ОписаниеРаздела.ФормыРаздела.Найти(ШаблонФормыРаздела) = Неопределено Тогда
		РазделГО.ОписаниеРаздела.ФормыРаздела.Вставить(Позиция, ШаблонФормыРаздела);
	КонецЕсли;
	
	Если РазделГО.ОписаниеРаздела.ФормыФильтра.Найти(ШаблонФормыФильтра) = Неопределено
		И Позиция = Неопределено Тогда
		РазделГО.ОписаниеРаздела.ФормыФильтра.Добавить(ШаблонФормыФильтра);
	ИначеЕсли РазделГО.ОписаниеРаздела.ФормыФильтра.Найти(ШаблонФормыФильтра) = Неопределено Тогда
		РазделГО.ОписаниеРаздела.ФормыФильтра.Вставить(Позиция, ШаблонФормыФильтра);
	КонецЕсли;

КонецПроцедуры

// v8unpack &НаКлиенте
Процедура РазделГО_ПроверитьФильтр(РазделГО)

	Если РазделГО.Фильтр = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого КлючИЗначениеФильтра Из РазделГО.Фильтр Цикл
		
		Если ТипЗнч(КлючИЗначениеФильтра.Значение) = Тип("Дата")
			И КлючИЗначениеФильтра.Значение > '39991231' Тогда
		
			РазделГО.Фильтр[КлючИЗначениеФильтра.Ключ] = '39991231';
		
		КонецЕсли;
		
	КонецЦикла;

КонецПроцедуры

//Функция формирует период прописью	
// v8unpack &НаКлиенте
Функция _РазделГО_ФильтрПериодПрописью(ДатНач, ДатКнц)
	
	ДатаПроверкаНач = ДатНач;
	ДатаПроверкаКнц = ДатКнц;
	
	Если ТипЗнч(ДатаПроверкаНач) = Тип("Строка") Тогда
		
		ДатаПроверкаНач = '0001.01.01';
		
	КонецЕсли;
	
	Если ТипЗнч(ДатаПроверкаКнц) = Тип("Строка") Тогда
		
		ДатаПроверкаКнц = '0001.01.01';
		
	КонецЕсли;

	Если Не Год(ДатаПроверкаНач) = Год(ДатаПроверкаКнц) Тогда
		
		Возврат Формат(ДатаПроверкаНач, "ДФ=""д ММММ гггг""") + " - " + Формат(ДатаПроверкаКнц, "ДФ=""д ММММ гггг""");
		
	КонецЕсли;
		
	Если Не Месяц(ДатаПроверкаНач) = Месяц(ДатаПроверкаКнц) Тогда
		
		Возврат Формат(ДатаПроверкаНач, "ДФ=""д ММММ""") + " - " + Формат(ДатаПроверкаКнц, "ДФ=""д ММММ""") + " " + Формат(Год(ДатаПроверкаКнц),"ЧГ=0");
		
	КонецЕсли;
		
	Если ДатаПроверкаНач = ДатаПроверкаКнц Тогда
		
		Возврат Формат(ДатаПроверкаКнц, "ДФ=""д ММММ гггг""");
		
	КонецЕсли;
		
	Возврат Строка(День(ДатаПроверкаНач)) + " - " + Формат(ДатаПроверкаКнц, "ДФ=""д ММММ""") + " "+ Формат(Год(ДатаПроверкаКнц), "ЧГ=0");
	
КонецФункции

// v8unpack &НаКлиенте
Функция _РазделГО_ЗначениеПользовательскогоФильтраПоУмолчанию(ФормаДопФильтра, КлючДопФильтра)
	
	Попытка
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
		
			// Получить элемент формы и от него взять значение 
			ДопЭлемент_Элемент = ПолучитьЭлементФормыОбработки(ФормаДопФильтра, КлючДопФильтра);
			Если ДопЭлемент_Элемент = Неопределено Тогда
				
				// Если элемента нет на форме, то он должен быть на ГО, на панели фильтра
				ДопЭлемент_Элемент	= ПолучитьЭлементФормыОбработки(ГлавноеОкно, КлючДопФильтра);
				
			КонецЕсли;	
			
			ДопЭлемент_Тип = ТипЗнч(ДопЭлемент_Элемент);
								
			Если Не	(	ДопЭлемент_Тип = Тип("ПолеВвода")
					Или	ДопЭлемент_Тип = Тип("ПолеВыбора")
					Или	ДопЭлемент_Тип = Тип("Флажок")) Тогда
					
				// Это надпись, картинка или что-то, чего не знаем
				Возврат Неопределено;
				
			КонецЕсли;
				
			ДопЭлемент_Значение = ДопЭлемент_Элемент.Значение;
		
		#Иначе
			
			// Просто взять значение от потльзовательской формы
			ДопЭлемент_Значение = ФормаДопФильтра[КлючДопФильтра];
			
		#КонецЕсли
		
	Исключение
		
		ОшибкаПОдбораЭлемента = НовыйСбисИсключение(ИнформацияОбОшибке(), "МодульОбъектаКлиент._РазделГО_ЗначениеПользовательскогоФильтраПоУмолчанию");
		ВызватьИсключение СбисИсключение_Представление(ОшибкаПОдбораЭлемента);

	КонецПопытки;
	
		
	ДопЭлемент_Значение_Тип	= ТипЗнч(ДопЭлемент_Значение);
	Если		ДопЭлемент_Значение_Тип = Тип("Дата") Тогда
		
		ПараметрФильтра = '0001.01.01';
		
	ИначеЕсли	ДопЭлемент_Значение_Тип = Тип("Число") Тогда
		
		ПараметрФильтра = 0;
		
	ИначеЕсли	ДопЭлемент_Значение_Тип = Тип("Булево") Тогда
		
		ПараметрФильтра = Ложь;
		
	ИначеЕсли	ДопЭлемент_Значение_Тип = Тип("СписокЗначений") Тогда
		
		ПараметрФильтра = Новый СписокЗначений;
		//Ограничение типа тоже перенести.
		ПараметрФильтра.ТипЗначения = ДопЭлемент_Значение.ТипЗначения;
		
	Иначе
		
		ОписаниеТиповСписок = Новый Массив;
		ОписаниеТиповСписок.Добавить(ДопЭлемент_Значение_Тип);
		ОписаниеТипаЭлемент	= Новый ОписаниеТипов(ОписаниеТиповСписок);
		ПараметрФильтра = ОписаниеТипаЭлемент.ПривестиЗначение();
		
	КонецЕсли;
	
	Возврат ПараметрФильтра;

КонецФункции

