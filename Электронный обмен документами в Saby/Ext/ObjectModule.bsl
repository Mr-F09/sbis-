// Заглушки интерфейса регистра Saby_Состояние

Функция СтатусыДокументовПолучитьСостоянияОбъектов(tUID, Регламент = "") Экспорт
	
	Перем Сервис, Аккаунт;
	Если ИнтеграцияСтатусыДокументов = Неопределено Тогда
		СтатусыДокументовИнициализация(, Регламент);
	КонецЕсли;
	Сервис  = ИнтеграцияСтатусыДокументов.Сервис;
	Аккаунт = ИнтеграцияСтатусыДокументов.Аккаунт;
	
	Результат = СтатусыДокументовПоДопСведениямПолучитьСостоянияОбъектов(tUID, Сервис, Аккаунт);
	
	Если Не ЗначениеЗаполнено(Результат) и ИнтеграцияСтатусыДокументов.ИмяРегистраСвойствОбъектов = "Saby_Состояние" Тогда
		Результат = РегистрыСведений["Saby_Состояние"].ПолучитьСостоянияОбъектов(tUID, Сервис, Аккаунт);
	КонецЕсли;
	Возврат Результат;
КонецФункции

