// context_variable_scope_add
//
// Параметры:
//  block_context - Структура - Контекст исполняемого блока
//  params - Стуктара - Дополнительные параметры
//
//DynamicDirective
Процедура context_variable_scope_add(block_context, params)
	Если get_prop(block_context, "_variable_scope") <> Неопределено Тогда
		context.current_variable_scope = block_context["_variable_scope"];
	Иначе
		Если get_prop(context, "multithread_mode", Ложь) = Истина Тогда  
			context.block_context.__thread_vars.Добавить(params);
			context.current_variable_scope = context.variable_scopes.Количество() + context.block_context.__thread_vars.Количество() - 2;	
		Иначе	
			context.variable_scopes.Добавить(params);
			context.current_variable_scope = context.variable_scopes.Количество() - 1;
		КонецЕсли;	
		block_context.Вставить("_variable_scope", context.current_variable_scope);
	КонецЕсли;
КонецПроцедуры

// context_variable_scope_remove
//
// Параметры:
//  block_context - Стуктара - deferred_exception
//
//DynamicDirective
Процедура context_variable_scope_remove(block_context)
	current_variable_scope_thread = 0;
	Если get_prop(context, "multithread_mode", Ложь) = Истина Тогда 
		current_variable_scope_thread = context.current_variable_scope - context.variable_scopes.Количество() + 1;
	КонецЕсли;	
	Если block_context["_variable_scope"] <> context.current_variable_scope 
		Или context.variable_scopes.Количество() + current_variable_scope_thread - 1 <> context.current_variable_scope Тогда
		ВызватьИсключение NewExtExceptionСтрока(,"Ошибка уровня вложенности variable_scope");
	КонецЕсли;
	Если get_prop(context, "multithread_mode", Ложь) = Истина Тогда 
		context.block_context.__thread_vars.Удалить(current_variable_scope_thread);
	Иначе	
		context.variable_scopes.Удалить(context.current_variable_scope);
	КонецЕсли;	
	// ???
	//context.data.variable_scopes.Удалить(context.current_variable_scope);
	context.current_variable_scope = context.current_variable_scope - 1;
	// ???
	//context.variables = context.variable_scopes[context.current_variable_scope];

КонецПроцедуры

