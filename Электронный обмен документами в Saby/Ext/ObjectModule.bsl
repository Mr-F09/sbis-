// v8unpack #Область include_core2_vo2_Модуль_МодульОбъектаКлиент_Отправка_СоставПакета_public

// Процедура проверяет параметры документа в СБИС, вызывает исключение, если документ не может быть обработан 
//
// Параметры:
//  СоставПакета - Структура - обрабатываемый пакет (документ) 
//  ДопПараметры - Структура - Набор полей, работа с которыми может расширить результат работы функции. 
//
// v8unpack &НаКлиенте
Процедура СоставПакета_ПроверитьБлокировкуДействияВСБИС(СоставПакета, ДопПараметры = Неопределено) Экспорт

	Идентификатор = СоставПакета_Получить(СоставПакета, "ИдентификаторСБИС"); 
	
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		
		Возврат;
		
	КонецЕсли;
		
	//Если Не СоставПакета.Свойство("Этап") Тогда
	//	
	//	ТекстОшибки = "Отсустствуют активные этапы";
	//	ПроверкаБлокировки.БлокироватьОтправку	= Истина;
	//	ПроверкаБлокировки.ПричинаБлокировки	= НовыйСбисИсключение(СоставПакета, "МодульОбъектаКлиент.СоставПакета_ПроверитьБлокировкуДействияВСБИС", 710,,ТекстОшибки);
	//  	Возврат ПроверкаБлокировки;

	//КонецЕсли;
	
	СкладскиеПараметры = ПолучитьСкладскиеПараметрыДокумента(СоставПакета, ДопПараметры);  
	
	УказанКонтракт = СкладскиеПараметры.ПоказатьГосконтракт;
	НомерКонтракта = СкладскиеПараметры.ИдентификаторГосконтракта;
	
	Если УказанКонтракт И СтрДлина(СокрЛП(НомерКонтракта)) < 20 Тогда
		
		ВызватьИсключение "Некорректно заполнены обязательные поля: № контракта должен содержать от 20 до 25 символов";

	КонецЕсли;    
	
КонецПроцедуры

// Процедура - Состав пакета добавить
//
// Параметры:
//  СоставПакета	 - СоставПакета	 - струкутра документа СБИС
//  ЗначениеДобавить - Произвольный	 - добавляемое значение
//  ДопПараметры	 - Струкутра	 - расширение
//
// v8unpack &НаКлиенте
Процедура СоставПакета_Добавить(СоставПакета, ЗначениеДобавить, ДопПараметры = Неопределено) Экспорт
	Перем Контекст, ДополнительныеАргументы;
	
	Если ЭтоТипСбис(ЗначениеДобавить, "ВложениеСБИС") Тогда
		
		СоставПакета.Вложение.Добавить(ЗначениеДобавить);
		
		Если Не ДопПараметры = Неопределено
			И	ДопПараметры.Свойство("Контекст", Контекст) Тогда
			
			// Указан контекст для дополнительного расчета при добавлении
			Кэш = ПолучитьТекущийЛокальныйКэш();
			Если Не ДопПараметры.Свойство("ДополнительныеПараметры", ДополнительныеАргументы) Тогда
				
				ДополнительныеАргументы = Новый Структура;
				
			КонецЕсли;
			ГрязныйИниДанные = Контекст.ФайлДанные;
			
			Если 		ГрязныйИниДанные.Свойство("мСвязанноеВложение")
				И		ЗначениеЗаполнено(ГрязныйИниДанные.мСвязанноеВложение)
				И Не	(	ДополнительныеАргументы.Свойство("ОбработкаСвязанногоВложения")
						И	ДополнительныеАргументы.ОбработкаСвязанногоВложения) Тогда
				
				ПараметрыВложения = ВложениеСБИС_Получить(ЗначениеДобавить, "Параметры");
				ДополнительныеАргументы.Вставить("ОсновныеФормыВФК", ПараметрыВложения.НаборМодулейДляФормата);
				
				Файл_ШаблонМодуль = ПолучитьФормуОбработки("Файл_Шаблон");
				Файл_ШаблонМодуль.ПолучитьДанныеИзДокумента1С_мСвязанноеВложение(Кэш, Контекст, ДополнительныеАргументы);
				
			КонецЕсли;
				
			ВложениеСБИС_ПослеФормированияДокумента(ЗначениеДобавить, Контекст);
			ДопПараметры.Контекст = Контекст;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// v8unpack #КонецОбласти

// Процедура - выбрать действие с документов
//
// Параметры:
//  СоставПакета - 	 - 
//  ДопПараметры - 	 - 
//
// v8unpack &НаКлиенте
Процедура СоставПакета_ВыбратьДействиеПоЭтапу(СоставПакета, ДопПараметры) Экспорт
	
	ПараметрыПереходов = Новый Структура("СоставПакета, ВыбранноеДействие", 
										  СоставПакета);
										  
	ПараметрыЗапросаФормы = Новый Структура("ПолучитьНовую, КэшироватьФорму", Истина, Ложь);
	ПоказатьПоверх = Ложь;
	
	Если ДопПараметры.Свойство("Владелец") Тогда										  
		
		ПараметрыЗапросаФормы.Вставить("Владелец", ДопПараметры.Владелец);
		ПоказатьПоверх = Истина;
		
	КонецЕсли;
										  
	ФормаПереходов = ПолучитьФормуОбработки("ФормаПереходы", ПараметрыЗапросаФормы);
	Если ФормаПереходов = Ложь Тогда
		
		ВызватьИсключение "Не удалось получить форму для выполнения перехода!";
		
	КонецЕсли;
	
	ФормаПереходов.ОписаниеОповещенияОЗакрытии = ДопПараметры.ОбработчикРезультат;
	
	Если ПоказатьПоверх Тогда
		
		ФормаПереходов.ПоказатьПоверх(ПараметрыПереходов);
		
	Иначе
		
		ФормаПереходов.Показать(ПараметрыПереходов);
		
	КонецЕсли;

КонецПроцедуры

// v8unpack &НаКлиенте
Функция СоставПакета_СтруктураКонтрагентаДляОтправки(СоставПакета) Экспорт
	
	kontr = Новый Структура; 
	
	КлючИдентификатора = МодульОбъектаКлиент().Сторона_Получить(СоставПакета.Контрагент, "КлючИдентификатора"); 	
	
	//ИД контрагента
	Если	СоставПакета.Контрагент.Свойство("Идентификатор")
		И	ЗначениеЗаполнено(СоставПакета.Контрагент.Идентификатор) Тогда
		kontr.Вставить( "Идентификатор", СоставПакета.Контрагент.Идентификатор);
	Иначе		
		СбисИдентификаторКонтрагента = ПрочитатьДополнительныйПараметрСтороны(СоставПакета.Контрагент, "КодОператораАбонентскогоЯщика");
		
		Если Не СбисИдентификаторКонтрагента = Неопределено Тогда
			//ИД явно не указан, то проверить наличие ИД оператора А/Я
			kontr.Вставить("Идентификатор", СбисИдентификаторКонтрагента);
		Иначе
			СбисИдентификаторКонтрагента = ПрочитатьДополнительныйПараметрСтороны(СоставПакета.Контрагент, "Идентификатор");
			Если Не СбисИдентификаторКонтрагента = Неопределено Тогда
				kontr.Вставить("Идентификатор", СбисИдентификаторКонтрагента);
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	//Контакты
	Если СоставПакета.Контрагент.Свойство("Контакт")  Тогда
		Если СоставПакета.Контрагент.Контакт.Свойство("Телефон")  Тогда
			kontr.Вставить( "Телефон", СоставПакета.Контрагент.Контакт.Телефон );
		КонецЕсли;
		Если СоставПакета.Контрагент.Контакт.Свойство("EMAIL")  Тогда
			kontr.Вставить( "Email", СоставПакета.Контрагент.Контакт.EMAIL );
		КонецЕсли;
	КонецЕсли;
	
	//СвФЛ/СвЮл
	Если СоставПакета.Контрагент.Свойство("СвФЛ") Тогда
		СвФЛ = Новый Структура;
		Если СоставПакета.Контрагент.Свойство("Параметр") Тогда
			Для Каждого Параметр из СоставПакета.Контрагент.Параметр Цикл
				Если Параметр.Имя = "ЧастноеЛицо" Тогда
					СвФЛ.Вставить("ЧастноеЛицо", Параметр.Значение);
				КонецЕсли;
				Если Параметр.Имя = "СНИЛС" Тогда
					СвФЛ.Вставить("СНИЛС", Параметр.Значение);						
				КонецЕсли;     					
			КонецЦикла;
		КонецЕсли;  
		Если СоставПакета.Контрагент.СвФЛ.Свойство("ИНН") Тогда  
			СвФЛ.Вставить( "ИНН", СоставПакета.Контрагент.СвФЛ[КлючИдентификатора] );
		КонецЕсли;
		Если СоставПакета.Контрагент.СвФЛ.Свойство("Фамилия") Тогда
			СвФЛ.Вставить( "Фамилия", СоставПакета.Контрагент.СвФЛ.Фамилия );	
		КонецЕсли;
		Если СоставПакета.Контрагент.СвФЛ.Свойство("Имя") Тогда
			СвФЛ.Вставить( "Имя", СоставПакета.Контрагент.СвФЛ.Имя );	
		КонецЕсли;
		Если СоставПакета.Контрагент.СвФЛ.Свойство("Отчество") Тогда
			СвФЛ.Вставить( "Отчество", СоставПакета.Контрагент.СвФЛ.Отчество );	
		КонецЕсли;
		Если СоставПакета.Контрагент.СвФЛ.Свойство("КодФилиала") и ЗначениеЗаполнено(СоставПакета.Контрагент.СвФЛ.КодФилиала) Тогда
			СвФЛ.Вставить( "КодФилиала", СоставПакета.Контрагент.СвФЛ.КодФилиала );	
		КонецЕсли;
		kontr.Вставить( "СвФЛ", СвФЛ );
		
	ИначеЕсли СоставПакета.Контрагент.Свойство("СвИн") Тогда
		СвИн = Новый Структура;
		СвИн.Вставить( "ИНН", СоставПакета.Контрагент.СвИн[КлючИдентификатора] );  
		Если СоставПакета.Контрагент.СвИн.Свойство("КПП") Тогда
			СвИн.Вставить( "КПП", СоставПакета.Контрагент.СвИн.КПП );
		КонецЕсли;
		Если СоставПакета.Контрагент.СвИн.Свойство("КодСтраны") Тогда
			СвИн.Вставить( "КодСтраны", СоставПакета.Контрагент.СвИн.КодСтраны );	
		КонецЕсли;
		Если СоставПакета.Контрагент.СвИн.Свойство("КодФилиала") и ЗначениеЗаполнено(СоставПакета.Контрагент.СвИн.КодФилиала) Тогда
			СвИн.Вставить( "КодФилиала", СоставПакета.Контрагент.СвИн.КодФилиала );	
		КонецЕсли;
		Если СоставПакета.Контрагент.СвИн.Свойство("Название") Тогда
			СвИн.Вставить( "Название", СоставПакета.Контрагент.СвИн.Название );	
		КонецЕсли;
		kontr.Вставить( "СвЮЛ", СвИн );	
		
	Иначе
		СвЮЛ = Новый Структура;
		СвЮЛ.Вставить( "ИНН", СоставПакета.Контрагент.СвЮЛ[КлючИдентификатора] );  
		Если СоставПакета.Контрагент.СвЮЛ.Свойство("КПП") Тогда
			СвЮЛ.Вставить( "КПП", СоставПакета.Контрагент.СвЮЛ.КПП );
		КонецЕсли;
		Если СоставПакета.Контрагент.СвЮЛ.Свойство("КодСтраны") Тогда
			СвЮЛ.Вставить( "КодСтраны", СоставПакета.Контрагент.СвЮЛ.КодСтраны );	
		КонецЕсли;
		Если СоставПакета.Контрагент.СвЮЛ.Свойство("КодФилиала") и ЗначениеЗаполнено(СоставПакета.Контрагент.СвЮЛ.КодФилиала) Тогда
			СвЮЛ.Вставить( "КодФилиала", СоставПакета.Контрагент.СвЮЛ.КодФилиала );	
		КонецЕсли;
		Если СоставПакета.Контрагент.СвЮЛ.Свойство("Название") Тогда
			СвЮЛ.Вставить( "Название", СоставПакета.Контрагент.СвЮЛ.Название );	
		КонецЕсли;
		kontr.Вставить( "СвЮЛ", СвЮЛ );
	КонецЕсли;
	
	//Подразделение
	Если СоставПакета.Контрагент.Свойство("Подразделение") и СоставПакета.Контрагент.Подразделение.Свойство("Идентификатор") Тогда
		Подразделение = Новый Структура;
		Подразделение.Вставить( "Идентификатор", СоставПакета.Контрагент.Подразделение.Идентификатор); 
		kontr.Вставить( "Подразделение", Подразделение );
	КонецЕсли;	
	Возврат kontr;
	
КонецФункции 

// v8unpack &НаКлиенте
Функция СоставПакета_СтруктураОрганизацииДляОтправки(СоставПакета) Экспорт
	Перем СвФлЮлИсточник, КодФилиалаОрганизации;
	
	СторонаРезультат = Новый Структура;
	
	Если Не СоставПакета.Свойство("НашаОрганизация") Тогда
		
		ВызватьСбисИсключение("Неизвестный формат состава пакета для отправки.", "МодульОбъектаКлиент.СоставПакета_СтруктураОрганизацииДляОтправки");
		
	ИначеЕсли СоставПакета.НашаОрганизация.Свойство("СвФЛ", СвФлЮлИсточник) Тогда
		
		СвФлЮлРезультат = Новый Структура;
		СторонаРезультат.Вставить("СвФЛ", СвФлЮлРезультат);
		
	ИначеЕсли СоставПакета.НашаОрганизация.Свойство("СвЮЛ", СвФлЮлИсточник) Тогда
		
		СвФлЮлРезультат = Новый Структура;
		СторонаРезультат.Вставить("СвЮЛ", СвФлЮлРезультат);
		
		Если СвФлЮлИсточник.Свойство("КПП") Тогда 
			
			СвФлЮлРезультат.Вставить("КПП", СвФлЮлИсточник.КПП);
			
		КонецЕсли;
		
		Если СвФлЮлИсточник.Свойство("КодСтраны") Тогда
			
			СвФлЮлРезультат.Вставить("КодСтраны", СвФлЮлИсточник.КодСтраны);
			
		КонецЕсли;
		
	Иначе
		
		ВызватьСбисИсключение("Неизвестный формат стороны документооборота", "МодульОбъектаКлиент.СоставПакета_СтруктураОрганизацииДляОтправки");
		
	КонецЕсли;
	
	КлючИдентификатора = МодульОбъектаКлиент().Сторона_Получить(СоставПакета.НашаОрганизация, "КлючИдентификатора");
	
	//ИНН обязан быть
	СвФлЮлРезультат.Вставить("ИНН", СвФлЮлИсточник[КлючИдентификатора]);
	
	//Проверим КФ организации.
	Если СоставПакета.Свойство("Контрагент") Тогда
		
		//Может быть задан на контрагенте как КФ отправителя
		КодФилиалаОрганизации = ПрочитатьДополнительныйПараметрСтороны(СоставПакета.Контрагент, "КодФилиалаОтправителя");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(КодФилиалаОрганизации)
		Или ( СвФлЮлИсточник.Свойство("КодФилиала", КодФилиалаОрганизации)
		И ЗначениеЗаполнено(КодФилиалаОрганизации)) Тогда
		
		//Есть КФ отправителя, или установлен КФ на органиации. Приоритет КФ отправителя от контрагента выше установленного на организации
		СвФлЮлРезультат.Вставить("КодФилиала", КодФилиалаОрганизации);
		
	КонецЕсли;
	
	Возврат СторонаРезультат;
	
КонецФункции

// Функция - формирует Отправку СБИС - готовый к отправке Документ на основании состава пакета, прочитанного из 1С
//
// Параметры:
//  СоставПакета - Экземпляр класса (Структура)	- документ СБИС, прочитанный от 1С
//  ДопПараметры - Структура	 				- возможность расширения
// 
// Возвращаемое значение:
//  Экземпляр класса ЦепочкаКомандОбработки (Струкутра) 
//
// v8unpack &НаКлиенте
Функция СоставПакета_ПодготовитьКОтправке(СоставПакета, ДопПараметры=Неопределено) Экспорт
	Перем СбисШифрование, Статус, Этап, МодульИнтеграции, ПараметрыПодготовкиВложений, ЗначениеОбрабатывается;
	
	Если Не ДопПараметры = Неопределено Тогда 
		
        ДопПараметры.Свойство("Шифрование",			СбисШифрование);
        ДопПараметры.Свойство("МодульИнтеграции",	МодульИнтеграции);
        ДопПараметры.Свойство("ПараметрыВложений",	ПараметрыПодготовкиВложений);
		ДопПараметры.Свойство("Этап",				Этап);
		
	КонецЕсли;
	
	Если СбисШифрование = Неопределено Тогда
		
		СбисШифрование = ПолучитьЗначениеПараметраСбис("Шифрование");
		
	КонецЕсли;
	
	Если МодульИнтеграции = Неопределено Тогда
		
		МодульИнтеграции = ПолучитьЗначениеПараметраСбис("Интеграция");
		
	КонецЕсли;

	Если ПараметрыПодготовкиВложений = Неопределено Тогда
		
		ПараметрыПодготовкиВложений = Новый Структура;
		
	КонецЕсли;

	document = Новый Структура;
	ИдПакета = СоставПакета_Идентификатор(СоставПакета, ДопПараметры);
	
	//РезультатПодготовки = Новый Структура("СоставПакета, ДокументОтправить, Ошибки, Готов, Отказ", СоставПакета, document, Новый Массив, Истина, Отказ);
	Если СоставПакета.Свойство("Дата") И ЗначениеЗаполнено(СоставПакета.Дата) Тогда
		document.Вставить("Дата",СоставПакета.Дата);	
	КонецЕсли;
	Если СоставПакета.Свойство("Номер") И ЗначениеЗаполнено(СоставПакета.Номер) Тогда
		document.Вставить("Номер",СоставПакета.Номер);	
	КонецЕсли;
	//Для зашифрованных документов нет суммы
	Если СбисШифрование Тогда
		document.Вставить("Шифрование", Новый Структура("Зашифрован", "Да"));
	ИначеЕсли	СоставПакета.Свойство("Сумма")
			И	ЗначениеЗаполнено(СоставПакета.Сумма) Тогда
		document.Вставить("Сумма", СоставПакета.Сумма);	
	КонецЕсли;
	
	attachmentList	= Новый Массив;
	stage			= Новый Структура;
	
	Если ЗначениеЗаполнено(Этап) Тогда
		
		action = Новый Структура("Название", "");
		Действие = Этап.Действие[0];
		ЗаполнитьЗначенияСвойств(action, Действие);
		
		Если	Действие.ТребуетПодписания = "Да"
			И	Действие.Свойство("Сертификат") Тогда
			action.Вставить("Сертификат", Действие.Сертификат);
		КонецЕсли;
		
		Если	Действие.ТребуетКомментария = "Да"
			И	Действие.Свойство("Комментарий") Тогда
			action.Вставить("Комментарий", Действие.Комментарий);
		КонецЕсли;
			
		// Назначение этапа
		stage = Новый Структура;
		stage.Вставить("Название", ?(ЗначениеЗаполнено(Этап.Название), Этап.Название , ""));
		stage.Вставить("Действие", action);
		
	КонецЕсли;
	
	document.Вставить("Тип", СоставПакета.Тип);
	
	Если СоставПакета.Свойство("Подтип") И ЗначениеЗаполнено(СоставПакета.Подтип) Тогда
		document.Вставить("Подтип", СоставПакета.Подтип);
	КонецЕсли;
		
	Если	СоставПакета_Получить(СоставПакета, "Модифицирован")
		И	ЗначениеЗаполнено(stage) Тогда
		document.Вставить("Этап", stage);
		document.Этап.Вставить("Вложение",	attachmentList);
	ИначеЕсли ЗначениеЗаполнено(action) Тогда
		document.Вставить("Этап", stage);
		document.Этап.Вставить("Вложение",	attachmentList);
	Иначе
		document.Вставить("Вложение",		attachmentList); 
	КонецЕсли;
	
	document.Вставить("Идентификатор",	ИдПакета);
	
	СоставПакета.Вставить("Идентификатор", ИдПакета);
	
	ДопПараметрыВыгрузки = Новый Структура("СоставПакета, Шифрование", СоставПакета, СбисШифрование);
	
	//Обработка вложений
	Для Каждого Вложение Из СоставПакета.Вложение Цикл
		
		attachmentList.Добавить(ВложениеСБИС_Выгрузить(Вложение, "ЗаписьНаБЛ", ДопПараметрыВыгрузки));

	КонецЦикла;
		
	Если	СоставПакета.Свойство("Примечание")
		И	ЗначениеЗаполнено(СоставПакета.Примечание) Тогда
		document.Вставить( "Примечание", СоставПакета.Примечание);
	КонецЕсли;
	
	document.Вставить( "НашаОрганизация", СоставПакета_СтруктураОрганизацииДляОтправки(СоставПакета));
	
	Если СоставПакета.Свойство("Контрагент") Тогда
		
		document.Вставить("Контрагент", СоставПакета_СтруктураКонтрагентаДляОтправки(СоставПакета));

	КонецЕсли;
	
	// Редакция документа: есть пользовательский идентификатор (по-умолчанию это имя документа + УИД документа)
	Если    Не	СоставПакета.Параметры.Свойство("ЭтоРедакция")
		Или		СоставПакета.Параметры.ЭтоРедакция Тогда
		
		// Создать редакцию, если стоит пользовательский ИД и не стоит запрета
		redaction = Новый Структура;
		redaction.Вставить("ИдентификаторИС", СоставПакета_Идентификатор(СоставПакета, Новый ФиксированнаяСтруктура("Формат", "Редакция")));
		
		document.Вставить("Редакция", redaction);
		
	КонецЕсли;
	
	Если	СоставПакета.Свойство("Ответственный", ЗначениеОбрабатывается)
		И	ЗначениеЗаполнено(ЗначениеОбрабатывается) Тогда
		
		document.Вставить("Ответственный", ЗначениеОбрабатывается);
		
	КонецЕсли;
	
	Если	СоставПакета.Свойство("Подразделение", ЗначениеОбрабатывается)
		И	ЗначениеЗаполнено(ЗначениеОбрабатывается) Тогда
		
		document.Вставить( "Подразделение", ЗначениеОбрабатывается);
		
	КонецЕсли;
	
	Если	СоставПакета.Свойство("Регламент", ЗначениеОбрабатывается)
		И	ЗначениеЗаполнено(ЗначениеОбрабатывается) Тогда
		
		document.Вставить("Регламент", ЗначениеОбрабатывается);
		
	КонецЕсли;
	
	Если	СоставПакета.Свойство("ДокументОснование", ЗначениеОбрабатывается)
		И	ЗначениеЗаполнено(ЗначениеОбрабатывается) Тогда
		osnovania = Новый Массив;
		Для Каждого ДокОсн Из ЗначениеОбрабатывается Цикл 
			osn = Новый Структура;
			Если ДокОсн.Свойство("ВидСвязи") Тогда
				osn.Вставить( "ВидСвязи", ДокОсн.ВидСвязи );	
			КонецЕсли;
			doc = Новый Структура;
			Для Каждого Элемент Из ДокОсн Цикл
				Если Элемент.Ключ<>"ВидСвязи" Тогда
					doc.Вставить( Элемент.Ключ, Элемент.Значение );	
				КонецЕсли;
			КонецЦикла;
			osn.Вставить( "Документ", doc );
			osnovania.Добавить(osn);
		КонецЦикла;
		document.Вставить( "ДокументОснование", osnovania ); 				
	КонецЕсли;
	
	Если	СоставПакета.Свойство("ДопПоля", ЗначениеОбрабатывается)
		И	ЗначениеЗаполнено(ЗначениеОбрабатывается) Тогда
		
		DopPolya = Новый Массив;
		Для Каждого Поле Из СоставПакета.ДопПоля Цикл 
			
			DopPolya.Добавить(Строка(Поле));
			
		КонецЦикла;
		document.Вставить("ДопПоля", DopPolya);
		
	КонецЕсли;
	
	Если	СоставПакета.Параметры.НеЗапускатьВДокументооборот Тогда
		
		document.Вставить("НеЗапускатьВДокументооборот", "Да");
		
	КонецЕсли;
	
	Если	СоставПакета.Параметры.Провести Тогда
		
		document.Вставить("Провести", "Да");
		
	КонецЕсли;
	
	Возврат document;
	
КонецФункции

// v8unpack &НаКлиенте
Функция СоставПакета_Идентификатор(СоставПакета, ДопПараметры = Неопределено) Экспорт 
	Перем ИдПакета, Статус, ФорматИД;
	
	Направление = "1С";
	Если Не ДопПараметры = Неопределено Тогда
		
		Если ТипЗнч(ДопПараметры) = Тип("Строка") Тогда
			
			Направление = ДопПараметры;
			
		Иначе
			
			Если ДопПараметры.Свойство("Направление") Тогда
			
				Направление = ДопПараметры.Направление;
				
			КонецЕсли;
			
			Если ДопПараметры.Свойство("Формат") Тогда
			
				ФорматИД = ДопПараметры.Формат;
				
			КонецЕсли;

		КонецЕсли;
		
	КонецЕсли;
	
	Если Направление = "1С" Тогда
	
		Если			СоставПакета.Свойство("ВременныйИдентификатор", ИдПакета) Тогда
			
			// Ид пакета в готовом виде. Ранее созданный идентификатор.
			
		ИначеЕсли		СоставПакета.Свойство("ПользовательскийИдентификатор", ИдПакета)			                    
				Или	(		СоставПакета.Свойство("ИдентификаторРедакции", ИдПакета)
					И	Не	Сторона_Получить(СоставПакета.Контрагент, "ЗапретРедакций")) Тогда
				
			// Ид пакета в виде редакции, либо пользовательского ИД.
			// Скорее всего, там будет составное значение из имени типа + УИД основания 1С
			ИдПакета = Сред(ИдПакета, Найти(ИдПакета, ":") + 1);
			СоставПакета.Вставить("ВременныйИдентификатор", ИдПакета);
			
		Иначе
			
			ИдПакета = Строка(Новый УникальныйИдентификатор());
			СоставПакета.Вставить("ВременныйИдентификатор", ИдПакета);
			
		КонецЕсли;
		
	Иначе
		
		//Вернем существующий идентификатор
		СоставПакета.Свойство("Идентификатор", ИдПакета);

	КонецЕсли;
	
	Возврат ИдПакета;
	
КонецФункции

// v8unpack &НаКлиенте
Функция СоставПакета_Получить(СоставПакета, КлючПолучить, ДопПараметры = Неопределено) Экспорт 
	Перем ЗначениеИтог;
	
	Если		КлючПолучить = "РегламентНазвание" Тогда
		
		Если 	СоставПакета.Свойство("Регламент",	ЗначениеИтог)
			И	ЗначениеЗаполнено(ЗначениеИтог)
			И	ЗначениеИтог.Свойство("Название",	ЗначениеИтог) Тогда
			
			Возврат ЗначениеИтог;
			
		Иначе
			
			ЗначениеИтог = "";
			
		КонецЕсли;
		
	ИначеЕсли	КлючПолучить = "ИдентификаторСБИС" Тогда
		
		ЗначениеИтог = СоставПакета_Идентификатор(СоставПакета, "СБИС");
		
	ИначеЕсли	КлючПолучить = "Идентификатор"
			Или	КлючПолучить = "Идентификатор1С" Тогда
		
		ЗначениеИтог = СоставПакета_Идентификатор(СоставПакета);
		
	ИначеЕсли КлючПолучить = "ОсновнойДокумент1С" Тогда
		
		Если	СоставПакета.Вложение.Количество()
			И	СоставПакета.Вложение[0].Свойство("Документы1С")
			И	ЗначениеЗаполнено(СоставПакета.Вложение[0].Документы1С) Тогда
			ЗначениеИтог = СоставПакета.Вложение[0].Документы1С[0].Значение;
		КонецЕсли; 
		
	ИначеЕсли КлючПолучить = "СтатусГосСистемы" Тогда
		
		ЗначениеИтог = СоставПакета_СтатусГоссистемыПоПакету(СоставПакета);
		
	ИначеЕсли КлючПолучить = "ЕстьРасхождения" Тогда
		
		ЗначениеИтог = СоставПакета_РасхожденияПоПакету(СоставПакета);
		
	ИначеЕсли КлючПолучить = "ДанныеСравнения" Тогда
		
		ЗначениеИтог = СоставПакета_ДанныеСравнения(СоставПакета, ДопПараметры)
		
	ИначеЕсли КлючПолучить = "ДокументДляВложения" Тогда
		
		ЗначениеИтог = СоставПакета_ОснованиеДляВложения(СоставПакета, ДопПараметры);
		
	ИначеЕсли КлючПолучить = "Название" Тогда
		
		Если Не (СоставПакета.Свойство(КлючПолучить, ЗначениеИтог) И ЗначениеЗаполнено(ЗначениеИтог)) Тогда
			ЗначениеИтог = "";
			
			Если СоставПакета.Вложение.Количество() Тогда
				Документы1С = ВложениеСБИС_Получить(СоставПакета.Вложение[0], "Документы1С");
				Если ЗначениеЗаполнено(Документы1С)
					И ЗначениеЗаполнено(Документы1С[0].Значение) Тогда
					ЗначениеИтог = Строка(Документы1С[0].Значение);
				Иначе
					ЗначениеИтог = ВложениеСБИС_Получить(СоставПакета.Вложение[0], "Название");
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли	КлючПолучить = "Вложение" Тогда

		ЗначениеИтог = СоставПакета_НайтиВложение(СоставПакета, ДопПараметры);
		
	ИначеЕсли	КлючПолучить = "Вложения" Тогда 
		
		ЗначениеИтог = Новый Массив;  
		
		Если НЕ СоставПакета.Свойство("Вложение") Тогда
			
			Возврат ЗначениеИтог;
			
		КонецЕсли;
			
		// Перебираем массив вложений
		Для Каждого Вложение Из СоставПакета.Вложение Цикл
			
            ЗначениеИтог.Добавить(Вложение);
			
		КонецЦикла;
		
		Если	Не	ДопПараметры = Неопределено Тогда
			Если	ДопПараметры.Свойство("Служебные")
				И	ДопПараметры.Служебные
				И	СоставПакета.Свойство("ВложениеСлужебные") Тогда
			
			// Перебираем массив вложений
				Для Каждого Вложение Из СоставПакета.ВложениеСлужебные Цикл
					
		            ЗначениеИтог.Добавить(Вложение);
					
				КонецЦикла;
				
			КонецЕсли;
		
			Если	ДопПараметры.Свойство("Учет")
				И	ДопПараметры.Служебные
				И	СоставПакета.Свойство("ВложениеУчета") Тогда
				
				// Перебираем массив вложений
				Для Каждого Вложение Из СоставПакета.ВложениеУчета Цикл
					
		            ЗначениеИтог.Добавить(Вложение);
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;

	ИначеЕсли КлючПолучить = "Модифицирован" Тогда
		Если НЕ СоставПакета.Свойство(КлючПолучить, ЗначениеИтог) Тогда
			ЗначениеИтог = Ложь;
		КонецЕсли;
	ИначеЕсли КлючПолучить = "Грузополучатель" Тогда

		Участники = СоставПакета_Получить(СоставПакета, "Участники");
		
		Если НЕ ЗначениеЗаполнено(Участники) Тогда
			ЗначениеИтог = Неопределено;
		ИначеЕсли Найти("ЗаказИсх, ДокОтгрВх", СоставПакета_Получить(СоставПакета, "Тип")) Тогда
			Участники.Свойство("Лицо3", ЗначениеИтог);
		Иначе
			Участники.Свойство("Лицо2", ЗначениеИтог);
		КонецЕсли;
	ИначеЕсли КлючПолучить = "Параметры" Тогда
		
		Если Не СоставПакета.Свойство("Параметры") Тогда
			
			СоставПакета.Вставить("Параметры", Новый Структура);
			
		КонецЕсли;
		ЗначениеИтог = СоставПакета.Параметры;

	ИначеЕсли КлючПолучить = "КодСостояния" Тогда
		
		// https://saby.ru/help/integration/api/sequence/cod
		Если	СоставПакета.Свойство("Состояние",	ЗначениеИтог)
			И	ЗначениеИтог.Свойство("Код",		ЗначениеИтог)
			И	ЗначениеЗаполнено(ЗначениеИтог) Тогда
			
			Возврат ЗначениеИтог;
			
		КонецЕсли;	
		
	ИначеЕсли КлючПолучить = "ДопПараметрыСБИС" Тогда
		
		ЗначениеИтог = СоставПакета_ДопПараметрыСБИС(СоставПакета);
		
	ИначеЕсли КлючПолучить = "МожноАннулировать" Тогда
		
		Возврат СоставПакета_МожноАннулировать(СоставПакета, ДопПараметры);  
		
	ИначеЕсли КлючПолучить = "СтатусДокумента" Тогда 
		
		ЗначениеИтог = СоставПакета_СостояниеДокумента(СоставПакета);  
		
	ИначеЕсли КлючПолучить = "ТекущийЭтап" Тогда
		
		ЗначениеИтог = СоставПакета_ТекущийЭтап(СоставПакета);

	ИначеЕсли КлючПолучить = "ТекущееДействие" Тогда
		
		ЗначениеИтог = СоставПакета_ТекущееДействие(СоставПакета);
		
	ИначеЕсли КлючПолучить = "ЭтоЧерновик" Тогда
		
		ЗначениеИтог	=	Строка(СоставПакета_Получить(СоставПакета, "КодСостояния")) = "0"
						И	ЗначениеЗаполнено(СоставПакета_Получить(СоставПакета, "ИдентификаторСБИС"));

	ИначеЕсли КлючПолучить = "ОписаниеДействий" Тогда
		
		ЗначениеИтог = СоставПакета_ОписаниеДействий(СоставПакета);	
		
	ИначеЕсли КлючПолучить = "ТекущаяФазаДокумента" Тогда
		
		ЗначениеИтог = СоставПакета_ТекущаяФазаДокумента(СоставПакета);
		
	ИначеЕсли	КлючПолучить = "ПодходящийСертификат" Тогда

		ЗначениеИтог = СоставПакета_ПодходящийСертификат(СоставПакета, ДопПараметры);    
		
	ИначеЕсли	КлючПолучить = "Комментарий" Тогда

		ЗначениеИтог = СоставПакета_Комментарий(СоставПакета, ДопПараметры);  
		
	ИначеЕсли	КлючПолучить = "АктивныйЭтап" Тогда

		ЗначениеИтог = СоставПакета_АктивныйЭтап(СоставПакета, ДопПараметры);

	Иначе
		
		СоставПакета.Свойство(КлючПолучить, ЗначениеИтог);
		
	КонецЕсли;
	
	Возврат ЗначениеИтог;
	
КонецФункции 

