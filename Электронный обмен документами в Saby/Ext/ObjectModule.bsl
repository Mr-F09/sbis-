//DynamicDirective

Функция ТокенДляТекущегоПользователяПоAPI(ДанныеСотрудника, context_params) Экспорт
		Настройки = ПрочитатьИзХранилища("СБИС", "Авторизация",,"ПользовательСБИС"); 
	ТекстUnauthorized = "Unauthorized";
	Если Настройки = Неопределено Тогда
		ТекстОшибки = "Не заполнены данные администратора системы для авторизации по токену.";
		ВызватьИсключение NewExtExceptionСтрока(, ТекстОшибки, , , , ТекстUnauthorized);
	КонецЕсли;
	Если get_prop(Настройки, "ВидБесшовнойАвторизации") = 1 Тогда	
		ИдентификаторСессииАдминистратора = local_helper_auth_by_app(Настройки.ИДПриложения, Настройки.КлючПриложения, Настройки.КлючАутентификации, context_params);	
	Иначе	
		ИдентификаторСессииАдминистратора = local_helper_auth_by_login_password(context_params, Настройки.Логин, Настройки.Пароль);	
	КонецЕсли;
	
	Если ИдентификаторСессииАдминистратора = Неопределено Тогда
		ТекстОшибки = "Не удалось получить сессию администратора. Проверьте настройки бесшовной авторизации.";
		ВызватьИсключение NewExtExceptionСтрока(, ТекстОшибки, , , , ТекстUnauthorized);	
	КонецЕсли;	
	session = Новый Структура;
	session.Вставить("session", ИдентификаторСессииАдминистратора);
	// BSLLS:DeprecatedCurrentDate-off
	session.Вставить("session_begin", ТекущаяДата());
	// BSLLS:DeprecatedCurrentDate-on
    ЗаписатьСессию(context_params, session); 
	
	ИдСотрИС = ДанныеСотрудника.Сотрудник.ИдентификаторИС;

	Токен = ТокенПоИдентификатору(ИдСотрИС, context_params);
	
	Если ЗначениеЗаполнено(Токен) Тогда 
		Возврат Токен;
	КонецЕсли;
	СтруктураПоискаСотрудника = Новый Структура("ИдентификаторИС", ИдСотрИС); 
	ИННСотрудника = get_prop(ДанныеСотрудника.Сотрудник, "ИНН"); 
	Если ЗначениеЗаполнено(ИННСотрудника) Тогда  
		СтруктураПоискаСотрудника.Вставить("ИНН", ИННСотрудника);	
	КонецЕсли;
	СотрудникПоиска = Новый Структура("Сотрудник", СтруктураПоискаСотрудника);
	СтруктураРезультата = local_helper_read_employee(СотрудникПоиска, context_params);
	Если ТипЗнч(СтруктураРезультата) = Тип("ИнформацияОбОшибке") Тогда
		Описание = ЗначениеИзСтрокиВнутрНаСервере(СтруктураРезультата.Описание); 
		message = get_prop(Описание,"message");
		Если Лев(message, 27) <> "Не удалось найти сотрудника" Тогда 
			ВызватьИсключение NewExtExceptionСтрока(СтруктураРезультата, , , , , ТекстUnauthorized);
		КонецЕсли;
		СоздаватьСотрудника = СоздаватьСотрудникаПоПрофилю(ДанныеСотрудника, Настройки);
		Если Не СоздаватьСотрудника Тогда 
			ВызватьИсключение NewExtExceptionСтрока(СтруктураРезультата, , , , , ТекстUnauthorized);
		КонецЕсли;	
		СтруктураРезультата = сбисЗаписатьСотрудникаНаСервере(ДанныеСотрудника, context_params);
		Если ТипЗнч(СтруктураРезультата) = Тип("ИнформацияОбОшибке") Тогда
			ВызватьИсключение NewExtExceptionСтрока(СтруктураРезультата, , , , , ТекстUnauthorized);
		КонецЕсли; 	
	КонецЕсли;
	СтруктураРезультата = get_prop(СтруктураРезультата,"result");
	Сотрудник = get_prop(СтруктураРезультата,"Сотрудник"); 
	Если get_prop(Сотрудник, "ДоступВСистему", "Нет") = "Нет" Тогда 
		ТекстОшибки = "Пользователю запрещен доступ в " + ЛокализацияНазваниеПродукта();
		ВызватьИсключение NewExtExceptionСтрока(, , , , , ТекстUnauthorized);	
	КонецЕсли;	
	ИдСотрудникаСБИС = get_prop(Сотрудник,"Идентификатор");
	СтруктураРезультата = local_helper_link_external_user(ДанныеСотрудника.Сотрудник.ИдентификаторИС, ИдСотрудникаСБИС, context_params);    
	Если ТипЗнч(СтруктураРезультата) = Тип("ИнформацияОбОшибке") Тогда
		ВызватьИсключение NewExtExceptionСтрока(СтруктураРезультата, , , , , ТекстUnauthorized);
	КонецЕсли;		
	
	Токен = ТокенПоИдентификатору(ИдСотрИС, context_params);
	
	Возврат Токен;
КонецФункции
// v8unpack #КонецОбласти

