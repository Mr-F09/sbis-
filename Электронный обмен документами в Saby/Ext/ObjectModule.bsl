//DynamicDirective

Функция ЭтоОбъектМетаданных(Данные)
	ТипДанных = Новый Массив;
	ТипДанных.Добавить(Тип("Строка"));
	ТипДанных.Добавить(Тип("Дата"));
	ТипДанных.Добавить(Тип("Число"));
	ТипДанных.Добавить(Тип("Булево"));
	ТипДанных.Добавить(Тип("Структура"));
