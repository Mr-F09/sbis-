// v8unpack #Область include_core_base_Helpers_ПрикрепленныеФайлы

// Возвращает записи присоединенных файлов объекта.
//
// Параметры:
//  Объект                       - Ссылка - ссылка на объект, который может содержать присоединенные файлы,
//                               - Массив - массив ссылок на объекты.
//  ИменаФайлов                  - Неопределено - выбираются все присоединенные файлы.
//                               - Массив - массив строк с именами файлов, которые нужно получить.
//  ИзмененныеПосле              - Неопределено - не учитывается дата изменений файлов.
//                               - Дата - берутся только файлы с датой больше указанной.
//  ДобавочныеИменаСправочников  - Строка - имена справочников присоединенных файлов с реквизитами владельца
//                                 через запятую, требуется в дополнение к имени справочника по умолчанию,
//                                 в формате "ИмяСправочника.ИмяРеквизитаВладельцаФайла, ... "
//                                 если не указано ИмяРеквизитаВладельцаФайла, то используется "ВладелецФайла",
//                               = "" - будет использоваться имя справочника по умолчанию 
//                                 с именем реквизита владельца по умолчанию.
//  ВключатьПомеченныеНаУдаление - Булево - при значении Истина возвращать также помеченные на удаление.
//
// Возвращаемое значение:
//  Массив                       - массив ссылок на присоединенные файлы
//
// Нужны все параметры
// BSLLS:NumberOfOptionalParams-off
Функция ПрикрепленныеФайлыКОбъекту(Знач Объект, ИменаФайлов = Неопределено, ИзмененныеПосле = Неопределено,
		Знач ДобавочныеИменаСправочников = "Файлы.ВладелецФайла, ХранилищеДополнительнойИнформации.Объект, ДокументыПрисоединенныеФайлы.ВладелецФайла",
		Знач ВключатьПомеченныеНаУдаление = Ложь) Экспорт
	
	Если НЕ ЗначениеЗаполнено(Объект) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	// Приведем Сотрудника к ФизЛицу
	Объект = ФизЛицоСотрудника(Объект, Объект);
	
	// Всегда используем стандартное имя справочника из БСП
	ТипВладельцаФайлов = ТипЗнч(Объект);
	МетаданныеВладельца = Метаданные.НайтиПоТипу(ТипВладельцаФайлов);
	Попытка
		ИмяСправочникаВладельца = МетаданныеВладельца.Имя + "ПрисоединенныеФайлы";
	Исключение
		ВызватьИсключение("Ошибка получения прикрепленных файлов. Не удалось получить тип владельца.");
	КонецПопытки;
	// + заданные дополнительно вызывающим
	Если ЗначениеЗаполнено(ДобавочныеИменаСправочников) Тогда
		ДобавочныеИменаСправочников = ДобавочныеИменаСправочников + ",";
	КонецЕсли;
	ДобавочныеИменаСправочников = ДобавочныеИменаСправочников + ИмяСправочникаВладельца;
	
	МассивИменСправочников = СтрРазделить82(ДобавочныеИменаСправочников, ",");
		
	ТекстЗапросов = ТекстЗапросаПоМассивуСправочников(Объект, ИменаФайлов, ИзмененныеПосле, МассивИменСправочников,  ИмяСправочникаВладельца, ВключатьПомеченныеНаУдаление);
	Если НЕ ЗначениеЗаполнено(ТекстЗапросов) Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Попытка
		Запрос = Новый Запрос(ТекстЗапросов);
		Запрос.УстановитьПараметр("ВладелецФайлов", Объект);
		Если ЗначениеЗаполнено(ИзмененныеПосле) Тогда
			Запрос.УстановитьПараметр("ИзмененныеПосле", ИзмененныеПосле);
		КонецЕсли;
		Если ЗначениеЗаполнено(ИменаФайлов) Тогда
			Запрос.УстановитьПараметр("ИменаФайлов", ИменаФайлов);
		КонецЕсли;
		Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Исключение
		ИнфОбОшибке = ИнформацияОбОшибке();
		ОшибкаСтруктура = ExtExceptionAnalyse(ИнфОбОшибке);
		СтрокаОшибки = ЗначениеВСтрокуВнутр(ОшибкаСтруктура);
		ВызватьИсключение("Ошибка получения прикрепленных файлов. Не удалось выполнить запрос: " + СтрокаОшибки);
	КонецПопытки;
	
КонецФункции
// BSLLS:NumberOfOptionalParams-on

Функция ПроверитьСправочникиИРеквизиты(ИмяСправочника, ИмяРеквизитаВладельца) 
	Результат = Истина;
	// Только существующий справочник с корректным именем и корректным именем реквизита
	Попытка
		МетаданныеСправочник = Метаданные.Справочники.Найти(ИмяСправочника);
		Если МетаданныеСправочник = Неопределено Тогда  
			Результат = Ложь;
		КонецЕсли;
		Если ЗначениеЗаполнено(ИмяРеквизитаВладельца) Тогда
			Если МетаданныеСправочник.Реквизиты.Найти(ИмяРеквизитаВладельца) = Неопределено Тогда
				Результат = Ложь;
			КонецЕсли;
		Иначе
			Если МетаданныеСправочник.Реквизиты.Найти("ВладелецФайла") = Неопределено Тогда
				Результат = Ложь;
			КонецЕсли;
		КонецЕсли;
		Если НЕ ПравоДоступа("Чтение", Метаданные.Справочники[ИмяСправочника]) Тогда  
			Результат = Ложь;
		КонецЕсли;
	Исключение
		Результат = Ложь;
	КонецПопытки;
	Возврат Результат;	
КонецФункции

Процедура ДобавитьТекстЗапросаВключатьПомеченныеНаУдаление(ТекстЗапроса, ВключатьПомеченныеНаУдаление)
	Если НЕ ВключатьПомеченныеНаУдаление Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И НЕ ПрисоединенныеФайлы.ПометкаУдаления";
	КонецЕсли; 
КонецПроцедуры

Процедура ДобавитьТекстЗапросаИзмененныеПосле(ТекстЗапроса, ИмяСправочника, ИзмененныеПосле) 
	Если ЗначениеЗаполнено(ИзмененныеПосле) Тогда
		// Новые версии БСП
		Если Метаданные.Справочники[ИмяСправочника].Реквизиты.Найти("ДатаСоздания") <> Неопределено
			И Метаданные.Справочники[ИмяСправочника].Реквизиты.Найти("ДатаМодификацииУниверсальная") <> Неопределено
			Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|	И (ПрисоединенныеФайлы.ДатаМодификацииУниверсальная > &ИзмененныеПосле
			|	ИЛИ ПрисоединенныеФайлы.ДатаСоздания > &ИзмененныеПосле)";
			// Старые версии БСП
		ИначеЕсли Метаданные.Справочники[ИмяСправочника].Реквизиты.Найти("ТекущаяВерсияДатаСоздания") <> Неопределено
			И Метаданные.Справочники[ИмяСправочника].Реквизиты.Найти("ТекущаяВерсияДатаМодификацииФайла") <> Неопределено
			Тогда
			ТекстЗапроса = ТекстЗапроса + "
			|	И (ПрисоединенныеФайлы.ТекущаяВерсияДатаМодификацииФайла > &ИзмененныеПосле
			|	ИЛИ ПрисоединенныеФайлы.ТекущаяВерсияДатаСоздания > &ИзмененныеПосле)";
		 Иначе 
			// - незнакомые версии = берем ВСЁ
			Возврат;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры 

Процедура ДобавитьТекстЗапросаИменаФайлов(ТекстЗапроса, ИменаФайлов, ИмяСправочника) 
	Если ЗначениеЗаполнено(ИменаФайлов) Тогда
		// Получаем из: Справочник.ХранилищеДополнительнойИнформации
		Если ИмяСправочника = "ХранилищеДополнительнойИнформации" Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + "
			|И ВЫРАЗИТЬ(ПрисоединенныеФайлы.ИмяФайла КАК СТРОКА(255)) В (&ИменаФайлов) ";
		Иначе
			// Новые версии БСП
			Если Метаданные.Справочники[ИмяСправочника].Реквизиты.Найти("Расширение") <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И (
				|	ВЫБОР
				|		КОГДА ПрисоединенныеФайлы.Расширение = """"
				|			ТОГДА ПрисоединенныеФайлы.Наименование В (&ИменаФайлов)
				|		ИНАЧЕ
				|			ПрисоединенныеФайлы.Наименование + "".""
				|			+ ПрисоединенныеФайлы.Расширение В (&ИменаФайлов)
				|	КОНЕЦ ) ";
				// Старые версии БСП
			ИначеЕсли Метаданные.Справочники[ИмяСправочника].Реквизиты.Найти("ТекущаяВерсияРасширение") <> Неопределено Тогда
				ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И (
				|	ВЫБОР
				|		КОГДА ПрисоединенныеФайлы.ТекущаяВерсияРасширение = """"
				|			ТОГДА ПрисоединенныеФайлы.Наименование В (&ИменаФайлов)
				|		ИНАЧЕ
				|			ПрисоединенныеФайлы.Наименование + "".""
				|			+ ПрисоединенныеФайлы.ТекущаяВерсияРасширение В (&ИменаФайлов)
				|	КОНЕЦ ) ";
			Иначе
				// незнакомые версии - НЕ БЕРЕМ НИЧЕГО
				ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И ЛОЖЬ ";
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ТекстЗапросаПоМассивуСправочников(Объект, ИменаФайлов, ИзмененныеПосле,
					МассивИменСправочников, ИмяСправочникаВладельца, Знач ВключатьПомеченныеНаУдаление = Ложь)	
	ТекстЗапросов = "";
	Для Каждого ЭлементМассива Из МассивИменСправочников Цикл
		
		ИмяСправочника = СокрЛП(ЭлементМассива);
		ИмяРеквизитаВладельца = "";
		Если ИмяСправочника <> ИмяСправочникаВладельца Тогда
			МассивИмяСправочникаИмяРеквизита = СтрРазделить82(СокрЛП(ЭлементМассива), ".");
			ИмяСправочника = МассивИмяСправочникаИмяРеквизита[0];
			Если МассивИмяСправочникаИмяРеквизита.Количество() > 1 Тогда
				ИмяРеквизитаВладельца = МассивИмяСправочникаИмяРеквизита[1];
			КонецЕсли;
		КонецЕсли;
		
		Если ПроверитьСправочникиИРеквизиты(ИмяСправочника, ИмяРеквизитаВладельца) = Ложь Тогда
			Продолжить;
		КонецЕсли;	
		
		Если ЗначениеЗаполнено(ТекстЗапросов) Тогда
			ТекстЗапросов = ТекстЗапросов + "
				|
				|ОБЪЕДИНИТЬ ВСЕ
				|
				|";
		КонецЕсли;
		
		ТекстЗапроса =
			"ВЫБРАТЬ
			|	ПрисоединенныеФайлы.Ссылка КАК Ссылка
			|ИЗ
			|	&ИмяСправочника КАК ПрисоединенныеФайлы
			|ГДЕ
			|	ПрисоединенныеФайлы.ВладелецФайла = &ВладелецФайлов";
		Если ЗначениеЗаполнено(ИмяРеквизитаВладельца) Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "ВладелецФайла", ИмяРеквизитаВладельца);
		КонецЕсли;
		Если ТипЗнч(Объект) = Тип("Массив") Тогда
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "= &ВладелецФайлов", "В (&ВладелецФайлов)");
		КонецЕсли;
		  
		ДобавитьТекстЗапросаВключатьПомеченныеНаУдаление(ТекстЗапроса, ВключатьПомеченныеНаУдаление);
		ДобавитьТекстЗапросаИзмененныеПосле(ТекстЗапроса, ИмяСправочника, ИзмененныеПосле);	
		ДобавитьТекстЗапросаИменаФайлов(ТекстЗапроса, ИменаФайлов, ИмяСправочника);
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса, "&ИмяСправочника", "Справочник." + ИмяСправочника);
		
		ТекстЗапросов = ТекстЗапросов + ТекстЗапроса;
		
	КонецЦикла;
	Возврат ТекстЗапросов;
КонецФункции	

