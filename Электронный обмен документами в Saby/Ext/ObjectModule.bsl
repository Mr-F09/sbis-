//Устанавливает параметры интеграции обмена
// v8unpack &НаКлиенте
Функция	НовыйДанныеИнтеграции(ПараметрыКонструктора = Неопределено) Экспорт
	
	ИменаКлючей =	"Подписки
					|Потоки
					|НеизвестныеОтветы
					|ГенерируемыеСобытия";
	
	Результат = Новый Структура;
	
	Для НомерКлюча = 1 По СтрЧислоСтрок(ИменаКлючей) Цикл
		Результат.Вставить(СтрПолучитьСтроку(ИменаКлючей, НомерКлюча), Новый Соответствие);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

