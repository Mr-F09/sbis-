// v8unpack #Область include_core2_vo2_Модуль_МодульОбъектаКлиент_Классы_КонвертСБИС

// v8unpack &НаКлиенте
Функция НовыйКонвертСБИС(ВходящиеПараметры, ДопПараметры = Неопределено) Экспорт 
	
	Кэш = ПолучитьТекущийЛокальныйКэш();
	
	ГрязныйИниДанные	= ВходящиеПараметры.ГрязныйИни;
	Документ1Ссылка		= ВходящиеПараметры.ДокументСсылка;

	ВходящиеПараметры.Вставить("Тип",		Кэш.ОбщиеФункции.РассчитатьЗначение("Тип",		ГрязныйИниДанные));
	ВходящиеПараметры.Вставить("ПодТип",	Кэш.ОбщиеФункции.РассчитатьЗначение("ПодТип",	ГрязныйИниДанные));
	
	Если ДопПараметры = Неопределено Тогда
		
		ДопПараметры = Новый Структура;
		
	КонецЕсли;
	
	ДопПараметры.Вставить("_класс",	"КонвертСБИС");
		
	Вложение = НовыйВложениеСБИС(ВходящиеПараметры, ДопПараметры);
	
	ИмяДокумента				= Кэш.ОбщиеФункции.ПолучитьРеквизитМетаданныхОбъекта(Документ1Ссылка, "Имя");
	НеЗапускатьВДокументооборот	= Кэш.ОбщиеФункции.РассчитатьЗначение("НеЗапускатьВДокументооборот", ГрязныйИниДанные);
	
	// Получить пользовательский идентификатор
	МассивСтатусРегламент	= ПолучитьЗначениеПараметраСбис("МассивСтатусРегламент");
	РегламентСтруктура		= ВложениеСБИС_Получить(Вложение, "Регламент");
	
	//KES 050751151 Статусы в разрезе регламентов (ОТПРАВКА ПАКЕТА ДОКУМЕНТОВ) --> 40 +
	Если		ЗначениеЗаполнено(РегламентСтруктура) 
		И		РегламентСтруктура.Свойство("Название") 
		И НЕ	МассивСтатусРегламент.Найти(РегламентСтруктура.Название) = Неопределено Тогда
		
		// Хранение статуса идёт по регламенту - Пользовательский ИД генерируется
		фрм		= Кэш.ГлавноеОкно.сбисНайтиФормуФункции("ПрочитатьПараметрыДокументаСБИС", Кэш.ФормаРаботыСоСтатусами,"",Кэш);
		ИдДок	= фрм.ПрочитатьПараметрыДокументаСБИС(	Документ1Ссылка,
														Кэш.ГлавноеОкно.Кэш.Парам.КаталогНастроек,
														РегламентСтруктура.Название+"ДокументСБИС_Ид",Кэш.Ини);
		ПользовательскийИдентификатор = ИмяДокумента + ":" + ?( ЗначениеЗаполнено(ИдДок), ИдДок, Строка(Новый УникальныйИдентификатор));
		
	Иначе
		
		ПользовательскийИдентификатор = Кэш.ОбщиеФункции.РассчитатьЗначение("Документ_ПользовательскийИдентификатор", ГрязныйИниДанные, Кэш);
		Если НЕ ЗначениеЗаполнено(ПользовательскийИдентификатор) Тогда
			
			ПользовательскийИдентификатор = ИмяДокумента + ":" + Строка(Документ1Ссылка.УникальныйИдентификатор());
			
		КонецЕсли;
		
	КонецЕсли;
				
	Вложение.Вставить("НашаОрганизация",	ВложениеСБИС_Получить(Вложение, "Отправитель"));
	
	ПолучательКонверт = ВложениеСБИС_Получить(Вложение, "Получатель");
	Если Не ПолучательКонверт = Неопределено Тогда
	 
		Вложение.Вставить("Контрагент", ПолучательКонверт);
		
	КонецЕсли;
	Вложение.Удалить("Отправитель");
	Вложение.Удалить("Получатель");
	
	ОписаниеЧисло = Новый ОписаниеТипов("Число");
	СуммаЧисло = ОписаниеЧисло.ПривестиЗначение(Вложение.Сумма);
	
	Если НЕ СуммаЧисло > 0 Тогда
			Вложение.Удалить("Сумма")	
	КонецЕсли;
		
	Вложение.Вставить("НеЗапускатьВДокументооборот",	НеЗапускатьВДокументооборот);
	Вложение.Вставить("ПользовательскийИдентификатор",	ПользовательскийИдентификатор);
	
	// Временная заглушка для дальнейшей проверке типа
	Вложение._класс = "СоставПакета" + Символы.ПС + Вложение._класс;
	
	Возврат Вложение;
	
КонецФункции

// v8unpack #КонецОбласти

// v8unpack #Область include_core2_vo2_Модуль_МодульОбъектаКлиент_Классы_ВложениеСБИС

// v8unpack #Область include_core2_vo2_Модуль_МодульОбъектаКлиент_Классы_ВложениеСБИС_Конструктор

// Функция - создает новые вложение СБИС
//
// Параметры:
//  ВходящиеПараметры	 - Структура	 - входные параметры
//  ДопПараметры		 - Структура	 - расширение
// 
// Возвращаемое значение:
//  ВложениеСБИС - Структура с параметрами и данными вложения
//
// v8unpack &НаКлиенте
Функция НовыйВложениеСБИС(ВходящиеПараметры = Неопределено, ДопПараметры = Неопределено) Экспорт 
	Перем ОписаниеТипаНаследование, Документы1СВложения;
	
	СтруктураВложения = ВложениеСБИС_Пустой();
	
	Если ДопПараметры = Неопределено Тогда
		
		ДопПараметры = Новый Структура;
		
	КонецЕсли;
	
	Если ДопПараметры.Свойство("_класс", ОписаниеТипаНаследование) Тогда
		
		Если Не Найти(СтруктураВложения._класс, ОписаниеТипаНаследование) Тогда
			
			СтруктураВложения._класс = ОписаниеТипаНаследование + Символы.ПС + СтруктураВложения._класс;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если	Не	ВходящиеПараметры = Неопределено Тогда
		
		Если		ЭтоТипСбис(ВходящиеПараметры, СтруктураВложения._класс) Тогда
		
			ВложениеСБИС_Заполнить(СтруктураВложения, ВходящиеПараметры, СтруктураВложения._класс);
			
		ИначеЕсли	ВходящиеПараметры.Свойство("ДокументФайл")
				И	ВходящиеПараметры.Свойство("ГрязныйИни") Тогда
				
			НовыйВложениеСБИС_ЗаполнитьПоДокументФайл(СтруктураВложения, ВходящиеПараметры, ДопПараметры);

		ИначеЕсли	ДопПараметры.Свойство("КлючЗаполнить") Тогда
			
			ВложениеСБИС_Заполнить(СтруктураВложения, ВходящиеПараметры, ДопПараметры.КлючЗаполнить);

		ИначеЕсли	ВходящиеПараметры.Свойство("Документ1С") Тогда
			
			// TODO переделать ПолучитьСтруктуруДокумента1СПоПакетуСбис в заполнение вложения по документу 1С
			ПараметрыИни = ВложениеСБИС_Получить(ДопПараметры.Вложение, "ПараметрыИни");
			ПараметрыЗаполнить = Новый ФиксированнаяСтруктура("Документ1С, ПараметрыИни", ВходящиеПараметры.Документ1С, ПараметрыИни);
			ВложениеСБИС_Заполнить(СтруктураВложения, ВходящиеПараметры, "ПоДокументу1С")
			
		КонецЕсли;
		
	КонецЕсли;
	
	//Заполнить основание пакета, если прокинуто в доп. параметрах
	Если		ДопПараметры.Свойство("ОснованиеПакета")
		И   Не	СтруктураВложения.Документы1С.Количество() Тогда
		
		СтруктураВложения.Документы1С.Добавить(ДопПараметры.ОснованиеПакета);
		
	КонецЕсли;
		
	Возврат СтруктураВложения;
	
КонецФункции

// Процедура - Заполнение вложения СБИС по данным прочитанного файла
//
// Параметры:
//  ВложениеСБИС	 - ВложениеСБИС	 - Структура, экземпляр вложения для заполнения
//  ДанныеЗаполнить	 - Структура	 - Данные, по которым заполнить
//
// v8unpack &НаКлиенте
Процедура НовыйВложениеСБИС_ЗаполнитьПоДокументФайл(ВложениеСБИС, ДанныеЗаполнить, ДопПараметры)
	Перем ФайлДанные, ДокументДанные, СуммаВложения, НазваниеВложения;
	
	// Определить данные для заполнения вложения
	ДокументДанные = ДанныеЗаполнить.ДокументФайл;

	Если Не	ДокументДанные.Свойство("Файл",		ФайлДанные) Тогда
		
		// Нет свойства Файл, значит Документ сам по себе является данными, берем его для формирования
		ФайлДанные = ДокументДанные;
		
	КонецЕсли;
	ДанныеЗаполнить.Вставить("ФайлДанные", ФайлДанные);
	
	// Расчитать модули и точка входа перед формированием
	ВложениеСБИС_ЗаполнитьПоДокументФайл_МодулиВложения(ВложениеСБИС,				ДанныеЗаполнить);
	ВложениеСБИС_ЗаполнитьПоДокументФайл_ТочкаВходаПередФормированием(ВложениеСБИС,	ДанныеЗаполнить);
	
	Если Не	ФайлДанные.Свойство("Документ",		ДокументДанные) Тогда
		
		// Источник для забора Дата, Номер, Сумма, Название в грязной ини
		// Для пользовательских конвертов
		ДокументДанные  = Новый Структура;
		ПолучитьЗначениеПараметраТекущегоСеанса("ОбщиеФункции").ЗаполнитьАтрибуты(
				ПолучитьТекущийЛокальныйКэш(),
				"Документ",
				ДанныеЗаполнить.ГрязныйИни,
				ДокументДанные);
		
	КонецЕсли;
	
	ДатаВложения	= ?(ДокументДанные.Свойство("Дата"),	ДокументДанные.Дата,			"");
	НомерВложения	= ?(ДокументДанные.Свойство("Номер"),	СокрЛП(ДокументДанные.Номер),	"");
	
	Если	Не ДанныеЗаполнить.Свойство	("СуммаВложения",	СуммаВложения)
		И	Не ДокументДанные.Свойство	("Сумма",			СуммаВложения) Тогда
		
		СуммаВложения = 0;
		
	КонецЕсли;	
	СуммаВложения		= Формат(СуммаВложения, "ЧЦ=17; ЧДЦ=2; ЧРД=.; ЧГ=0; ЧН=0.00");
	
	Если ДокументДанные.Свойство("Название", НазваниеВложения) Тогда
		
		НазваниеВложения = НазваниеВложения
							+ " № " +			НомерВложения
							+ " от " +			ДатаВложения
							+ " на сумму " +	СуммаВложения;
							
	Иначе
		
		НазваниеВложения	= "";
		
	КонецЕсли;
	
	ВложениеСБИС.Название				= НазваниеВложения;
	ВложениеСБИС.Дата					= ДатаВложения;
	ВложениеСБИС.Номер					= НомерВложения;
	ВложениеСБИС.Сумма					= СуммаВложения;
	ВложениеСБИС.Направление			= "Исходящий";
	ВложениеСБИС.Направление1С 			= "Исходящий";
	
	ВложениеСБИС_ЗаполнитьПоДокументФайл_РасчетныеПоля(ВложениеСБИС, ДанныеЗаполнить); 
	
	Если Не ЭтоТипСбис(ВложениеСБИС, "КонвертСБИС") Тогда
		
		// Если конверт, то сопоставления нет.
		ВложениеСБИС_ЗаполнитьПоДокументФайл_СопоставлениеНоменклатуры(ВложениеСБИС, ДанныеЗаполнить);
		ВложениеСБИС_ЗаполнитьПоДокументФайл_ОбратноеСопоставлениеНоменклатуры(ВложениеСБИС, ДанныеЗаполнить);
		
		ПропатчитьФайлВложенияСБИС(ВложениеСБИС, ДанныеЗаполнить);
		
	КонецЕсли;

	ВложениеСБИС_ЗаполнитьПоДокументФайл_ТочкаВходаПослеФормирования(ВложениеСБИС, ДанныеЗаполнить);
	
	Если ДопПараметры.Свойство("Контекст") Тогда
		
		Контекст = ДопПараметры.Контекст;
		Контекст.СоставПакета.Вложение.Добавить(ВложениеСБИС);
		
		ИмяФормыПоФормату	= "Файл_"	+ ПрименитьФорматКСтроке(ДанныеЗаполнить.ГрязныйИни.Файл_Формат,,"Убрать")
							+ "_"		+ ПрименитьФорматКСтроке(ДанныеЗаполнить.ГрязныйИни.Файл_ВерсияФормата,,"Убрать");
							
		ФормыТочки = Новый Массив;
		ФормыТочки.Добавить(ИмяФормыПоФормату);
		ФормыТочки.Добавить("Файл_Шаблон");
		
		ТочкаВходаВложение	= ПользовательскаяТочкаВхода("сбисПослеФормированияДокумента", ФормыТочки);
		Если Не ТочкаВходаВложение = Неопределено Тогда
			
			АргументыТочкиВхода = Новый Структура("Док, Кэш, Контекст", ДокументДанные, ПолучитьТекущийЛокальныйКэш(), ДопПараметры.Контекст);
			ВызватьПользовательскуюТочкуВхода(ТочкаВходаВложение, АргументыТочкиВхода);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

// Функция - формирует пустой экземпляр вложения СБИС
// 
// Возвращаемое значение:
//  Структура - объект с пустыми полями
//
// v8unpack &НаКлиенте
Функция ВложениеСБИС_Пустой()
	
	ВложениеСБИС = Новый Структура(
	"_класс, Идентификатор, Название, Направление, Направление1С, Тип, ПодТип, ВерсияФормата, ПодВерсияФормата, Дата, Номер, Сумма, Примечание,
	|Отправитель, Получатель, Ответственный, Подразделение, Регламент, ДокументОснование, Сертификат, Документы1С, Параметры, ДанныеСтруктурыФайла",
	"ВложениеСБИС", "", "", "", "", "", "", "", "", "", "", "");
	ВложениеСБИС.Отправитель			= "Отправитель";
	ВложениеСБИС.Получатель				= "Получатель";
	ВложениеСБИС.Направление			= "Входящий";
	ВложениеСБИС.Направление1С 			= "Входящий";
	ВложениеСБИС.Ответственный			= Новый Структура;
	ВложениеСБИС.Подразделение			= Новый Структура;
	ВложениеСБИС.Регламент				= Новый Структура;
	ВложениеСБИС.Сертификат				= Новый Структура;
	ВложениеСБИС.Параметры				= Новый Структура("ИспользоватьГенератор, ИспользоватьСопоставлениеНоменклатуры, НаборМодулейДляФормата, ФайлПерегенерируется", Ложь, Ложь, "", Ложь);
	ВложениеСБИС.ДанныеСтруктурыФайла	= Новый Структура("Синонимы, Поля", Новый Соответствие, Новый Соответствие);
	
	ВложениеСБИС.ДокументОснование	= Новый Массив;
	ВложениеСБИС.Документы1С		= Новый СписокЗначений;

	Возврат ВложениеСБИС;
	
КонецФункции
	
// v8unpack #КонецОбласти

// v8unpack #Область include_core2_vo2_Модуль_МодульОбъектаКлиент_Классы_ВложениеСБИС_public

// Функция - Вложение СБИС выгрузить
//
// Параметры:
//  ВложениеСБИС - ВложениеСБИС	 - структура вложения из СоставаПакета 
//  КлючВыгрузки - Структура	 - 
//  ДопПараметры - Структура	 - 
// 
// Возвращаемое значение:
// Массив - Строки табличной части документа 1С на загрузку/выгрузку
//
// v8unpack &НаКлиенте
Функция ВложениеСБИС_Выгрузить(ВложениеСБИС, КлючВыгрузки, ДопПараметры = Неопределено) Экспорт
	
	Если КлючВыгрузки = "ТабличнаяЧасть" Тогда
		
		Возврат ВложениеСБИС_Выгрузить_ТабличнаяЧасть(ВложениеСБИС, ДопПараметры);
		
	ИначеЕсли КлючВыгрузки = "ЗаписьНаБЛ" Тогда
		
		Возврат ВложениеСБИС_Выгрузить_ЗаписьНаБЛ(ВложениеСБИС, ДопПараметры);
		
	КонецЕсли;
	
КонецФункции
	
// Процедура - заполняет текущий экземпляр класса от входных данных
//
// Параметры:
//  ВложениеСБИС	 - Структура	- (О) экземпляр класса
//  ДопПараметры	 - Структура	- (О) доп. параметры заполнить
//
// v8unpack &НаКлиенте
Процедура ВложениеСБИС_Записать(ВложениеСБИС, ДопПараметры) Экспорт 
	Перем СтруктураСвойств, РежимЗаписиВложения;
	
	Если Не ДопПараметры.Свойство("СтруктураСвойств", СтруктураСвойств) Тогда
		СтруктураСвойств = Новый Структура;
	КонецЕсли;
	
	Если Не ДопПараметры.Свойство("Режим", РежимЗаписиВложения) Тогда
		РежимЗаписиВложения = "СБИС";
	КонецЕсли;
	
	Кэш				= ПолучитьТекущийЛокальныйКэш();
	СоставПакета	= ДопПараметры.СоставПакета;
	
	Если РежимЗаписиВложения = "Сопоставление" Тогда
		
		//Дополним данными пакета и вложения
		СтруктураСвойств.Вставить("ДокументСБИС_Ид",			СоставПакета.Идентификатор);
		СтруктураСвойств.Вставить("ДокументСБИС_Статус",		СоставПакета.Состояние.Название);
		СтруктураСвойств.Вставить("ДокументСБИС_ИдВложения",	ВложениеСБИС.Идентификатор);
				
	ИначеЕсли РежимЗаписиВложения = "ЗаписьСвойств" Тогда
		
		Если Не ЗначениеЗаполнено(СтруктураСвойств) Тогда
			Возврат;
		КонецЕсли;
		
	Иначе
		
		ОшибкаЗаписи = НовыйСбисИсключение(735, "МодульОбъектаКлиент.ВложениеСБИС_Записать",,, "Режим записи " + РежимЗаписиВложения + " не определен.");
		ВызватьИсключение СбисИсключение_Представление(ОшибкаЗаписи);
		
	КонецЕсли;

	ДопПараметрыАккаунта = Новый Структура("ИдАккаунта", Кэш.Интеграция.ПолучитьИдТекущегоАккаунта(Кэш));
	ФормаЗаписи = ГлавноеОкно.сбисНайтиФормуФункции("ЗаписатьПараметрыДокументаСБИС", Кэш.ФормаРаботыСоСтатусами, "", Кэш);
	
	Если ДопПараметры.Свойство("Документ1С") Тогда
		
		ФормаЗаписи.ЗаписатьПараметрыДокументаСБИС(СтруктураСвойств,
		ДопПараметры.Документ1С,
		Кэш.Ини.Конфигурация,
		Кэш.Парам.КаталогНастроек,
		ДопПараметрыАккаунта);  
		
		ВложениеСБИС_ЗаписатьСостояниеЭД(ДопПараметры.Документ1С, СоставПакета, ВложениеСБИС);
		
	Иначе
		
		Для Каждого Документ1С Из ВложениеСБИС_Получить(ВложениеСБИС, "Документы1С") Цикл
			
			ФормаЗаписи.ЗаписатьПараметрыДокументаСБИС(СтруктураСвойств,
			Документ1С,
			Кэш.Ини.Конфигурация,
			ПолучитьЗначениеПараметраСбис("КаталогНастроек"),
			ДопПараметрыАккаунта);  
			
			ВложениеСБИС_ЗаписатьСостояниеЭД(Документ1С, СоставПакета, ВложениеСБИС);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры 

// Процедура - заполняет текущий экземпляр класса от входных данных
//
// Параметры:
//  ВложениеСБИС	 - Структура	- (О) экземпляр класса
//  ДанныеЗаполнить	 - Структура	- (О) входные данные заполнить
//  КлючЗаполнить	 - Строка	 	- (Н) ключ входных данных, если это не класс (невозможно определить что за класс)
//
// v8unpack &НаКлиенте
Процедура ВложениеСБИС_Заполнить(ВложениеСБИС, ДанныеЗаполнить, КлючЗаполнить="ВложениеСБИС") Экспорт 
	Перем Документы1СВложения;
	
	Если КлючЗаполнить = "ВложениеСБИС" Тогда
		
		ВложениеСБИС_Заполнить_ПоВложениеСБИС(ВложениеСБИС, ДанныеЗаполнить);
						
	ИначеЕсли КлючЗаполнить = "Структура" Тогда
		
		СтруктураФайлаКонтрагента = ПолучитьФормуОбработки("Файл_Шаблон").НовыйСтруктураФайла(ВложениеСБИС);
		
	ИначеЕсли КлючЗаполнить = "Документ1С" Тогда
		
		Если ВложениеСБИС.Документы1С.НайтиПоЗначению(ДанныеЗаполнить) = Неопределено Тогда
			ВложениеСБИС.Документы1С.Добавить(ДанныеЗаполнить);
		КонецЕсли;
		
	ИначеЕсли КлючЗаполнить = "СопоставлениеНоменклатуры" Тогда
		
		ВложениеСБИС_Заполнить_СопоставлениеНоменклатуры(ВложениеСБИС, ДанныеЗаполнить)
		
	ИначеЕсли ВложениеСбис.Свойство("Параметры") Тогда
		
		ВложениеСБИС.Параметры.Вставить(КлючЗаполнить, ДанныеЗаполнить);
		
	Иначе
		
		ВложениеСБИС.Вставить("Параметры", Новый Структура);
		ВложениеСбис.Параметры.Вставить(КлючЗаполнить, ДанныеЗаполнить);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - заполняет текущий экземпляр класса сопоставленной номенклатурой
//
// Параметры:
//  ВложениеСБИС	 - Структура	- (О) экземпляр класса
//  ДанныеЗаполнить	 - Структура	- (О) входные данные заполнить
//		СоставПакета:		 СоставПакета 
//		ПараметрыЗаполнить:	 Структура		- заполнение результата для старой логики
//
// v8unpack &НаКлиенте
Процедура ВложениеСБИС_Заполнить_СопоставлениеНоменклатуры(ВложениеСБИС, ДанныеЗаполнить) 
	Перем ПараметрыРезультатЗаполнить;
	
	ПараметрыНоменклатуры	= ВложениеСБИС_Получить(ВложениеСБИС, "ПараметрыНоменклатуры");
	ДанныеСтруктурыФайла	= ВложениеСБИС_Получить(ВложениеСБИС, "ДанныеСтруктурыФайла");
	
	Если Не ПараметрыНоменклатуры.НадоСопоставлять Тогда
		
		Возврат;
		
	КонецЕсли;
							
	РаботаСДокументами1С = ПолучитьЗначениеПараметраТекущегоСеанса("ОбщиеФункции");
	
	Если Не ДанныеЗаполнить.Свойство("ПараметрыЗаполнить", ПараметрыРезультатЗаполнить) Тогда
		
		// Костыль, чтобы не сломать функции дальше. По факту, всё заполнение должно идти на текущее Вложение.
		ПараметрыРезультатЗаполнить = Новый Структура;
		
	КонецЕсли;
	
	СоставПакета = ДанныеЗаполнить.СоставПакета; 
	ИспользоватьНовоеСопоставление	= (ПолучитьЗначениеФичи("РасширенныйФункционалСопоставленияНоменклатуры") ИЛИ ПолучитьЗначениеФичи("РасширенныйФункционалСопоставленияНоменклатуры4100"))
									И	(	ПолучитьЗначениеПараметраСБИС("СпособСопоставленияНоменклатуры") = 0
										ИЛИ ПолучитьЗначениеПараметраСБИС("СпособСопоставленияНоменклатуры") = 1)
									И ПолучитьЗначениеПараметраСБИС("ИспользоватьНовоеСопоставлениеНоменклатуры");
	
	Если ИспользоватьНовоеСопоставление Тогда
		
		ИсходящиеПараметрыДляЗаполнить = Новый Структура("ПараметрыНоменклатуры, Результат, Вложение");
		ИсходящиеПараметрыДляЗаполнить.ПараметрыНоменклатуры	= ПараметрыНоменклатуры;
		ИсходящиеПараметрыДляЗаполнить.Результат				= ПараметрыРезультатЗаполнить;
		ИсходящиеПараметрыДляЗаполнить.Вложение					= ВложениеСБИС;
		Если ВложениеСБИС.Свойство("КлассыСопоставленияНоменклатур") Тогда
			
			РаботаСДокументами1С.РасширенныйФункционалСопоставления_ЕслиЕстьНесопоставленнаяНоменклатура(ИсходящиеПараметрыДляЗаполнить);
			
		Иначе
	
			ИсходящиеПараметрыДляЗаполнить.Вставить("СоставПакета",	СоставПакета);
			ИсходящиеПараметрыДляЗаполнить.Вставить("ПутьТаблДок",	ДанныеСтруктурыФайла.Синонимы.Получить("ТабличнаяЧасть_ПутьКДанным"));
			
			РаботаСДокументами1С.РасширенныйФункционалСопоставления_ОбработкаСопоставленияПоТаблДоку(ИсходящиеПараметрыДляЗаполнить); 
			
		КонецЕсли;
		
	Иначе
			
		ПараметрыЗаполнить = Новый Структура("СоставПакета", СоставПакета);
		Попытка
			
			ТаблДок = РаботаСДокументами1С.ЗаполнитьДанныеДляЗагрузкиПоУмолчанию_ТаблДок(ВложениеСБИС, ПараметрыЗаполнить);
			
			Если ЗначениеЗаполнено(ТаблДок) Тогда
				
				ПараметрыРезультатЗаполнить.Вставить("ТаблДок", ТаблДок);  
				
			Иначе
				
				ПараметрыНоменклатуры.НадоСопоставлять = Ложь;

			КонецЕсли;
			
		Исключение
			
			СбисИсключение = НовыйСбисИсключение(ИнформацияОбОшибке(), "МодульОбъектаКлиент.ВложениеСБИС.Заполнить.СопоставлениеНоменклатуры");
			ВызватьИсключение СбисИсключение_Представление(СбисИсключение);
			
		КонецПопытки;
		
	КонецЕсли;
	
	Если 	Не СоставПакета.Свойство("НоменклатураСопоставлена")
			Или СоставПакета.НоменклатураСопоставлена Тогда
			
		СоставПакета.Вставить("НоменклатураСопоставлена", ПараметрыНоменклатуры.Сопоставлено);
		
	КонецЕсли;
	
	ПараметрыРезультатЗаполнить.Вставить("ПутьТаблДок", 			ДанныеСтруктурыФайла.Синонимы.Получить("ТабличнаяЧасть_ПутьКДанным"));
	ПараметрыРезультатЗаполнить.Вставить("ПараметрыНоменклатуры",	ПараметрыНоменклатуры);
	
КонецПроцедуры

// Процедура - заполнить параметры перед расчетом по инишке: Входящий контекст + ручные изменения в объект
//
// Параметры:
//  ВложениеСБИС - ВложениеСБИС	 - Структура с описанием обрабатываемого вложения
//  ДопПараметры - Структура/ФиксированнаяСтруктура	 - расширение метода
//
// v8unpack &НаКлиенте
Процедура ВложениеСБИС_ЗаполнитьПараметрыПередРасчетом(ВложениеСБИС, ДопПараметры = Неопределено) Экспорт
    Перем ВходящийКонтекстИни, ДополнительныеПоляКонтекста, РассчитываемыйОбъект, ЗаполнитьКонтекст;
	
	Если Не ДопПараметры = Неопределено Тогда
		
		ДопПараметры.Свойство("ПоляРассчета",			ДополнительныеПоляКонтекста);
		ДопПараметры.Свойство("РассчитываемыйОбъект",	РассчитываемыйОбъект);
		ДопПараметры.Свойство("ЗаполнитьКонтекст",		ЗаполнитьКонтекст);
		
	КонецЕсли;
	
	ОчиститьТекущий		= Истина;
	ЗаполнитьКонтекст	= (ЗаполнитьКонтекст = Истина);
	
	Если Не ВложениеСБИС.Свойство("ВходящийКонтекст", ВходящийКонтекстИни) Тогда

		ВложениеСБИС.Вставить("ВходящийКонтекст", Новый Структура("РассчитанноеЗначение", Новый Структура));
		ЗаполнитьКонтекст = Истина;
		
	КонецЕсли;
	
	Если ЗаполнитьКонтекст Тогда
		
		ВложениеСБИС_ЗаполнитьПараметрыПередРасчетом_ВходящийКонтекст(ВложениеСБИС);
		
		ДанныеСторон = СоставПакета_Получить(ДопПараметры.СоставПакета, "ДанныеСторон");
		
		// Прокинуть данные сторон от пакета до вложения во входящий контекст, чтобы их можно было взять инишкой
		Если	ЗначениеЗаполнено(ДанныеСторон)
			И	ДоступнаПодстановкаСторонИзПакета(ДопПараметры.СоставПакета) Тогда
			
			ДанныеСторонДляДокумента1С	= Новый Структура;
			ДанныеДляПодготовки			= Новый Структура("ДанныеСторонСБИС, ДанныеСторон1С", ДанныеСторон, ДанныеСторонДляДокумента1С);
			ДопПараметрыПодготовки		= Новый Структура("ЕстьПартнеры", ИниПоПараметрам("Конфигурация").Свойство("Партнеры"));
			
			ПодготовитьСтороныКЗагрузкеДокумента(ДанныеДляПодготовки, ДопПараметрыПодготовки);
			
			ВложениеСБИС.ВходящийКонтекст.РассчитанноеЗначение.Вставить("ОрганизацияПоПакету",		ДанныеСторон.ДанныеОрганизации.Ссылка); 
			ВложениеСБИС.ВходящийКонтекст.РассчитанноеЗначение.Вставить("КонтрагентПоПакету",		ДанныеСторонДляДокумента1С.ДанныеКонтрагента); 
			ВложениеСБИС.ВходящийКонтекст.РассчитанноеЗначение.Вставить("ГрузополучательПоПакету",	ДанныеСторонДляДокумента1С.ДанныеГрузополучателя); 
			ВложениеСБИС.ВходящийКонтекст.РассчитанноеЗначение.Вставить("Партнер",					ДанныеСторонДляДокумента1С.ДанныеПартнера);
		
		КонецЕсли;
		
	КонецЕсли; 
	
	Если Не ДополнительныеПоляКонтекста = Неопределено Тогда
		
		Для Каждого КлючИЗначениеПолей Из ДополнительныеПоляКонтекста Цикл
			
			ВложениеСБИС.ВходящийКонтекст.РассчитанноеЗначение.Вставить(КлючИЗначениеПолей.Ключ, КлючИЗначениеПолей.Значение);
			
		КонецЦикла;
		
	КонецЕсли;	
	
	ВложениеСБИС_ЗаполнитьПараметрыПередРасчетом_РучныеПравки(ВложениеСБИС, РассчитываемыйОбъект);
	
КонецПроцедуры

// Функция - проверяет возможность загрузки вложения в 1С
//
// Параметры:
//  ВложениеСБИС - ВложениеСБИС				 - структура текущего вложения
//  ДопПараметры - Струкутра/Неопределено	 - структура, расширение
// 
// Возвращаемое значение:
//  Структура - описание, можем ли загрузить или нет.
//
// v8unpack &НаКлиенте
Функция ВложениеСБИС_МожемЗагрузитьВ1С(ВложениеСБИС, ДопПараметры = Неопределено) Экспорт
	
	Результат = Новый Структура("МожноЗагрузить, Проблемы, Статус", Ложь, Новый Структура, "");

	СтруктураИниФайла		= ВложениеСБИС_Получить(ВложениеСБИС, "УстановленныйПодразделИни");
	ДанныеФайла				= ВложениеСБИС_Получить(ВложениеСБИС, "СтруктураФайла");
	СтатусВложения			= ВложениеСБИС_Получить(ВложениеСБИС, "Статус");
	
	Если	СтатусВложения = "НеПоддерживается"  Тогда
		
		Результат.Статус = "Загрузка документа не поддерживается.";
		
	ИначеЕсли СтатусВложения = "Ошибка" Тогда
		
		Результат.Статус = "Ошибка разбора документа.";
		
	ИначеЕсли СтатусВложения = "Разобран" Тогда

		Результат.МожноЗагрузить = Истина;
		
		ПараметрыНоменклатуры	   = ВложениеСБИС_Получить(ВложениеСБИС, "ПараметрыНоменклатуры");
		Поля1С					   = ВложениеСбис_Получить(ВложениеСБИС, "Поля1С");
		ОрганизацияВложения		   = Поля1С.Организация.Значение;
		КонтрагентВложения		   = Поля1С.Контрагент.Значение; 
		ДанныеСтруктурыФайла       = ВложениеСБИС_Получить(ВложениеСБИС, "ДанныеСтруктурыФайла");
		РольОрганизацияВложения    = ДанныеСтруктурыФайла.Синонимы.Получить("Организация");
		РольКонтрагентВложения     = ДанныеСтруктурыФайла.Синонимы.Получить("Контрагент");
		РольСопоставлениеВложения  = ДанныеСтруктурыФайла.Синонимы.Получить("Сопоставление");
		
		Если НЕ ЗначениеЗаполнено(ОрганизацияВложения) ИЛИ ОрганизацияВложения = Ложь Тогда
			
			СтатусОрганизация = ""; 
			
			Если РольОрганизацияВложения = "" Тогда
				СтатусОрганизация = "Организация не заполняется";
			ИначеЕсли РольОрганизацияВложения = Неопределено Тогда
				СтатусОрганизация = "Нет роли организации";
			Иначе			
				ПараметрыИни = ВложениеСБИС_Получить(ВложениеСБИС, "ПараметрыИни");
				
				// Для исходящих документов статус организации пока отключен.
				Если НЕ ПараметрыИни.Направление = "Исходящий" Тогда
					
					СтатусОрганизация	= "Не найдена организация.";
					Результат.Проблемы.Вставить("Организация", СтатусОрганизация);
				КонецЕсли;					
			КонецЕсли;
			
			Если НЕ СтатусОрганизация = "" Тогда
				Результат.Статус = СокрЛП(Результат.Статус + " " + СтатусОрганизация);
			КонецЕсли; 
			
		КонецЕсли;
		
		Если НЕ	ЗначениеЗаполнено(КонтрагентВложения) ИЛИ КонтрагентВложения = Ложь Тогда 		
			
			СтатусКонтрагент = "";
			
			Если РольКонтрагентВложения = "" Тогда
				
				СтатусКонтрагент = "Контрагент не заполняется"; 
				
			ИначеЕсли РольКонтрагентВложения = Неопределено Тогда 
				
				СтатусКонтрагент = "Нет роли контрагента";	
				
			Иначе			          
				
				СтатусКонтрагент = "Не найден контрагент.";
				Результат.Проблемы.Вставить("Контрагент", СтатусКонтрагент);
				
			КонецЕсли;
			
			Если НЕ СтатусКонтрагент = "" Тогда  
				
				Результат.Статус = СокрЛП(Результат.Статус + " " + СтатусКонтрагент); 
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ПараметрыНоменклатуры.НадоСопоставлять Тогда
			
			Если ПараметрыНоменклатуры.Сопоставлено Тогда
				
				СтатусНоменклатура = "Номенклатура сопоставлена.";	
				
			ИначеЕсли РольСопоставлениеВложения = Неопределено Тогда
				
				СтатусНоменклатура = "Сопоставление не требуется.";	
				
			ИначеЕсли РольСопоставлениеВложения = "" Тогда
				
				СтатусНоменклатура = "Сопоставление номенклатуры отключено.";				
				
			Иначе
				
				СтатусНоменклатура = "Не вся номенклатура сопоставлена.";
				Результат.Проблемы.Вставить("Номенклатура", СтатусНоменклатура);
				
			КонецЕсли;
			
		Иначе
					
			СтатусНоменклатура = "Сопоставление не требуется.";
			
		КонецЕсли;
		
		Результат.Статус = СокрЛ(Результат.Статус + " " + СтатусНоменклатура);
		
	Иначе
		
		Результат.Статус = "Документ не разобран.";
		
	КонецЕсли;
		
	Возврат Результат;
	
КонецФункции
	
// Процедура - обновляет вложение СБИС по новым данным
//
// Параметры:
//  ВложениеСБИС - ВложениеСБИС	 - структура вложения
//  Изменения	 - Струкутра	 - с изменениями
//  ДопПараметры - Структура	 - расширение
//
// v8unpack &НаКлиенте
Процедура ВложениеСБИС_Обновить(ВложениеСБИС, Изменения, ДопПараметры = Неопределено) Экспорт
	Перем ТекущиеИзменения;
	
	Если ТипЗнч(Изменения) = Тип("Файл") Тогда
		
		ВложениеСБИС.Вставить("ИмяФайла",		Изменения.Имя);
		ВложениеСБИС.Вставить("ПолноеИмяФайла",	Изменения.ПолноеИмя);
	
	ИначеЕсли	Изменения.Свойство("Номенклатура", ТекущиеИзменения) Тогда
		
		ВложениеСБИС_Обновить_Номенклатура(ВложениеСБИС, ТекущиеИзменения);
		ВложениеСБИС.Вставить("Перегенерировать", Истина);
		
	ИначеЕсли	Изменения.Свойство("Статус", ТекущиеИзменения) Тогда 
		
		ВложениеСБИС_Обновить_Статус(ВложениеСБИС, ТекущиеИзменения, ДопПараметры);
		
	ИначеЕсли Изменения.Свойство("ПодразделИни", ТекущиеИзменения) Тогда
		
		ВложениеСБИС_Обновить_ПодразделИни(ВложениеСБИС, ТекущиеИзменения, ДопПараметры);

	ИначеЕсли Изменения.Свойство("Поля1С") Тогда
		
		ВложениеСБИС_Обновить_Поля1С(ВложениеСБИС, Изменения, ДопПараметры);
		
	ИначеЕсли	Изменения.Свойство("СтрокаФормыПросмотра", ТекущиеИзменения) Тогда
		
		ВложениеСБИС.Параметры.Вставить("МожемЗагрузитьВ1С", Булево(ТекущиеИзменения.МожемЗагрузитьВ1С));
		
	ИначеЕсли	Изменения.Свойство("Организация")
		ИЛИ		Изменения.Свойство("Контрагент")
		ИЛИ		Изменения.Свойство("Грузополучатель") Тогда
		
		ВложениеСБИС_Обновить_Сторона(ВложениеСБИС, Изменения);
		
	ИначеЕсли Изменения.Свойство("ПеречитатьВизуализацию") Тогда
		
		ВложениеСБИС.Удалить("ТекстHTML");
		
		Визуализация = ВложениеСБИС_Получить(ВложениеСБИС, "ВизуализацияДокумента");
		ДанныеЗаполнить = Новый Структура("ТекстHTML", Визуализация);
		
		ВложениеСБИС_Заполнить(ВложениеСБИС, ДанныеЗаполнить);
		
	ИначеЕсли Изменения.Свойство("ПараметрыДокумента", ТекущиеИзменения) Тогда	
		
		ВложениеСБИС_Обновить_ПараметрыДокумента(ВложениеСБИС, ТекущиеИзменения);
		ВложениеСБИС.Вставить("Перегенерировать", Истина);
		
	ИначеЕсли Изменения.Свойство("Подпись", ТекущиеИзменения) Тогда	
		
		ВложениеСБИС.Вставить("Подпись", ТекущиеИзменения);  
		
	ИначеЕсли Изменения.Свойство("ТабличныеДанные") Тогда   
		
		ВложениеСБИС_ОбновитьТабличныеДанные(ВложениеСБИС, Изменения);
        
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - читает данные XML вложения, приводит к объекту 1С. Заполняет поля:
//		XMLДокумента				 - Строка		 - прочитанные исходные данные титула вложения
//		СтруктураФайла				 - Структура	 - приведенные к известному формату (3.01/3.03) данные XML и разложенные парсером
//		ВерсияФорматаДляЗагрузки	 - Строка		 - значение ВерсияФормата из СтруктураФайла
//		ФорматДляЗагрузки			 - Строка    	 - значение Формат из СтруктураФайла
//
// Параметры:
//  ВложениеСБИС - ВложениеСБИС	 - экземпляр класса вложения
//  ДопПараметры - Структура	 -расширение. Возможные поля:
//		СоставПакета - СоставПакета - основной документ СБИС, к которому принадлежит вложение
//
// v8unpack &НаКлиенте
Процедура ВложениеСБИС_ПрочитатьДанные(ВложениеСБИС, ДопПараметры) Экспорт
	Перем Файл_Формат, Файл_ВерсияФормата;
	
	Если ВложениеСБИС.Свойство("XMLДокумента") Тогда
		
		// Уже прочитано
		Возврат;
		
	КонецЕсли;
	
	ВложениеСБИС.Вставить("XMLДокумента", "");
	
	ПараметрыОписаниеИни	= ВложениеСБИС_Получить(ВложениеСБИС, "ПараметрыИни");
	Если Не ЗначениеЗаполнено(ПараметрыОписаниеИни.Тип) Тогда
		// Это неформалка, заполняем в тип = "неформатноеВложение"
		ВложениеСБИС.Вставить("Тип", "НеформатноеВложение");
		// Это документ, который точно не умеем грузить, пропускаем.
		Возврат;
		
	КонецЕсли;
	
	ФайлВложение		= ВложениеСБИС_Получить(ВложениеСБИС, "Файл");
	ИнтеграцияМодуль	= ПолучитьЗначениеПараметраСбис("Интеграция");
	СбисОбщиеФункции	= ПолучитьЗначениеПараметраСбис("ФункцииДокументов");
	Кэш					= ПолучитьТекущийЛокальныйКэш();
	ПолныйСоставПакета	= ДопПараметры.СоставПакета;
	
	XMLИсходногоФайла	= ВложениеСБИС_Получить(ВложениеСБИС, "ДанныеФайла");
	XMLФайла			= ВырезатьИсключенияXMLВложения(XMLИсходногоФайла);
	
	ЕстьXSLT	= Ложь;
	ИмяXSLT		= "";
	
	Файл_Формат			= СбисОбщиеФункции.сбисЗаменитьНедопустимыеСимволы(ВложениеСБИС.Тип);
	ПодТип				= СбисОбщиеФункции.сбисЗаменитьНедопустимыеСимволы(ВложениеСБИС.ПодТип);
	Файл_ВерсияФормата	= СбисОбщиеФункции.сбисЗаменитьНедопустимыеСимволы(ВложениеСБИС.ВерсияФормата);		
	СтруктураФайла		= Новый Структура;
	
	Если ЗначениеЗаполнено(Файл_Формат) и ЗначениеЗаполнено(XMLФайла) Тогда
		ИмяXSLT	= СбисОбщиеФункции.СбисФорматСтроки(Файл_Формат + "_" + ПодТип + "_" + Файл_ВерсияФормата, "КлючСтруктуры");
		ЕстьXSLT = ЗначениеЗаполнено(XSLTПоПараметрам(ИмяXSLT));
		
		ОшибкаПреобразования= Ложь;
		ДопПараметрыXSLT	= Неопределено;
		Если Кэш.Парам.РежимОтладки Тогда
			
			ДопПараметрыXSLT = Новый Структура;
			ДопПараметрыXSLT.Вставить("Название", СбисОбщиеФункции.сбисФорматКаталога("Загрузка", Кэш.ПараметрыСистемы.Клиент));
			
			Если ПолныйСоставПакета.Свойство("Название") Тогда
				
				ДопПараметрыXSLT.Название = ПрименитьФорматКСтроке(ДопПараметрыXSLT.Название, ПолныйСоставПакета.Название, "Каталог");
				
			КонецЕсли;
			
		КонецЕсли;
		
		XMLФайла = СбисОбщиеФункции.сбисПрименитьXSLT(Кэш, XMLФайла, ИмяXSLT, ДопПараметрыXSLT, ОшибкаПреобразования);
		
		Если ОшибкаПреобразования Тогда
			
			Кэш.ГлавноеОкно.сбисСообщитьОбОшибке(Кэш, XMLФайла);
			XMLФайла = "";
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Файл_ВерсияФормата) Тогда
			
			ВложениеСБИС.XMLДокумента = XMLИсходногоФайла;
			
		КонецЕсли;
		
		СтруктураФайла	= СбисОбщиеФункции.ЗаполнитьСтруктуруФайла(XMLФайла);
		
	Иначе
		
		XMLФайла= "";
		
	КонецЕсли;
	
	//Пробуем преобразовать XML только если он есть, дабы избежать лишних вызовов сервера
	ВложениеСБИС.Вставить("СтруктураФайла", СтруктураФайла);
	Если	ЕстьXSLT 
		И	СтруктураФайла.Свойство("Файл")
		И	СтруктураФайла.Файл.Свойство("Формат")
		И	СтруктураФайла.Файл.Свойство("ВерсияФормата") Тогда
		
		Файл_Формат			= СбисОбщиеФункции.сбисЗаменитьНедопустимыеСимволы(СтруктураФайла.Файл.Формат);
		Файл_ВерсияФормата	= СбисОбщиеФункции.сбисЗаменитьНедопустимыеСимволы(СтруктураФайла.Файл.ВерсияФормата);
		
	ИначеЕсли ЗначениеЗаполнено(XMLФайла) Тогда	// XMLФайла может быть пустым, если вложение не удалось расшифровать
		
		Файл_Формат			= СбисОбщиеФункции.сбисЗаменитьНедопустимыеСимволы(ВложениеСБИС.Тип);
		Файл_ВерсияФормата	= СбисОбщиеФункции.сбисЗаменитьНедопустимыеСимволы(ВложениеСБИС.ВерсияФормата);
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	ВложениеСБИС.Вставить("ФорматДляЗагрузки",			Файл_Формат);
	ВложениеСБИС.Вставить("ВерсияФорматаДляЗагрузки",	Файл_ВерсияФормата);
	
КонецПроцедуры

//Функция возвращает разобрынные данные вложения XMLДокумента, СтруктураФайла, ФорматДляЗагрузки, ВерсияФорматаДляЗагрузки
//
// Параметры:
//  ВложениеСБИС - ВложениеСБИС	 - Структура, описывает вложение в Документ СБИС
//  ДопПараметры - Структура	 - параметры расширения
//		СоставПакета	- ДокументСБИС, к которому относится вложение.
//		Просмотр		- булево (Ложь), определяет необходимость определения полей для редактирования, типов и всего необходимого для интерфейса
//
// v8unpack &НаКлиенте
Процедура ВложениеСБИС_РазобратьДляЗагрузки(ВложениеСБИС, ДопПараметры) Экспорт
	Перем ПоляВходящегоКонтекста;
	
	СтатусВложения = ВложениеСБИС_Получить(ВложениеСБИС, "Статус");
	Если СтатусВложения = "Ошибка" Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если Не ВложениеСБИС.Свойство("Параметры") Тогда
		
		ПараметрыВложения = Новый Структура;
		ПараметрыВложения.Вставить("Просмотр",						Ложь); // Документ формируется для формы просмотра
		ПараметрыВложения.Вставить("ВозможноРедактироватьДокумент", Ложь); // В ини установлена возможность редактировать документ (не перезаполняя его)
		ПараметрыВложения.Вставить("РедактироватьТабЧасть",			Ложь); // Установлена возможность редактировать табличную часть (не перезаполняя)
		ПараметрыВложения.Вставить("РедактироватьДокумент",			Ложь); // Установлен документ в редактируемых полях и есть возможность редактировать
		ПараметрыВложения.Вставить("ПодборДокументаДляЗаполнения",	Ложь); // Сопоствлять ли документ перед загрузкой, или нет.
		ВложениеСБИС.Вставить("Параметры", ПараметрыВложения);
		
	КонецЕсли;
	
	Если	ДопПараметры.Свойство("Просмотр")  Тогда
		
		ВложениеСБИС.Параметры.Просмотр = ДопПараметры.Просмотр;
		
	КонецЕсли;
	
	Попытка
		
		ВложениеСБИС_ПрочитатьДанные(ВложениеСБИС, ДопПараметры);
		ВложениеСБИС_УстановитьИниЗагрузки(ВложениеСБИС, ДопПараметры);
		
	Исключение
		
		ОшибкаРазбора = НовыйСбисИсключение(ИнформацияОбОшибке(), "МодульОбъектаКлиент.ВложениеСБИС_РазобратьДляЗагрузки");
		ВложениеСБИС_Обновить(ВложениеСБИС, Новый ФиксированнаяСтруктура("Статус", ОшибкаРазбора));
		Возврат;
		
	КонецПопытки;
	
КонецПроцедуры

// Функция - получить значение по ключу от вложения
//
// Параметры:
//  ВложениеСбис			 - ВложениеСБИС	 - экземпляр, от которого надо получить значение
//  КлючПараметраПолучить	 - Строка		 - что хотим получить ПараметрыДанныхВложения, УстановленныйПодразделИни
//  ДопПараметры			 - Структура	 - Расширение
// 
// Возвращаемое значение:
//  Произвольный - Найденное значение. Неопределено, если ничего
//
// v8unpack &НаКлиенте
Функция ВложениеСБИС_Получить(ВложениеСбис, КлючПараметраПолучить, ДопПараметры = Неопределено) Экспорт
	Перем Результат, лПромежуточноеЗначение;
	
	Если		КлючПараметраПолучить = "ПараметрыИни"
			Или	КлючПараметраПолучить = "ПараметрыДанныхВложения" Тогда
		
		Возврат ВложениеСБИС_Получить_ПараметрыИни(ВложениеСБИС, ДопПараметры);
			
	ИначеЕсли КлючПараметраПолучить = "СтруктураФайла" Тогда
		
		// Считаем структурой файла структуру документа по данным 1С.
		Если	Не ВложениеСбис.Свойство("СтруктураФайла",		Результат)
			И	Не ВложениеСбис.Свойство("СтруктураДокумента",	Результат) Тогда 
			
			Возврат Неопределено;
			
		КонецЕсли;
		
	ИначеЕсли	КлючПараметраПолучить = "Название" Тогда
		
		Если Не ВложениеСбис.Свойство("Название", Результат) Тогда 
			
			СтруктураФайла = ВложениеСБИС_Получить(ВложениеСбис, "СтруктураФайла");
			Если Не СтруктураФайла = Неопределено Тогда
			
				Результат = Результат.Файл.Имя;
				
			Иначе
				
				Результат = "";
				
			КонецЕсли;
			
		КонецЕсли;
		
	ИначеЕсли	КлючПараметраПолучить = "Идентификатор" Тогда
		
		Если	Не ВложениеСбис.Свойство("Идентификатор", Результат)
			Или	Не ЗначениеЗаполнено(Результат) Тогда 
			
			Результат = ВложениеСБИС_Получить(ВложениеСбис, "Название");
			
        КонецЕсли;

	ИначеЕсли	КлючПараметраПолучить = "ТипВерсияВложения" Тогда

		//Если ЗначениеЗаполнено(ВложениеСБИС_Получить(ВложениеСбис, "XMLДокумента")) Тогда
			
			ПараметрыИни	= ВложениеСБИС_Получить(ВложениеСбис, "ПараметрыИни");
			Результат		= ПараметрыИни.Тип + "_" + ПараметрыИни.Версия;
			Результат		= СтрЗаменить(Результат, ".", "_");
			
		//КонецЕсли;
 
	ИначеЕсли	КлючПараметраПолучить = "ФайлИни" Тогда
		
		//Возвращает полную инишку для обработки вложения
		ИмяУстановленнойИни = ВложениеСБИС_Получить(ВложениеСБИС, "ИмяИни");
		
		Если ИмяУстановленнойИни = Неопределено Тогда
			
			Возврат ИниПоПараметрам(Новый Структура("Вложение", ВложениеСБИС));
			
		КонецЕсли;
		
		Возврат ИниПоПараметрам(ИмяУстановленнойИни);

	ИначеЕсли	КлючПараметраПолучить = "УстановленныйПодразделИни"
			Или	КлючПараметраПолучить = "СтруктураИниФайла" Тогда
		
		//Возвращает подраздел инишки вложения, который на текущий момент установлен для обработки
		ВложениеСбис.Свойство("СтруктураИниФайла", Результат);

	ИначеЕсли	КлючПараметраПолучить = "ПодходящийДокумент" Тогда
		
		// Возвращает подходищий по данным и установленному подразделу инишки документ
		Возврат ВложениеСБИС_ПодходящийДокумент(ВложениеСбис, ДопПараметры);
						
	ИначеЕсли	КлючПараметраПолучить = "Зашифрован" Тогда
		
		ВложениеСбис.Свойство("Зашифрован", Результат);
		Возврат Результат = "Да"
			Или	Результат = Истина;
		
	ИначеЕсли	КлючПараметраПолучить = "Зашировать" Тогда
		// Признак применения шифрования при формирования подготовки к отпраке
		
		ВыборочноеШифрование	= ПолучитьЗначениеПараметраСбис("ШифроватьВыборочно");
		ВыборочноеШифрование	=	Не	ВыборочноеШифрование
								Или (	ВыборочноеШифрование
									И	ВложениеСбис.Свойство("Шифрование", Результат)
									И	Результат = Истина);
		Возврат ПолучитьЗначениеПараметраСбис("Шифрование")
			И	ВыборочноеШифрование;

	ИначеЕсли	КлючПараметраПолучить = "ДанныеФайла" Тогда
		
		Возврат ВложениеСБИС_ДанныеФайла(ВложениеСбис);
		
	ИначеЕсли	КлючПараметраПолучить = "СторонаПоРоли" Тогда
		
		Возврат ВложениеСБИС_СторонаПоРоли(ВложениеСбис, ДопПараметры);
		
	ИначеЕсли	КлючПараметраПолучить = "Поля1С" Тогда
		
		Возврат ВложениеСБИС_Получить_Поля1С(ВложениеСбис, ДопПараметры);
		
	ИначеЕсли	КлючПараметраПолучить = "РассчитанныйОбъект" Тогда
		
		Возврат ВложениеСБИС_РассчитанныйОбъект(ВложениеСбис, ДопПараметры);
		
	ИначеЕсли	КлючПараметраПолучить = "ТипОбъекта" Тогда
		
		Возврат ВложениеСБИС_Получить_ТипОбъекта(ВложениеСбис, ДопПараметры);

	ИначеЕсли	КлючПараметраПолучить = "Статус" Тогда
		
		Возврат ВложениеСБИС_Получить(ВложениеСбис, "СтатусыВложения").Общий;
		
	ИначеЕсли КлючПараметраПолучить = "Модифицирован" Тогда
		
		Если НЕ ВложениеСбис.Свойство(КлючПараметраПолучить, Результат) Тогда
			Результат = Ложь;
		КонецЕсли;
		
	ИначеЕсли	КлючПараметраПолучить = "ТипВложения" Тогда 			

		СтруктураФайла = ВложениеСБИС_Получить(ВложениеСбис, "СтруктураФайла");	   
		
		Если ЗначениеЗаполнено(СтруктураФайла) Тогда
			
			// Пока как костыль берем формат от структуры файла, если по какой-то причине не заполнено на вложении. 
			Результат = СтруктураФайла.Файл.Формат;
			
		Иначе
			
			Результат = ПрименитьФорматКСтроке(ВложениеСбис.Тип, "-", "убрать");
			
		КонецЕсли;
				
	ИначеЕсли	КлючПараметраПолучить = "СтруктураРучныхПравок" Тогда
		
		Результат = Новый Структура;
		Если ВложениеСбис.Параметры.Свойство("РедактируемыеПоля") Тогда
			
			Для Каждого РучноеПоле Из ВложениеСбис.Параметры.РедактируемыеПоля Цикл
				
				Если	    РучноеПоле.Значение = Неопределено
					Или	Не	РучноеПоле.Значение.Свойство("Путь")
					Или		РучноеПоле.Значение.Путь = Неопределено Тогда
					
					Продолжить;
					
				КонецЕсли;
				
				Результат.Вставить(РучноеПоле.Значение.Путь, РучноеПоле.Значение.Значение);
				
			КонецЦикла;
			
		КонецЕсли;

	ИначеЕсли	КлючПараметраПолучить = "ТекстHTML"
			Или	КлючПараметраПолучить = "ВизуализацияДокумента" Тогда
			
		Возврат ВложениеСБИС_Получить_ВизуализацияДокумента(ВложениеСБИС, ДопПараметры);	
			
	ИначеЕсли КлючПараметраПолучить = "ОбновитьВизуализацию" Тогда
		
		Если НЕ ВложениеСбис.Свойство(КлючПараметраПолучить, Результат) Тогда
			Результат = Ложь;
		КонецЕсли;
		
	ИначеЕсли КлючПараметраПолучить = "ПараметрыНоменклатуры" Тогда
		
		ПараметрыВложения = ВложениеСБИС_Получить(ВложениеСБИС, "Параметры");
		Если		ПараметрыВложения = Неопределено
			Или	Не	ПараметрыВложения.Свойство("Номенклатура", Результат)Тогда
			
			Возврат Неопределено;
			
		КонецЕсли;

	ИначеЕсли КлючПараметраПолучить = "Подписи" Тогда
		
		Если Не ВложениеСбис.Свойство("Подпись", Результат) Тогда
			
			Результат = Новый Массив;
			
		КонецЕсли;

	ИначеЕсли КлючПараметраПолучить = "ДанныеСтруктурыФайла" Тогда
		
		Если Не ВложениеСбис.Свойство(КлючПараметраПолучить, Результат) Тогда

			Результат = Новый Структура("Синонимы, Поля", Новый Соответствие, Новый Соответствие); 
			ВложениеСБИС.Вставить("ДанныеСтруктурыФайла", Результат);
			
		КонецЕсли;
		
	ИначеЕсли КлючПараметраПолучить = "СтатусыВложения" Тогда
		
		Если Не ВложениеСбис.Свойство(КлючПараметраПолучить, Результат) Тогда
			
			Результат = Новый Структура("Общий, Заголовок");
			ВложениеСБИС.Вставить("СтатусыВложения", Результат);
			
		КонецЕсли;

	Иначе
		
		ВложениеСбис.Свойство(КлючПараметраПолучить, Результат);
		
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

// Процедура - патчит новое сопоставление на выбранное вложение
//
// Параметры:
//  Вложение	 - ВложениеСБИС	 - структура вложения, которое патчится
//  ДопПараметры - Структура	 - расширение
//
// v8unpack &НаКлиенте
Процедура ВложениеСБИС_ПропатчитьНовымСопоставлением(Вложение, ДопПараметры = Неопределено) Экспорт		
	
	МестныйКэш = ПолучитьТекущийЛокальныйКэш();							
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	Если Вложение.Свойство("КлассыСопоставленияНоменклатур") 
		И Вложение.Параметры.НоменклатураСопоставлена Тогда
		НаборСопоставлений = Вложение.КлассыСопоставленияНоменклатур;
	Иначе
		// 1. Получим ТаблДоки в исходном виде из вложений и сформируем от них набор классов сопоставления номенклатуры. 
		// По возможности попытаемся их обогатить через "Массовый поиск"
		///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
		ФормыПоиска = Новый Массив;
		ФормыПоиска.Добавить("Файл_Шаблон");
		
		фрм = НайтиФункциюСеансаОбработки("СформироватьНаборСопоставленийНоменклатурыПоТабличнойЧасти", ФормыПоиска);
		
		Если НЕ фрм = Ложь Тогда  
			НаборСопоставлений = фрм.СформироватьНаборСопоставленийНоменклатурыПоТабличнойЧасти(Вложение, МестныйКэш, ДопПараметры);
		Иначе
			ВызватьСбисИсключение(, "МодульОбъектаКлиент.ПропатчитьВложенияНовымСопоставлением",,,"Не найдена форма работы с форматом документа");
		КонецЕсли;
		
		Если МодульОбъектаКлиент().ПолучитьЗначениеПараметраСбис("РежимОтладки") Тогда
			
			ДанныеЛогирования = Новый Структура;
			ДанныеЛогирования.Вставить("Тип", 			"СопоставлениеНоменклатуры");
			ДанныеЛогирования.Вставить("Идентификатор", МодульОбъектаКлиент().ВложениеСБИС_Получить(Вложение, "Название"));
			ДанныеЛогирования.Вставить("Вызов", 		НаборСопоставлений);
			ДанныеЛогирования.Вставить("Модуль", 		"Файл_Шаблон");
			
			МодульОбъектаКлиент().СохранитьОтладочныеДанныеСБИС(ДанныеЛогирования);
			
		КонецЕсли;
		
	КонецЕсли;   
	
	// 2. В полученных классах произведем пересчет по коэффициенту единиц измерения
	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	Если (ДопПараметры.Свойство("КонтекстДляСопоставления") 
		И ДопПараметры.КонтекстДляСопоставления.Свойство("ПересчетПоДокументуОснованию")) 
		ИЛИ ДопПараметры.Свойство("ПересчетПоДокументуОснованию") Тогда
		МестныйКэш.ОбщиеФункции.ПересчетПоКоэффициентамЕдиницИзмерения(НаборСопоставлений, "Выгрузка");	
	Иначе	
		МестныйКэш.ОбщиеФункции.ПересчетПоКоэффициентамЕдиницИзмерения(НаборСопоставлений, "Загрузка");
		МестныйКэш.ОбщиеФункции.ПересчетНДСПоДаннымСтрокиСопоставления(НаборСопоставлений);
	КонецЕсли;
	
	Вложение.Вставить("КлассыСопоставленияНоменклатур", НаборСопоставлений); 
	НоменклатураСопоставлена = СопоставлениеНоменклатуры_ВсеНоменклатурыСопоставлены(НаборСопоставлений);
	Вложение.Параметры.Вставить("НоменклатураСопоставлена", НоменклатураСопоставлена);
	// 3. Обновленные данные выгрузим в ТаблДок и запишем его на вложение.
	////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
	ТаблДокНаОсновеКлассов = ВложениеСБИС_Выгрузить(Вложение, "ТабличнаяЧасть", ДопПараметры);
	
	Если Не ТаблДокНаОсновеКлассов.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Если Вложение.Свойство("СтруктураФайла") Тогда
		Вложение.СтруктураФайла.Файл.Документ.ТаблДок.Вставить("СтрТабл", ТаблДокНаОсновеКлассов);
	ИначеЕсли Вложение.СтруктураДокумента.Файл.Документ.Свойство("ТаблДок") Тогда
		Вложение.СтруктураДокумента.Файл.Документ.ТаблДок.Вставить("СтрТабл", ТаблДокНаОсновеКлассов);
	Иначе
		Вложение.СтруктураДокумента.Файл.Документ.СписокСтрТабл.Вставить("СтрТабл", ТаблДокНаОсновеКлассов);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - удаляет выбранные узлы из структуры данных (разобранные данные файла, или прочитанные данные документа)
//
// Параметры:
//  ВложениеСБИС - ВложениеСБИС	 - Структура, вложение в которое устанавливаем параметры
//  УдаляемыеУзлы - Массив	 - Путь к удаляемым узлам в виде строки, через "."
//
// v8unpack &НаКлиенте
Процедура ВложениеСБИС_УдалитьУзлыИзСтруктурыДанных(ВложениеСБИС, УдаляемыеУзлы) Экспорт 
	
	ДанныеОчистить = МодульОбъектаКлиент().ВложениеСБИС_Получить(ВложениеСБИС, "СтруктураФайла");
	Если ДанныеОчистить = Неопределено Тогда 
		Возврат;
	КонецЕсли;
	
	МодульФункции = ПолучитьЗначениеПараметраСбис("ФункцииДокументов");
	// Удаление лишнего
	Для Каждого ПутьУзла Из УдаляемыеУзлы Цикл
		
		РазобранныйПутьУзла = Новый СписокЗначений;
		РазобранныйПутьУзла.ЗагрузитьЗначения(МодульФункции.РазбитьСтрокуВМассивНаКлиенте(ПутьУзла, "."));
		
		УдалитьУзелИзСтруктурыДанных(ДанныеОчистить, РазобранныйПутьУзла);

	КонецЦикла;
	
	
КонецПроцедуры

// ПЕРЕСМОТРЕТЬ место кода
// Функция - Получает структуру документа 1С по пакету СБИС
//
// Параметры:
//  ОписаниеПроверки - 	 - 
//  ДопПараметры	 - 	 - 
// 
// Возвращаемое значение:
//  ФайлДокумент - структура прочитанного документа
//
// v8unpack &НаКлиенте
Функция ПолучитьСтруктуруДокумента1СПоПакетуСбис(ОписаниеПроверки, ДопПараметры) Экспорт

	Кэш							= ГлавноеОкно.Кэш;
	Вложение					= ОписаниеПроверки.Вложение;
	СоставПакета				= ОписаниеПроверки.СоставПакета;
	ДанныеДокумента				= Новый Структура();
	СоответствиеДокументДанные	= Новый Соответствие;

	Если ОписаниеПроверки.Свойство("Документ1С") Тогда
		
		ПодготовитьСоответствиеРасхожденияДокумент1С_Вложение(Вложение, ОписаниеПроверки.Документ1С, СоответствиеДокументДанные);
		
	Иначе
		// TODO Это условие не имеет смысла, т.к. код дальше работать не будет, если зайдет сюда
		
		// Если документа нет, то проверить на вложении
		Для Каждого Документ1С Из Вложение.Документы1С Цикл
			
			ПодготовитьСоответствиеРасхожденияДокумент1С_Вложение(Вложение, Документ1С.Значение, СоответствиеДокументДанные);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если Не СоответствиеДокументДанные.Количество() Тогда
		
		МодульОбъектаКлиент().ВызватьСбисИсключение("Не найден файл для формирования расхождения " + Вложение.Название, "МодульОбъектаКлиент.ПолучитьСтруктуруДокумента1СПоПакетуСбис");
		
	КонецЕсли;
	
	// TODO Устаревшая странная хрень. Используется, потому что в ПодготовитьСоответствиеРасхожденияДокумент1С_Вложение так же
	ДокументСтрокой = ГлобальныйКэш.ТекущийСеанс.Модули.ФункцииДокументов.ПолучитьИмяИСПоСсылке(ОписаниеПроверки.Документ1С);
	ИмяИни = СтрПолучитьСтроку(СтрЗаменить(ДокументСтрокой, ".", Символы.ПС), 2);
	
	НовыйСоставПакета = Новый СписокЗначений;
	НовыйСоставПакета.Добавить(ОписаниеПроверки.Документ1С, ИмяИни);
	
	Контекст = Новый Структура("МассивПакетов", Новый Массив);
	//Кэш.КэшЗначенийИни.ТекущийПакет.Вставить("СоответствиеДокументДанные", СоответствиеДокументДанные);
	
	Кэш.ОбщиеФункции.ПолучитьДанныеДокументов1С(СоответствиеДокументДанные, Кэш.КэшЗначенийИни, НовыйСоставПакета, Кэш.Парам);
	Если	Не Кэш.ОбщиеФункции.ОбработатьДанныеДокументов1С(Кэш, Контекст, НовыйСоставПакета, СоответствиеДокументДанные)
		Или	Не ЗначениеЗаполнено(Контекст.МассивПакетов) Тогда
		ВызватьСбисИсключение(745, "МодульОбъектаКлиент.ПолучитьСтруктуруДокумента1СПоПакетуСбис",,, "Документ " + НовыйСоставПакета[0].Значение + " не обработан");
	КонецЕсли;  
                 
	ДанныеРезультат = Контекст.МассивПакетов[0];
	Если	Не ДанныеРезультат.Количество()
		Или Не ЗначениеЗаполнено(ДанныеРезультат)
		Или	Не ДанныеРезультат.Свойство("Вложение")
		Или	Не ДанныеРезультат.Вложение.Количество() Тогда;                       
		ВызватьСбисИсключение(745, "МодульОбъектаКлиент.ПолучитьСтруктуруДокумента1СПоПакетуСбис",,, "Не удалось сформировать " + Вложение.Тип + " от " + НовыйСоставПакета[0].Значение);
	КонецЕсли;
	
	Возврат ДанныеРезультат.Вложение[0].СтруктураДокумента.Файл.Документ;
	
КонецФункции

// v8unpack #КонецОбласти

// v8unpack #Область include_core2_vo2_Модуль_МодульОбъектаКлиент_Классы_ВложениеСБИС_private

// Функция - Вложение СБИС выгрузить
//
// Параметры:
//  ВложениеСБИС - ВложениеСБИС	 - структура вложения из СоставаПакета 
//  КлючВыгрузки - Структура	 - 
//  ДопПараметры - Структура	 - 
// 
// Возвращаемое значение:
// Массив - Строки табличной части документа 1С на загрузку/выгрузку
//
// v8unpack &НаКлиенте
Функция ВложениеСБИС_Выгрузить_ТабличнаяЧасть(ВложениеСБИС, ДопПараметры)
		
	Если НЕ (ВложениеСБИС.Свойство("КлассыСопоставленияНоменклатур") 
			И ЗначениеЗаполнено(ВложениеСБИС.КлассыСопоставленияНоменклатур)) Тогда
		
		// Прокинуть исключение	
		Возврат Неопределено;
		
	КонецЕсли;

	ЛокальныйКэш		= ПолучитьТекущийЛокальныйКэш();
	СбисОбщиеФункции	= ПолучитьЗначениеПараметраТекущегоСеанса("ФункцииДокументов");
	СтруктураДокумента	= ВложениеСБИС_Получить(ВложениеСБИС, "СтруктураФайла");
	
	Если    ЗначениеЗаполнено(СтруктураДокумента)
		И	СтруктураДокумента.Файл.Документ.Свойство("СписокСтрТабл") Тогда
		
		ПутьТаблДок = "Файл.Документ.СписокСтрТабл.СтрТабл";
		
	Иначе
		
		ПутьТаблДок = "Файл.Документ.ТаблДок.СтрТабл";
		
	КонецЕсли;	
	
	Если ВложениеСБИС.Свойство("ТаблДок") Тогда
		
		ТабличнаяЧастьИзФайла = ВложениеСБИС.ТаблДок; // Рассчитывался при подготовке к загрузке
		
	Иначе

		ТабличнаяЧастьИзФайла = СбисОбщиеФункции.РассчитатьЗначениеИзСтруктуры(ПутьТаблДок, СтруктураДокумента);
		
	КонецЕсли;
	
	НаборСопоставленийНоменклатуры = Новый Структура("ТабличнаяЧасть, НаборСопоставлений", ТабличнаяЧастьИзФайла, ВложениеСБИС.КлассыСопоставленияНоменклатур);
	
	ПараметрыПоискаФорм = ВложениеСбис_Получить(ВложениеСБИС, "ПараметрыИни");
	НаборФорм = Новый Массив;
	
	ИмяФормыПоФормату = "Файл_"	+ СбисОбщиеФункции.СбисЗаменитьНедопустимыеСимволы(ПараметрыПоискаФорм.Тип)
	+ "_"	+ СбисОбщиеФункции.СбисЗаменитьНедопустимыеСимволы(ПараметрыПоискаФорм.Версия);
	
	НаборФорм.Добавить(ИмяФормыПоФормату);
	
	Если Не ПараметрыПоискаФорм.Версия = "3.01" Тогда
		НаборФорм.Добавить("Файл_Шаблон_" + СтрЗаменить(ПараметрыПоискаФорм.Версия, ".", "_"));
	КонецЕсли;
	
	НаборФорм.Добавить("Файл_Шаблон");
	
	МодульФормы = НайтиФункциюСеансаОбработки("СформироватьТабличнуюЧастьПоНаборуСопоставленийНоменклатуры", НаборФорм);
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;
	
	Если ПараметрыПоискаФорм.Направление = "Входящий" Тогда
		ДопПараметры.Вставить("СвернутьСтроки", Ложь);
	Иначе
		ДопПараметры.Вставить("СвернутьСтроки", Истина);
	КонецЕсли;
	
	Если НЕ ДопПараметры = Неопределено 
		И ДопПараметры.Свойство("НаправлениеСворачивания") Тогда
		НаправлениеСворачивания = ДопПараметры.НаправлениеСворачивания;
	Иначе
		НаправлениеСворачивания = "СБИС";
	КонецЕсли;
	
	ДопПараметры.Вставить("НаправлениеСворачивания", НаправлениеСворачивания);
	
	Если ВложениеСБИС.Параметры.Свойство("ФайлПерегенерируется") Тогда
		ДопПараметры.Вставить("ФайлПерегенерируется", ВложениеСБИС.Параметры.ФайлПерегенерируется);
	Иначе
		ДопПараметры.Вставить("ФайлПерегенерируется",Истина);
	КонецЕсли;
	
	ДопПараметры.Вставить("ВложениеСБИС", ВложениеСБИС); 
	
	ТабличнаяЧасть = МодульФормы.СформироватьТабличнуюЧастьПоНаборуСопоставленийНоменклатуры(НаборСопоставленийНоменклатуры, ДопПараметры);
	
	Возврат ТабличнаяЧасть;
	
КонецФункции

// v8unpack &НаКлиенте
Функция ВложениеСБИС_Выгрузить_ЗаписьНаБЛ(ВложениеСБИС, ДопПараметры)
	Перем ИдВложения, ПараметрыПодготовкиВложений, СбисШифрование;
	
	
	СоставПакета = ДопПараметры.СоставПакета;
	
	Если Не ДопПараметры.Свойство("ПараметрыПодготовки", ПараметрыПодготовкиВложений) Тогда
		
		ПараметрыПодготовкиВложений	= Новый Структура;
		
	КонецЕсли;
	
	Если Не ДопПараметры.Свойство("ИдентификаторВложения", ИдВложения) Тогда
		
		// Ид вложения указан явно. Может быть выбрано для перезаписи существующего вложения с определенным ИД
		Если НЕ (	ВложениеСБИС.Свойство("Идентификатор", ИдВложения)
				И	ЗначениеЗаполнено(ИдВложения)) Тогда
				
			ИдВложения = Строка(Новый УникальныйИдентификатор());
			
		КонецЕсли;
		
	КонецЕсли;
	
	МодульИнтеграции = ПолучитьЗначениеПараметраТекущегоСеанса("Интеграция");
	ВложениеСБИС.Вставить("Идентификатор", ИдВложения);

	file		= Новый Структура;
	attachment	= Новый Структура("Идентификатор, Файл", ИдВложения, file);
	
	СбисПараметрыВложения = Новый Структура("Файл, Вложение, ВложениеВПакет", file, ВложениеСБИС, attachment);

	Если		ВложениеСБИС.Свойство("ПолноеИмяФайла") Тогда // внешний файл добавлен в пакет

		file.Вставить("Имя", ВложениеСБИС.ИмяФайла);
		МодульИнтеграции.Отправка_ОбработатьВнешнийФайл(ГлавноеОкно.Кэш, СбисПараметрыВложения, ПараметрыПодготовкиВложений);

	ИначеЕсли	ТипЗнч(ВложениеСБИС.XMLДокумента) = Тип("Соответствие") Тогда
		
		file.Вставить("Подстановка", ВложениеСБИС.XMLДокумента);
		
	Иначе  // сформирован xml
		
		ИмяФайла = ВложениеСБИС.СтруктураФайла.Файл.Имя + ".xml";
		file.Вставить("Имя", ИмяФайла);
		МодульИнтеграции.Отправка_ОбработатьXMLФайл(ГлавноеОкно.Кэш, СбисПараметрыВложения, ПараметрыПодготовкиВложений);
		
	КонецЕсли;

	Если ВложениеСБИС.Свойство("Подпись") Тогда
		
		ЭЦП = Новый Массив;
		Для Каждого Запись из ВложениеСБИС.Подпись Цикл
			
			ЗаписьЭЦП = Новый Структура;
			Если Запись.Свойство("Направление") Тогда
				ЗаписьЭЦП.Вставить("Направление",Запись.Направление);
			КонецЕсли;
			ФайлЭЦП = Новый Структура;
			ФайлЭЦП.Вставить( "Имя", Запись.Файл.Имя ); 
			ФайлЭЦП.Вставить( "ДвоичныеДанные", ПолучитьBASE64ПоИмениФайлаКлиент(Запись.Файл.ПолноеИмяФайла)); 
			ЗаписьЭЦП.Вставить("Файл",ФайлЭЦП);
			ЭЦП.Добавить(ЗаписьЭЦП);
			
		КонецЦикла;
		attachment.Вставить("Подпись", ЭЦП);
		
	КонецЕсли;
	
	Если		ВложениеСБИС_Получить(ВложениеСБИС, "Зашифрован") Тогда
		
		// Вложение уже зашифровано. Просто прокинуть признак, никаких дополнительных действие не делается.
		attachment.Вставить("Зашифрован", "Да");

	ИначеЕсли	ВложениеСБИС_Получить(ВложениеСБИС, "Зашировать") Тогда
		
		// Вложение нужно зашифровать.
		attachment.Вставить("Шифрование", "Да");
		
		Если	ВложениеСБИС.Свойство("Тип")
			И	ВложениеСБИС.Свойство("ПодТип")
			И	ВложениеСБИС.Свойство("ВерсияФормата")
			И	ЗначениеЗаполнено(ВложениеСБИС.Тип)
			И	ЗначениеЗаполнено(ВложениеСБИС.ВерсияФормата) Тогда
			attachment.Вставить( "Тип",  ВложениеСБИС.Тип);
			attachment.Вставить( "Подтип",  ВложениеСБИС.ПодТип);
			attachment.Вставить( "ВерсияФормата",  ВложениеСБИС.ВерсияФормата);
			Если	ВложениеСБИС.Свойство("ПодВерсияФормата")
				И	ЗначениеЗаполнено(ВложениеСБИС.ПодВерсияФормата) Тогда
				attachment.Вставить( "ПодверсияФормата",  ВложениеСБИС.ПодВерсияФормата);
			КонецЕсли;
		КонецЕсли;
		
		Если	ВложениеСБИС.Свойство("Название")
			И	ЗначениеЗаполнено(ВложениеСБИС.Название) Тогда
			// для зашифрованных документов убираем сумму из названия
			ПозСуммы = Найти(ВложениеСБИС.Название, "на сумму");
			Если ПозСуммы Тогда
				ВложениеСБИС.Название = Лев(ВложениеСБИС.Название, ПозСуммы-1);
			КонецЕсли;
			attachment.Вставить("Название",  ВложениеСБИС.Название);
		КонецЕсли;
		
	Иначе
		
		attachment.Вставить("Шифрование", "Нет");
		
	КонецЕсли;
	
	Возврат attachment;
	
КонецФункции

// Функция - формирует Струкутру данных объекта по инишке
//
// Параметры:
//  ВложениеСБИС - ВложениеСБИС	 - экземпляр вложения сбис
//  ДопПараметры - Структура	 - Расширение. СоставПакета - Экземпляр СоставПакета
// 
// Возвращаемое значение:
//  Структура - Договор, Дата, Контрагент
//
// v8unpack &НаКлиенте
Функция ВложениеСБИС_РассчитанныйОбъект(ВложениеСБИС, ДопПараметры)
	Перем ЗначениеВставить, РежимОпределенияОбъекта, СтруктураДокОбъект;
	
	Если ДопПараметры = Неопределено Тогда
		ДопПараметры = Новый Структура;
	КонецЕсли;

	Если ВложениеСБИС.Параметры.Свойство("РассчитанныйОбъект", СтруктураДокОбъект) Тогда
		
		// Если есть рассчитанный объект, то он всегда более полный, чем базовые поля (они включаются туда)
		Возврат СтруктураДокОбъект;
		
	ИначеЕсли  	ДопПараметры.Свойство("Режим", РежимОпределенияОбъекта)		
			И	(	РежимОпределенияОбъекта = "Основание"
				Или	РежимОпределенияОбъекта = "Документ"  
				Или	РежимОпределенияОбъекта = "Фильтр") Тогда
			
		Если ВложениеСБИС.Параметры.Свойство("БазовыеПоляОбъекта", СтруктураДокОбъект) Тогда 
			
			Возврат СтруктураДокОбъект;
			
		КонецЕсли;
		
		// Попали в режим поиска основания, или документа, но при этом расчитанного объекта еще нет
		ЭтоПолныйРасчет = Ложь;
		
	Иначе
		
		ЭтоПолныйРасчет = Истина;

	КонецЕсли;
	
	СтатусВложения		= ВложениеСБИС_Получить(ВложениеСБИС, "Статус");
	СтруктураИниФайла	= ВложениеСБИС_Получить(ВложениеСБИС, "УстановленныйПодразделИни");
	Если	СтатусВложения = "Ошибка"
		Или	СтруктураИниФайла = Неопределено Тогда
		
		Возврат Новый Структура;
		
	КонецЕсли;
	

	Если Не ЭтоПолныйРасчет Тогда
		
		// Получим поля для поиска по шаблону узлов "Документ_", чтобы не считать лишнего
		ОписаниеОбъекта			= Новый Структура("Ключ, Значение, Ини", "Документ", ВложениеСБИС.СтруктураФайла, СтруктураИниФайла);
		ДопПараметрыЗаполнить	= Новый Структура("Вложение, СоставПакета", ВложениеСБИС, ДопПараметры.СоставПакета);
		СтруктураДокОбъект		= ЗаполнитьСтруктуруОбъектаПоИни(ОписаниеОбъекта, ДопПараметрыЗаполнить);
		
	ИначеЕсли		ВложениеСБИС.Параметры.РедактироватьДокумент
			И	Не	РежимОпределенияОбъекта = "Разбор" Тогда
		
		ДокументДляРедактирования = ВложениеСБИС_Получить(ВложениеСБИС, "ПодходящийДокумент", ДопПараметры);
		
		Если ДокументДляРедактирования = Неопределено Тогда
			
			Возврат Новый Структура;
			
		КонецЕсли;
		
		СтруктураДокОбъект = ПолучитьДанныеОбъекта1С(ДокументДляРедактирования);
		
	Иначе
		
		СтруктураДокОбъект			= Новый Структура; // Структура с названиями полей, как у создаваемого документа 1С
		ПараметрыДляРасчетаОбъекта	= Новый Структура("Режим", "Подготовка");
		СбисОбщиеФункции			= ПолучитьЗначениеПараметраСбис("ФункцииДокументов");
		СтруктураДанныхДокумента	= СбисОбщиеФункции.СкопироватьОбъектСПараметрамиКлиент(СтруктураИниФайла);
		
		ПараметрыПолучить	= Новый ФиксированнаяСтруктура("СоставПакета, ТипКратко", ДопПараметры.СоставПакета, Истина);
		ТипДокумента		= ВложениеСБИС_Получить(ВложениеСБИС, "ТипОбъекта", ПараметрыПолучить);
		
		ВложениеСБИС.Удалить("ВходящийКонтекст");
		ВложениеСБИС_ЗаполнитьПараметрыПередРасчетом(ВложениеСБИС, ДопПараметры);
	
		НаборФорм = Новый Массив;
		НаборФорм.Добавить("Документ_" + ТипДокумента);
		НаборФорм.Добавить("Документ_Шаблон");
		
		фрм = НайтиФункциюСеансаОбработки("ЗаполнитьДаннымиСтруктурыФайлаСтруктуруДокумента", НаборФорм);
		фрм.ЗаполнитьДаннымиСтруктурыФайлаСтруктуруДокумента(	ПолучитьТекущийЛокальныйКэш()
															,	ВложениеСБИС.СтруктураФайла
															,	СтруктураДанныхДокумента
															,	СтруктураДокОбъект
															,	Новый Массив
															,	ДопПараметры.СоставПакета
															,	ВложениеСБИС
															,	ПараметрыДляРасчетаОбъекта);
		
	КонецЕсли;
	
	Если ЭтоПолныйРасчет Тогда
		
		ВложениеСБИС.Параметры.Вставить("РассчитанныйОбъект", СтруктураДокОбъект);
		
	Иначе
		
		ВложениеСБИС.Параметры.Вставить("БазовыеПоляОбъекта", СтруктураДокОбъект);
		
	КонецЕсли;
	
	Возврат СтруктураДокОбъект;

КонецФункции

// Процедура - Заполняет ВложениеСБИС для открытия на форме просмотра
//
// Параметры:
//  ВложениеСБИС - 	 - 
//  ДопПараметры - 	 - 
//
// v8unpack &НаКлиенте
Процедура ВложениеСБИС_РазобратьДляПросмотра(ВложениеСБИС, ДопПараметры) Экспорт
	
	ПараметрыДляПросмотра = Новый Структура;
	
	ВложениеСБИС.Вставить("Просмотр", ПараметрыДляПросмотра);
	
	Поля1С = ВложениеСБИС_Получить(ВложениеСБИС, "Поля1С", ДопПараметры);
	
	ПараметрыКарточки = Новый Структура("ПоказатьСозданиеКарточки",			Поля1С.Контрагент.Доступность
																	И Не	ЗначениеЗаполнено(Поля1С.Контрагент.Значение));
	
	ПараметрыДляПросмотра.Вставить("ПараметрыКонтрагент", ПараметрыКарточки);
	
КонецПроцедуры

// Процедура - заполняет текущий экземпляр класса от входных данных
//
// Параметры:
//  ВложениеСБИС	 - Структура	- (О) экземпляр класса
//  ДанныеЗаполнить	 - Структура	- (О) входные данные заполнить
//  КлючЗаполнить	 - Строка	 	- (Н) ключ входных данных, если это не класс (невозможно определить что за класс)
//
// v8unpack &НаКлиенте
Функция ВложениеСБИС_ДанныеФайла(ВложениеСБИС) 
	
	ИнтеграцияМодуль	= ПолучитьЗначениеПараметраСбис("Интеграция");
	ФайлЗначение		= ВложениеСБИС_Получить(ВложениеСБИС, "Файл");
	
	Попытка
		
		Если ВложениеСБИС_Получить(ВложениеСБИС, "Зашифрован") Тогда
			
			ИмяФайла = ВложениеСБИС_ДанныеФайла_Зашифрован(ВложениеСБИС);
			XMLФайла = ПрочитатьФайлКлиент(ИмяФайла, Новый ФиксированнаяСтруктура("Расширение", "xml"));
			
		ИначеЕсли ФайлЗначение.Свойство("СсылкаНаФайл", ИмяФайла) Тогда
			
			XMLФайла = ПрочитатьФайлКлиент(ИмяФайла, Новый ФиксированнаяСтруктура("Расширение", "xml"));
			XMLФайла = ИнтеграцияМодуль.ПолучитьДанныеФайла_ОбработкаПослеЧтения(ФайлЗначение, XMLФайла);
			
		Иначе
			
			ИмяФайла = СкачатьВФайлПоПараметрам(ФайлЗначение.Ссылка);
			XMLФайла = ПрочитатьФайлКлиент(ИмяФайла, Новый ФиксированнаяСтруктура("Расширение", "xml"));
			
		КонецЕсли;
		
	Исключение
		
		ДампОшибки = Новый Структура("ФайлЗначение", ФайлЗначение);
		ОшибкаЗаписиДанных = НовыйСбисИсключение(ИнформацияОбОшибке(), "МодульОбъектаКлиент.ВложениеСБИС_ДанныеФайла",,,, ДампОшибки);
		ВызватьИсключение СбисИсключение_Представление(ОшибкаЗаписиДанных);
		
	КонецПопытки;
	
	Возврат XMLФайла;

КонецФункции

// v8unpack &НаКлиенте
Функция ВложениеСБИС_ДанныеФайла_Зашифрован(ВложениеСБИС)
	Перем ДвоичныеДанныеBase64, СтрокаРезультат;
	
	ИнтеграцияМодуль	= ПолучитьЗначениеПараметраСбис("Интеграция");
	ФайлЗначение		= ВложениеСБИС_Получить(ВложениеСБИС, "Файл");
	
	Попытка
		
		Если Не ФайлЗначение.Свойство("ДвоичныеДанные", ДвоичныеДанныеBase64) Тогда
			
			ИмяФайла = СкачатьВФайлПоПараметрам(ФайлЗначение.Ссылка);
			
			ДД_Файла		= Новый ДвоичныеДанные(ИмяФайла);
			СтрокаBase64	= СтрЗаменить(СтрЗаменить(Base64Строка(ДД_Файла), Символы.ПС, ""), Символы.ВК, "");

			Отказ					= Ложь;
			ПараметрыЗапроса		= Новый Структура("encrypted_data", СтрокаBase64);
			ДопПараметрыЗапроса		= Новый Структура("СообщатьПриОшибке, ВернутьОшибку, ЕстьРезультат", Ложь, Истина, Истина);
			ДвоичныеДанныеBase64	= ИнтеграцияМодуль.СБИС_РасшифроватьФайл(ПолучитьТекущийЛокальныйКэш(), ПараметрыЗапроса, ДопПараметрыЗапроса, Отказ);
			
			Если Отказ Тогда
				
				ИнтеграцияИмя		= ПолучитьЗначениеПараметраСБИС("ИнтеграцияИмя");
				ОшибкаРасшифровки	= НовыйСбисИсключение(773, ИнтеграцияИмя + ".СБИС_РасшифроватьФайл");
				ВызватьИсключение СбисИсключение_Представление(ОшибкаРасшифровки);
				
			КонецЕсли;

			ФайлЗначение.Вставить("ДвоичныеДанные", ДвоичныеДанныеBase64);
			
		КонецЕсли;
		
		ИмяВремФайла		= НовыйВременныйФайлКлиент(, "xml");
		ДвоичныеДанныеФайла	= Base64Значение(ДвоичныеДанныеBase64);
		ДвоичныеДанныеФайла.Записать(ИмяВремФайла);
		
	Исключение
		
		ОшибкаРасшифровки	= НовыйСбисИсключение(ИнформацияОбОшибке(), "МодульОбъектаКлиент.ВложениеСБИС_ДанныеФайла_Зашифрован");
		ВызватьИсключение СбисИсключение_Представление(ОшибкаРасшифровки);
		
	КонецПопытки;
		
	Возврат ИмяВремФайла;
	
КонецФункции

// v8unpack &НаКлиенте
Процедура ВложениеСБИС_Заполнить_ПоВложениеСБИС(ВложениеСБИС, ДанныеЗаполнить) 
	Перем Документы1СВложения, ПараметрЗашифрован;
	
	ЗаполнитьЗначенияСвойств(ВложениеСБИС, ДанныеЗаполнить);
	
	Если		ВложениеСБИС.Документы1С.Количество() Тогда
		
		//Создать копию списка оснований, чтобы разорвать связь со старым классом
		Документы1СВложенияКопия = Новый СписокЗначений;
		Документы1СВложенияКопия.ЗагрузитьЗначения(ВложениеСБИС.Документы1С.ВыгрузитьЗначения());
		ВложениеСБИС.Документы1С = Документы1СВложенияКопия;
		
	ИначеЕсли	ДанныеЗаполнить.Свойство("Документ1С") Тогда
		
		ВложениеСБИС_Заполнить(ВложениеСБИС, ДанныеЗаполнить.Документ1С, "Документ1С")
		
	КонецЕсли;
		
	//Необязательные поля
	Если	ДанныеЗаполнить.Свойство("ТребуетПодписания") Тогда
		
		ВложениеСБИС.Вставить("ТребуетПодписания", ДанныеЗаполнить.ТребуетПодписания);
		
	КонецЕсли; 
	
	//Необязательные поля
	Если	ДанныеЗаполнить.Свойство("ТребуетсяПриложить") Тогда
		
		ВложениеСБИС.Вставить("ТребуетсяПриложить", ДанныеЗаполнить.ТребуетсяПриложить);
		
	КонецЕсли; 
	
	Если	ДанныеЗаполнить.Свойство("Параметры") Тогда
		
		ВложениеСБИС.Параметры.ИспользоватьГенератор = ДанныеЗаполнить.Параметры.ИспользоватьГенератор = Истина;
		
	КонецЕсли;

	
	Если	ДанныеЗаполнить.Свойство("НоменклатураКодКонтрагента") Тогда
		
		ВложениеСБИС.Вставить("НоменклатураКодКонтрагента", ДанныеЗаполнить.НоменклатураКодКонтрагента);
		
	КонецЕсли;
	
	Если	ДанныеЗаполнить.Свойство("ДопПоля") Тогда
		
		ВложениеСБИС.Вставить("ДопПоля", ДанныеЗаполнить.ДопПоля);
		
	КонецЕсли;
	
	Если	ДанныеЗаполнить.Свойство("Провести") Тогда
		
		ВложениеСБИС.Вставить("Провести", ДанныеЗаполнить.Провести);
		
	КонецЕсли;
	
	Если	ДанныеЗаполнить.Свойство("Зашифрован", ПараметрЗашифрован) Тогда
		
		БулевоПривести = Новый ОписаниеТипов("Булево");
		ПараметрЗашифрован = БулевоПривести.ПривестиЗначение(ПараметрЗашифрован);
		
	Иначе
		
		ПараметрЗашифрован = Ложь;
		
