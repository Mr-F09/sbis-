// Процедура - создает экземпляр локального и глобального кэша обработки и связывает модуль объекта и главное окно
//
// Параметры:
//  МодульГлавноеОкно	 - Форма, УправляемаяФорма	 - Форма, куда необходимо прописать локальный кэш и с которой устанавливается привязка текущего модуля  объекта
//
// v8unpack &НаКлиенте
Процедура НастроитьКэшОбработки(МодульГлавноеОкно) Экспорт 
	
	НовыйГлобальныйКэш = НовыйГлобальныйКэш();
	
	ОбновитьПараметрГлобальногоМодуля("ГлавноеОкно",	МодульГлавноеОкно);
	ОбновитьПараметрГлобальногоМодуля("ГлобальныйКэш",	НовыйГлобальныйКэш);
	
	ПараметрыУстановитьКэш	= Новый Структура;
	ПараметрыУстановитьКэш.Вставить("ГлавноеОкно",	 МодульГлавноеОкно);
	ПараметрыУстановитьКэш.Вставить("ГлобальныйКэш", НовыйГлобальныйКэш);
	
	Кэш = НовыйЛокальныйКэш(НовыйГлобальныйКэш);
	
	МодульГлавноеОкно.Кэш = Кэш;
	
	Попытка
		
		СбисОбщиеФункции = ПолучитьФормуОбработки("РаботаСДокументами1С"); 
		СбисОбщиеФункции.МестныйКэш = Кэш;
		
	Исключение
		
		ОшибкаЗапуска = НовыйСбисИсключение(ИнформацияОбОшибке(), "ФормаГлавноеОкно.КэшПодготовить", 776, "Запуск программы/функции/метода не удался", "Не удалось определить модуль вызываемых функций. Обратитесь в техническую поддержку.");
		ВызватьИсключение СбисИсключение_Представление(ОшибкаЗапуска);
		
	КонецПопытки;

	Попытка
		
		ФайлыНастроекСервер = ПолучитьФормуОбработки("ФайлыНастроекСервер"); 
		
	Исключение
		
		ОшибкаЗапуска = НовыйСбисИсключение(ИнформацияОбОшибке(), "ФормаГлавноеОкно.КэшПодготовить", 776, "Запуск программы/функции/метода не удался", "Не удалось определить модуль вызываемых функций. Обратитесь в техническую поддержку.");
		ВызватьИсключение СбисИсключение_Представление(ОшибкаЗапуска);
		
	КонецПопытки;
	
	ОбновитьПараметрГлобальногоМодуля("РаботаСJSON",					МодульОбъектаКлиент());
	ОбновитьПараметрГлобальногоМодуля("НастройкиСБИС",					ФайлыНастроекСервер);
	
	ИзменитьПараметрТекущегоСеанса("ФункцииДокументов",				СбисОбщиеФункции);
	ИзменитьПараметрТекущегоСеанса("МодульУправленияНастройками",	ПолучитьФормуОбработки("ФайлыНастроекОбщее"));
	
	ЛокальныйКэш_ПривестиСовместимость(Кэш);
		
КонецПроцедуры	

