// Функция block_accordion_item_calc_value
//
// Параметры:
// context - Соответствие - Контекст исполняемого блока
// block_context - Соответствие - Контекст текущего выполняемого блока
// local_context - Соответствие - Локальный контекст исполняемого блока
//
// Возвращаемое значение:
//  Структура - Результат выполения функции
//
// Сохраняем идентичность со структурой кода в Питоне
// BSLLS:CognitiveComplexity-off
Функция accounting_entries_list2_items(context, block_context, local_context)
	
	Результат = Новый Массив;
	УжеОбработаны = ПроверкаКоличестваОбработанных2(block_context, local_context);
	// признак отладки
	
	ВыборкаХозрасчетныхДвиженийССубконто2(block_context, local_context);
	
	сч = 0;
	счНаСтранице = 0;
	Если Не block_context.Свойство("selection_index") Тогда
		block_context.Вставить("selection_index", 0);
	КонецЕсли;
	
	Если block_context.Свойство("selection_max_index") И block_context["selection_index"] = block_context["selection_max_index"] Тогда
		Возврат Результат;	
	КонецЕсли;
	
	ВыгружатьПроводки = get_prop(block_context, "UNLOADING_TRANSACTIONS", Неопределено);
	НеизвестныеКакБухСправки = get_prop(block_context, "UNKNOWN_AS_ACCOUNTING_CERTIFICATES", Неопределено);
	
	Пока local_context["Выборка"].СледующийПоЗначениюПоля("Регистратор") Цикл
		сч = сч + 1;
		Если сч <= УжеОбработаны Тогда
			Продолжить;
		КонецЕсли;
		Проводки = Новый Массив;
		ПроводкиСырые = Новый Массив;
		Если ВыгружатьПроводки = "TRUE" Тогда
			// Преобразуем данные инишек показателей 1 раз
			Если block_context.page = 0 ИЛИ НЕ local_context.Свойство("Выборка") Тогда
				indicator_list_src  = index_indicators_by_account_code(block_context.indicator_list_src);
				indicator_list_dest = index_indicators_by_name(block_context.indicator_list_dest);
				local_context.Вставить("indicator_list_src",  indicator_list_src);
				local_context.Вставить("indicator_list_dest", indicator_list_dest);
			Иначе
				indicator_list_src  = local_context["indicator_list_src"];
				indicator_list_dest = local_context["indicator_list_dest"];
			КонецЕсли;
			
			Пока local_context["Выборка"].Следующий() Цикл
				// НЕ ГРУЗИМ ПРОВОДКИ ПО ЗАБАЛАНСОВЫМ СЧЕТАМ!!!
				Если НЕ ЗначениеЗаполнено(local_context["Выборка"].СчетДт) ИЛИ НЕ ЗначениеЗаполнено(local_context["Выборка"].СчетКт) Тогда
