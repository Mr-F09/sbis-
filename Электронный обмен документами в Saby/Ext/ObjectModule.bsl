Функция saby_read_changes_get_items(context, block_context)
// BSLLS:DeprecatedCurrentDate-off
	// ТекущаяДатаСеанса нельзя тк метод не поддерживается на клиенте
	ТекущаяДатаЧислом = (ТекущаяДата() - Дата(1, 1, 1));
