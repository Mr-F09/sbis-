

Функция ПустоеЗначениеТипа(ЗаданныйТип)
	
	Если ЗаданныйТип = Тип("Число") Тогда
		Возврат 0;
	ИначеЕсли ЗаданныйТип = Тип("Строка") Тогда
		Возврат "";
	ИначеЕсли ЗаданныйТип = Тип("Дата") Тогда
		Возврат '00010101000000';
	ИначеЕсли ЗаданныйТип = Тип("Булево") Тогда
		Возврат Ложь;
	Иначе
		Возврат Новый (ЗаданныйТип);
	КонецЕсли;
	
КонецФункции // ПустоеЗначениеТипа();

Функция ВидСравненияСтр(ТипВидСравнения)
//	
Если ТипВидСравнения =  ВидСравнения.Равно Тогда
			ВидСравненияСтрокой  =  " = " 
ИначеЕсли ТипВидСравнения  =  ВидСравнения.НеРавно Тогда
			ВидСравненияСтрокой  =  "<>"
ИначеЕсли ТипВидСравнения  =  ВидСравнения.ВСписке Тогда
			ВидСравненияСтрокой  =  "В"
ИначеЕсли ТипВидСравнения  =  ВидСравнения.НеВСписке Тогда
			ВидСравненияСтрокой  =  "НЕ В"
ИначеЕсли ТипВидСравнения  =  ВидСравнения.ВСпискеПоИерархии ИЛИ 
			ТипВидСравнения   =  ВидСравнения.ВИерархии Тогда
			ВидСравненияСтрокой  =  "В ИЕРАРХИИ"
ИначеЕсли ТипВидСравнения  =  ВидСравнения.НеВСпискеПоИерархии ИЛИ 
			ТипВидСравнения   =  ВидСравнения.НеВИерархии Тогда
			ВидСравненияСтрокой  =  "НЕ В ИЕРАРХИИ"
КонецЕсли; 
//
Возврат ВидСравненияСтрокой;
//
КонецФункции	

Функция ПолучитьПоследниеДокументыПоступлений(СпТов)
	
зп = новый запрос;
зп.УстановитьПараметр("Номенклатура", СпТов);

зп.Текст = "ВЫБРАТЬ
           |	ПервыеДокументы.Номенклатура КАК Номенклатура,
           |	ПервыеДокументы.Ссылка КАК Док,
           |	СУММА(ПервыеДокументы.Количество) КАК Количество
           |ИЗ
           |	Документ.ПоступлениеТоваровУслуг.Товары КАК ПервыеДокументы
           |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
           |			Доки.Номенклатура КАК Номенклатура,
           |			МАКСИМУМ(Доки.Ссылка.Дата) КАК ДатаПервогоДокумента
           |		ИЗ
           |			Документ.ПоступлениеТоваровУслуг.Товары КАК Доки
           |		ГДЕ
           |			Доки.Номенклатура В(&Номенклатура)
           |		
           |		СГРУППИРОВАТЬ ПО
           |			Доки.Номенклатура) КАК ДатыПервыхДокументов
           |		ПО ПервыеДокументы.Номенклатура = ДатыПервыхДокументов.Номенклатура
           |			И ПервыеДокументы.Ссылка.Дата = ДатыПервыхДокументов.ДатаПервогоДокумента
           |ГДЕ
           |	ПервыеДокументы.Номенклатура В(&Номенклатура)
           |
           |СГРУППИРОВАТЬ ПО
           |	ПервыеДокументы.Номенклатура,
           |	ПервыеДокументы.Ссылка
           |АВТОУПОРЯДОЧИВАНИЕ"; 

рез = зп.Выполнить();

Возврат рез.Выгрузить();

КонецФункции	
	
